  ];

  siteRegistry() {
    if (this._siteReg) return this._siteReg;
    const secName = {}; this.sectorDefs.forEach(s => { secName[s.code] = s.name; });
    this._siteReg = this.siteDefs.map(row => {
      const [sectorCode, code, name, refs] = row.split('|');
      return { code, name, sectorCode, sectorName: secName[sectorCode] || '—',
        refs: (refs || '').split(',').filter(Boolean) };
    });
    return this._siteReg;
  }

  projectSectorMap() {
    if (this._projSec) return this._projSec;
    const m = {};
    this.siteRegistry().forEach(s => s.refs.forEach(r => { m[r] = { sectorCode: s.sectorCode, sectorName: s.sectorName, siteName: s.name, siteCode: s.code }; }));
    this._projSec = m;
    return m;
  }
  sectorOfProject(code) { return this.projectSectorMap()[code] || { sectorCode: '', sectorName: 'غير مصنّف', siteName: '—', siteCode: '—' }; }

  setWorkerStatus(code, status) {
    const w = (this._codeToWorker || {})[code] || this.workers.find(x => x.code === code);
    if (!w) return;
    w.status = status;
    if (status === 'غير نشط' && !w.leaveDate) w.leaveDate = new Date().toLocaleDateString('en-GB');
    if (status === 'نشط') w.leaveDate = '';
    this.setState({ workerRev: this.state.workerRev + 1 });
  }
  setWorkerField(code, key, value) {
    const w = (this._codeToWorker || {})[code] || this.workers.find(x => x.code === code);
    if (!w) return;
    w[key] = value;
    this.setState({ workerRev: this.state.workerRev + 1 });
  }
  setWorkerRate(code, rate) { this.setWorkerField(code, 'rate', rate); }
  stamp() { const d = new Date(); return d.toLocaleDateString('en-GB') + ' — ' + d.toTimeString().slice(0, 5); }
  setWorkerDraft(code, key, value) {
    this.setState(st => ({ wDraft: { ...st.wDraft, [code]: { ...(st.wDraft[code] || {}), [key]: value } } }));
  }
  applyWorkerDraft(code) {
    const d = (this.state.wDraft || {})[code];
    if (!d) return false;
    const w = (this._codeToWorker || {})[code] || this.workers.find(x => x.code === code);
    if (w) {
      Object.keys(d).forEach(k => { w[k] = d[k]; });
      if (w.status === 'غير نشط' && !w.leaveDate) w.leaveDate = new Date().toLocaleDateString('en-GB');
      if (w.status === 'نشط') w.leaveDate = '';
    }
    return true;
  }
  saveWorkerDraft(code) {
    if (!this.applyWorkerDraft(code)) return;
    const rest = { ...this.state.wDraft }; delete rest[code];
    this.setState({ wDraft: rest, workerRev: this.state.workerRev + 1, lastSaved: this.stamp() });
  }
  saveAllWorkerDrafts() {
    const codes = Object.keys(this.state.wDraft || {});
    if (!codes.length) return;
    codes.forEach(c => this.applyWorkerDraft(c));
    this.setState({ wDraft: {}, workerRev: this.state.workerRev + 1, lastSaved: this.stamp() });
  }
  revertWorkerDraft(code) { const rest = { ...this.state.wDraft }; delete rest[code]; this.setState({ wDraft: rest }); }
  revertAllWorkerDrafts() { this.setState({ wDraft: {} }); }
  saveCatRates() {
    this.setState({ catRatesSaved: this.stamp() });
  }
  hourOptions = ['6', '7', '8', '9', '10', '11', '12'];
  perHour(value, hours) {
    const v = parseFloat(value) || 0, h = parseFloat(hours) || 0;
    return h ? (v / h).toFixed(2) : '—';
  }
  categoryRate(cat) { return String(this.catHour(cat) || ''); }

  anScope() {
    const s = this.state;
    const dept = s.anDept && s.anDept !== 'all' ? s.anDept : null;
    const dk = dept ? '|d:' + dept : '';
    const dl = dept ? dept + ' › ' : '';
    if (s.anSite && s.anSite !== 'all') {
      const site = this.siteRegistry().find(x => x.code === s.anSite);
      if (site) return { key: 'site|' + site.code + dk, projects: new Set(site.refs), dept,
        label: dl + site.sectorName + ' › ' + site.name + ' (' + site.code + ')' };
    }
    if (s.anSector && s.anSector !== 'all') {
      const sec = this.sectorDefs.find(x => x.code === s.anSector);
      const set = new Set();
      this.siteRegistry().forEach(x => { if (x.sectorCode === s.anSector) x.refs.forEach(r => set.add(r)); });
      if (sec) return { key: 'sec|' + sec.code + dk, projects: set, dept, label: dl + sec.name + ' (' + sec.code + ')' };
    }
    return { key: 'all' + dk, projects: null, dept, label: dept ? dept + ' — كل القطاعات' : 'كل الإدارات والقطاعات — على مستوى الشركة' };
  }

  projectRowsFor(dept) {
    if (!dept || dept === 'all') return this.dashboardAnalytics().projectRows;
    const key = 'pr|' + dept + '|' + this.state.workerRev;
    if (this._prKey === key) return this._pr;
    const logs = this.attendanceLogData;
    const dates = this.attendanceDates || [];
    const today = dates[dates.length - 1];
    const presentToday = new Set(logs.filter(l => l.date === today && l.type === 'In').map(l => l.code));
    const enrolled = new Set(logs.map(l => l.code));
    const map = {};
    this.workers.forEach(w => {
      if (w.dept !== dept) return;
      const pc = this.projectOfWorker(w);
      const p = map[pc] || (map[pc] = { code: pc, name: (this.projectsData.find(x => x.code === pc) || {}).name || ('مشروع ' + pc), registered: 0, present: 0, contractors: 0, enrolled: 0 });
      p.registered++;
      if (enrolled.has(w.code)) p.enrolled++;
      if (presentToday.has(w.code)) p.present++;
    });
    const rows = Object.values(map).map(p => {
      const pct = p.enrolled ? Math.round((p.present / p.enrolled) * 100) : 0;
      return { ...p, pct, pctLabel: p.enrolled ? pct + '%' : 'لا بصمة',
        barColor: pct >= 80 ? 'var(--color-accent)' : pct >= 50 ? 'var(--color-accent-700)' : 'var(--color-accent-2-700)' };
    }).sort((a, b) => (b.enrolled - a.enrolled) || (b.registered - a.registered));
    this._prKey = key; this._pr = rows;
    return rows;
  }

  deptStats() {
    const key = 'dps|' + this.state.workerRev + '|' + this.workers.length;
    if (this._dpKey === key) return this._dp;
    const logs = this.attendanceLogData;
    const dates = this.attendanceDates || [];
    const today = dates[dates.length - 1];
    const presentToday = new Set(logs.filter(l => l.date === today && l.type === 'In').map(l => l.code));
    const enrolledSet = new Set(logs.map(l => l.code));
    const map = {};
    this.workers.forEach(w => {
      const k = w.dept || 'غير محدد';
      const r = map[k] || (map[k] = { name: k, workers: 0, enrolled: 0, present: 0 });
      r.workers++;
      if (enrolledSet.has(w.code)) r.enrolled++;
      if (presentToday.has(w.code)) r.present++;
    });
    const rows = Object.values(map).map(r => {
      const pct = r.enrolled ? Math.round((r.present / r.enrolled) * 100) : 0;
      return { ...r, pct, absent: Math.max(0, r.enrolled - r.present),
        workersLabel: r.workers.toLocaleString('en-US'),
        pctLabel: r.enrolled ? pct + '%' : 'لا بصمة',
        barColor: pct >= 80 ? 'var(--color-accent)' : pct >= 50 ? 'var(--color-accent-700)' : 'var(--color-accent-2-700)' };
    }).sort((a, b) => b.workers - a.workers);
    this._dpKey = key; this._dp = rows;
    return rows;
  }

  sectorStats(dept) {
    const dp = dept && dept !== 'all' ? dept : '';
    const key = 'sec|' + this.state.workerRev + '|' + this.state.contractors.length + '|' + dp;
    if (this._secKey === key) return this._sec;
    const allProjectRows = this.projectRowsFor(dp);
    const projRows = {};
    allProjectRows.forEach(p => { projRows[p.code] = p; });
    const claimed = new Set();
    this.siteRegistry().forEach(s => s.refs.forEach(r => claimed.add(r)));
    const sites = this.siteRegistry().map(s => {
      let workers = 0, present = 0, enrolled = 0;
      const names = [];
      s.refs.forEach(r => {
        const p = projRows[r];
        if (p) { workers += p.registered; present += p.present; enrolled += p.enrolled || 0; names.push(p.code + ' — ' + p.name); }
      });
      return { ...s, workers, present, enrolled, refNames: names };
    });
    const unmapped = allProjectRows.filter(p => !claimed.has(p.code));
    const sectors = this.sectorDefs.map(sec => {
      const list = sites.filter(s => s.sectorCode === sec.code);
      const workers = list.reduce((a, s) => a + s.workers, 0);
      const present = list.reduce((a, s) => a + s.present, 0);
      const enrolled = list.reduce((a, s) => a + s.enrolled, 0);
      const pct = enrolled ? Math.round((present / enrolled) * 100) : 0;
      return { ...sec, sites: list.length, linked: list.filter(s => s.workers > 0).length,
        workers, present, enrolled, pct,
        workersLabel: workers.toLocaleString('en-US'), presentLabel: present.toLocaleString('en-US'),
        pctLabel: enrolled ? pct + '%' : 'لا بصمة',
        barColor: pct >= 80 ? 'var(--color-accent)' : pct >= 50 ? 'var(--color-accent-700)' : 'var(--color-accent-2-700)' };
    });
    const out = { sites, sectors, unmapped,
      unmappedWorkers: unmapped.reduce((a, p) => a + p.registered, 0),
      classified: sites.reduce((a, s) => a + s.workers, 0),
      linkedSites: sites.filter(s => s.workers > 0).length };
    this._secKey = key; this._sec = out;
    return out;
  }

  projectOf(code) { return String(code || '147').slice(0, 3); }
  projectOfWorker(w) { return w.project || this.projectOf(w.contractor); }
  roleOf(profession) {
    const p = (profession || '').trim();
    if (p.includes('مشرف')) return 'supervisor';
    if (p.includes('مساعد')) return 'helper';
    if (p.startsWith('فى') || p.startsWith('فن')) return 'technician';
    return 'worker';
  }
  dashboardAnalytics() {
    const key = this.state.workerRev + '|' + this.state.contractors.length + '|' + this.state.addedSaraks.length;
    if (this._dashCacheKey === key) return this._dashCache;
    const out = this.computeDashboard();
    this._dashCacheKey = key;
    this._dashCache = out;
    return out;
  }
  computeDashboard() {
    const logs = this.attendanceLogData;
    const dates = this.attendanceDates || [...new Set(logs.map(l => l.date))];
    const today = dates[dates.length - 1] || '—';
    const month = today === '—' ? '—' : today.slice(3);
    const presentTodaySet = new Set(logs.filter(l => l.date === today && l.type === 'In').map(l => l.code));
    const presentMonthSet = new Set(logs.filter(l => l.date.slice(3) === month && l.type === 'In').map(l => l.code));
    const enrolledSet = new Set(logs.map(l => l.code));
    this._punchCodes = enrolledSet;
    if (!this._codeToWorker) {
      this._codeToWorker = {};
      this.workers.forEach(w => { this._codeToWorker[w.code] = w; });
    }
    const known = this._codeToWorker;
    const unlinkedPunches = [...enrolledSet].filter(c => !known[c]);
    unlinkedPunches.forEach(c => enrolledSet.delete(c));

    const totalRegistered = this.workers.length;
    const projectMap = {};
    this.projectsData.forEach(p => { projectMap[p.code] = { code: p.code, name: p.name, registered: 0, present: 0, contractors: 0 }; });
    this.workers.forEach(w => {
      const pc = this.projectOfWorker(w);
      if (!projectMap[pc]) projectMap[pc] = { code: pc, name: 'مشروع ' + pc, registered: 0, present: 0, contractors: 0, enrolled: 0 };
      projectMap[pc].registered++;
      if (enrolledSet.has(w.code)) projectMap[pc].enrolled = (projectMap[pc].enrolled || 0) + 1;
      if (presentTodaySet.has(w.code)) projectMap[pc].present++;
    });
    this.state.contractors.forEach(c => {
      const pc = c.project || this.projectOf(c.code);
      if (projectMap[pc]) projectMap[pc].contractors++;
    });
    const projectRows = Object.values(projectMap)
      .filter(p => p.registered > 0 || p.contractors > 0)
      .map(p => {
        const base = p.enrolled || 0;
        const pct = base ? Math.round((p.present / base) * 100) : 0;
        return { ...p, pct, enrolled: base, pctLabel: base ? pct + '%' : 'لا بصمة',
          barColor: pct >= 80 ? 'var(--color-accent)' : pct >= 50 ? 'var(--color-accent-700)' : 'var(--color-accent-2-700)' };
      })
      .sort((a, b) => (b.enrolled - a.enrolled) || (b.registered - a.registered));

    const roleDefs = [
      { key: 'supervisor', label: 'المشرفون', hint: 'مشرف موقع / مشرف وردية' },
      { key: 'technician', label: 'الفنيون', hint: 'مهن فنية متخصصة' },
      { key: 'helper', label: 'المساعدون', hint: 'مساعد فني' },
      { key: 'worker', label: 'العمالة العامة', hint: 'عمال مخازن وتشغيل' },
    ];
    const roleRows = roleDefs.map(d => {
      const list = this.workers.filter(w => this.roleOf(w.profession) === d.key);
      return {
        ...d,
        count: list.length,
        present: list.filter(w => presentTodaySet.has(w.code)).length,
        pct: totalRegistered ? Math.round((list.length / totalRegistered) * 100) : 0,
      };
    });

    const presentToday = presentTodaySet.size;
    // ساعات العمل والتكلفة من سجل البصمة الفعلى (مطابقة دخول/خروج لكل يوم)
    let overtimeHours = 0, laborCost = 0;
    if (logs.length) {
      const byKey = new Map();
      logs.forEach(l => {
        const k = l.code + '|' + l.date;
        const e = byKey.get(k) || { ins: [], outs: [] };
        (l.type === 'In' || l.type === 'in' ? e.ins : e.outs).push(l.time);
        byKey.set(k, e);
      });
      const rateOf = {}; (this.professionsData || []).forEach(p => { rateOf[p.name] = p.hourRate; });
      const wByCode = new Map(this.workers.map(w => [w.code, w]));
      const mins = t => Number(String(t).slice(0, 2)) * 60 + Number(String(t).slice(3, 5));
      byKey.forEach((e, k) => {
        if (!e.ins.length || !e.outs.length) return;
        e.ins.sort(); e.outs.sort();
        const worked = Math.max(0, mins(e.outs[e.outs.length - 1]) - mins(e.ins[0])) / 60;
        if (worked > 8) overtimeHours += worked - 8;
        const w = wByCode.get(k.split('|')[0]);
        laborCost += worked * ((w && rateOf[w.profession]) || 22);
      });
      overtimeHours = Math.round(overtimeHours);
    }
    return {
      projectRows, roleRows,
      ov: {
        totalRegistered,
        projectCount: projectRows.length,
        contractorCount: this.state.contractors.filter(c => (c.count || 0) > 0 || c.code !== 'SELF').length,
        presentToday,
        enrolled: enrolledSet.size,
        enrolledLabel: enrolledSet.size.toLocaleString('en-US'),
        presentTodayPct: enrolledSet.size ? Math.round((presentToday / enrolledSet.size) * 100) : 0,
        presentMonth: presentMonthSet.size,
        presentMonthPct: enrolledSet.size ? Math.round((presentMonthSet.size / enrolledSet.size) * 100) : 0,
        overtimeHours: overtimeHours,
        costLabel: Math.round(laborCost).toLocaleString('en-US'),
        absentToday: Math.max(0, enrolledSet.size - presentToday),
        unlinkedPunches: unlinkedPunches.length,
        logSource: this.attendanceSource || '',
        dayCount: dates.length,
        periodLabel: dates.length ? dates[0] + ' – ' + dates[dates.length - 1] : '—',
        today,
        monthLabel: month,
      },
    };
  }

  addUser() {
    const s = this.state;
    if (!s.newUserName.trim()) return;
    const proj = this.projectsData.find(p => p.code === s.newUserProject) || this.projectsData[0] || { code: '—', name: 'غير محدد' };
    const scope = s.newUserRole === 'إدارة عليا'
      ? 'كل المشاريع والمقاولين'
      : `مشروع ${proj.code} — ${proj.name} فقط`;
    this.setState({
      users: [...s.users, { name: s.newUserName.trim(), role: s.newUserRole, scope, projectCode: proj.code }],
      newUserName: '',
    });
  }
  deleteUser(idx) {
    this.setState({ users: this.state.users.filter((_, i) => i !== idx) });
  }

  sarakJobTitles = [];

  professionsData = this.sarakJobTitles.map((name, i) => {
    const isSupervisor = name.includes('مشرف') || name.includes('رئيس');
    const isHelper = name.includes('مساعد') || name.includes('عامل نظافة') || name.includes('عامل بوفيه');
    const category = isSupervisor ? 'A' : (isHelper ? 'C' : 'B');
    const hourRate = isSupervisor ? 32.0 : (isHelper ? 16.0 : 22.0);
    return {
      code: String(200 + i), name, category,
      hourRate, overtimeRate: hourRate, deductionRate: hourRate,
      stopped: false,
    };
  });

  shiftsData = [
    { code: '8To17G', name: 'وردية عمل العمال', start: '08:00', end: '17:00', breakHours: 1, hours: 8, full: false },
    { code: '7To19S', name: 'وردية عمل الأمن', start: '07:00', end: '19:00', breakHours: 0, hours: 12, full: true },
  ];
  DAY_HOURS = 8;
  DAY_SPAN = 9;
  shiftName(code) { const sh = this.shiftsData.find(x => x.code === code); return sh ? sh.name : (code || '—'); }
  catDaily(k) { return parseFloat((this.state.catRates[k] || {}).daily) || 0; }
  catHour(k) { const d = this.catDaily(k); return d ? Math.round((d / this.DAY_HOURS) * 100) / 100 : 0; }
  allDepts() { return this.deptDefs; }
  regionOptions(sectorCode) {
    const all = this.siteRegistry();
    const list = (sectorCode && sectorCode !== 'all') ? all.filter(x => x.sectorCode === sectorCode) : all;
    return list.map(x => ({ code: x.code, name: x.name }));
  }
  regionName(code) { const r = this.siteRegistry().find(x => x.code === code); return r ? r.name : '—'; }
  setSarakAdj(code, field, value) {
    this.setState(st => ({ sarakAdj: { ...st.sarakAdj, [code]: { ...(st.sarakAdj[code] || {}), [field]: value } } }));
  }
  swHoursCalc() {
    const s = this.state;
    const mins = t => { const p = String(t || '').split(':'); return (+p[0] || 0) * 60 + (+p[1] || 0); };
    const sh = this.shiftsData.find(x => x.code === s.swShift) || {};
    let d = mins(s.swOut) - mins(s.swIn);
    if (d < 0) d += 24 * 60;
    const net = Math.max(0, d - (sh.breakHours || 0) * 60);
    const ot = Math.max(0, net - (sh.hours || this.DAY_HOURS) * 60);
    return { net, label: Math.floor(net / 60) + ':' + String(net % 60).padStart(2, '0') + (ot ? ' (إضافي ' + (ot / 60).toFixed(1) + ' س)' : '') };
  }

  attendanceLogData = [];

  roleDescriptions = {
    'إدارة عليا': 'وصول كامل لكل المشاريع والمقاولين، التقارير وKPI، إدارة المستخدمين والأدوار.',
    'إشراف': 'عرض وتعديل سراكي وحضور نطاقه فقط، موافقة الاستثناءات والساعات الإضافية.',
    'إدخال بيانات': 'تسجيل حضور/انصراف وإضافة بيان عمل لليوم الحالي فقط، بلا وصول لتقارير التكلفة.',
  };

  setScreen(screen) { this.setState({ screen, selectedWorkerCode: null }); }
  gotoContractor(delta) {
    const n = this.state.contractors.length;
    if (!n) return;
    this.setState({ contractorIndex: (this.state.contractorIndex + delta + n) % n });
  }
  onNewContractorField(field, e) { this.setState({ [field]: e.target.value }); }
  // كود المقاول = كود المشروع (3) + تسلسل المقاول داخل المشروع (2) + 000
  contractorNameList() {
    const key = this.state.contractors.length;
    if (this._cnlKey === key) return this._cnl;
    const byName = new Map();
    this.state.contractors.forEach(c => {
      if (!c.name || c.code === 'SELF') return;
      const e = byName.get(c.name) || { name: c.name, projects: 0 };
      e.projects++; byName.set(c.name, e);
    });
    this._cnlKey = key;
    this._cnl = [...byName.values()].sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
      .map(x => ({ name: x.name, label: x.name + (x.projects > 1 ? ' (فى ' + x.projects + ' مشاريع)' : '') }));
    return this._cnl;
  }
  normName(n) {
    return String(n || '')
      .replace(/[\u064B-\u0652\u0670\u0640]/g, '')
      .replace(/[\u0623\u0625\u0622]/g, '\u0627')
      .replace(/\u0649/g, '\u064a').replace(/\u0629/g, '\u0647').replace(/\u0624/g, '\u0648').replace(/\u0626/g, '\u064a')
      .replace(/(شركة|موسسه|مكتب|المهندس|الحاج|السيد|مقاولات|للمقاولات)/g, '')
      .replace(/ال/g, '')
      .replace(/[^\u0621-\u064aa-z0-9]/gi, '')
      .trim();
  }
  // أسماء المقاولين بدون أكواد — دمج الصيغ المختلفة لنفس الاسم داخل المشروع
  contractorNameBox(sector, project) {
    const groups = new Map();
    this.state.contractors.forEach(c => {
      if (!c.name) return;
      const pc = c.project || '';
      const geo = this.sectorOfProject(pc);
      if (sector !== 'all' && geo.sectorCode !== sector) return;
      if (project !== 'all' && pc !== project) return;
      const key = this.normName(c.name) + '|' + pc;
      const g = groups.get(key) || {
        names: [], codes: [], projectName: c.projectName || (this.projectsData.find(p => p.code === pc) || {}).name || '—',
        sectorName: geo.sectorName, workers: 0,
      };
      if (!g.names.includes(c.name)) g.names.push(c.name);
      if (!g.codes.includes(c.code)) g.codes.push(c.code);
      g.workers += c.count || 0;
      groups.set(key, g);
    });
    return [...groups.values()]
      .sort((a, b) => (a.names[0] < b.names[0] ? -1 : a.names[0] > b.names[0] ? 1 : 0))
      .map(g => {
        const merged = g.names.length > 1 || g.codes.length > 1;
        return {
          names: g.names.join('، '),
          projectName: g.projectName,
          sectorName: g.sectorName,
          workers: (g.workers || 0).toLocaleString('en-US'),
          merged,
          mergeClass: merged ? 'tag-accent-2' : 'tag-neutral',
          mergeLabel: merged ? 'مدمج — ' + g.codes.length + ' أكواد' : 'اسم مفرد',
        };
      });
  }
  projectOptsFor(sector) {
    const k = 'p|' + sector + '|' + this.projectsData.length;
    if (this._poKey === k) return this._po;
    this._poKey = k;
    this._po = [{ code: 'all', name: 'كل المشاريع' }].concat(
      this.projectsData
        .filter(p => sector === 'all' || this.sectorOfProject(p.code).sectorCode === sector)
        .map(p => ({ code: p.code, name: p.code + ' — ' + p.name })));
    return this._po;
  }
  contractorOptsFor(sector, project) {
    const k = 'c|' + sector + '|' + project + '|' + this.state.contractors.length;
    if (this._coKey === k) return this._co;
    this._coKey = k;
    this._co = [{ code: 'all', name: 'كل المقاولين' }].concat(
      this.state.contractors
        .filter(c => {
          if (project !== 'all') return c.code === 'SELF' || c.project === project || String(c.code).slice(0, 3) === project;
          if (sector !== 'all') return c.code === 'SELF' || this.sectorOfProject(c.project).sectorCode === sector;
          return true;
        })
        .map(c => ({ code: c.code, name: c.code === 'SELF' ? 'العمالة الذاتية' : c.code + ' — ' + c.name })));
    return this._co;
  }
  nwSectorOpts() {
    if (!this._nwSecOpts) {
      this._nwSecOpts = [{ code: 'all', name: 'كل القطاعات' }]
        .concat(this.sectorDefs.map(x => ({ code: x.code, name: x.code + ' — ' + x.name })));
    }
    return this._nwSecOpts;
  }
  nextContractorCode(projectCode, type) {
    const pc = String(projectCode || '').trim();
    if (!pc) return '';
    // عمالة ذاتى: كود الجهة = كود المشروع + 10 + 000 ، وأكواد العمال تكمل الذاتى الموجود بنفس المشروع
    if (type === 'عمالة ذاتى') return pc + '10000';
    let last = 0;
    this.state.contractors.forEach(c => {
      const code = String(c.code || '');
      if (code.length !== 8) return;
      if (code.slice(0, 3) !== pc && c.project !== pc) return;
      const seq = parseInt(code.slice(3, 5), 10);
      if (!isNaN(seq) && seq > last) last = seq;
    });
    return pc + String(last + 1).padStart(2, '0') + '000';
  }
  addContractor() {
    const s = this.state;
    const name = (s.newContractorNamePick || s.newContractorName).trim();
    const code = this.nextContractorCode(s.newContractorProject, s.newContractorType);
    if (!name || !code) return;
    const projName = (this.projectsData.find(p => p.code === s.newContractorProject) || {}).name || '—';
    const c = {
      code, name, type: s.newContractorType, project: s.newContractorProject, projectName: projName,
      active: true, count: 0,
      regDate: s.newContractorDate.trim() || new Date().toLocaleDateString('en-GB'),
    };
    this.setState({
      contractors: [...s.contractors, c],
      contractorIndex: s.contractors.length,
      newContractorCode: '', newContractorName: '', newContractorNamePick: '', newContractorProject: '', newContractorDate: '',
    });
  }
  deleteContractor() {
    const s = this.state;
    if (s.contractors.length <= 1) return;
    const contractors = s.contractors.filter((_, i) => i !== s.contractorIndex);
    this.setState({ contractors, contractorIndex: Math.min(s.contractorIndex, contractors.length - 1) });
  }
  selectWorker(code) { this.setState({ selectedWorkerCode: code }); }
  clearWorker() { this.setState({ selectedWorkerCode: null }); }
  gotoProfPage(delta) {
    const total = this.professionsData.length + this.state.addedProfessions.length;
    const max = Math.ceil(total / this.PROF_PAGE_SIZE) - 1;
    this.setState({ profPage: Math.min(max, Math.max(0, this.state.profPage + delta)) });
  }
  gotoLogPage(delta) {
    const max = Math.ceil(this.attendanceLogData.length / this.PAGE_SIZE) - 1;
    this.setState({ logPage: Math.min(max, Math.max(0, this.state.logPage + delta)) });
  }
  setRoleView(roleView) { this.setState({ roleView }); }
  onSearchChange(e) { this.setState({ workerSearch: e.target.value, workerPage: 0 }); }
  onManualChange(e) { this.setState({ manualCode: e.target.value }); }

  doScan() {
    const pool = this.workers;
    const w = pool[Math.floor(Math.random() * pool.length)];
    this._logCheckin(w);
  }
  doManualScan() {
    const code = this.state.manualCode.trim();
    const w = this.workers.find(x => x.code === code);
    if (!w) return;
    this._logCheckin(w);
    this.setState({ manualCode: '' });
  }
  _logCheckin(w) {
    const alreadyIn = this.state.scanLog.some(s => s.code === w.code && s.type === 'in') &&
      !this.state.scanLog.some(s => s.code === w.code && s.type === 'out');
    const type = alreadyIn ? 'out' : 'in';
    const now = new Date();
    const time = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
    this.setState({ scanLog: [{ code: w.code, name: w.name, time, type }, ...this.state.scanLog] });
  }

  renderVals() {
    const s = this.state;
    const nwCode = (s.screen === 'workers' && s.nw.project && s.nw.contractor) ? this.nextWorkerCode(s.nw.contractor) : '';
    const ac = s.contractors[s.contractorIndex] || { code: '—', name: 'لا يوجد مقاولون', type: '—', active: true, regDate: '—', project: '', projectName: '—', count: 0 };
    const acCount = ac.count != null ? ac.count : 0;
    const newConCode = (s.screen === 'contractors' && s.newContractorProject) ? this.nextContractorCode(s.newContractorProject, s.newContractorType) : '';
    // مقاولو المشروع المختار — كود المقاول يبدأ بكود المشروع
    const nwCons = (s.screen === 'workers' && s.showWorkerForm && s.nw.project)
      ? s.contractors.filter(c => c.code === 'SELF' || c.project === s.nw.project || String(c.code).slice(0, 3) === s.nw.project)
      : [];
    if (!this._codeToWorker) {
      this._codeToWorker = {};
      this.workers.forEach(w => { this._codeToWorker[w.code] = w; });
      this._deptOptions = [...new Set(this.workers.map(w => w.dept))];
    }
    const codeToWorker = this._codeToWorker;
    if (!this._byContractor) {
      this._byContractor = new Map();
      this.workers.forEach(w => {
        if (!this._byContractor.has(w.contractor)) this._byContractor.set(w.contractor, []);
        this._byContractor.get(w.contractor).push(w);
      });
      this._profBars = null;
      this._contractorName = {};
      s.contractors.forEach(c => { this._contractorName[c.code] = c.name; });
    }
    const logKey = [s.logType, s.logDept, s.logSearch, s.logDate, s.logSector, s.logProject, s.workerRev].join('|');
    if (this._logKey !== logKey) {
      this._logKey = logKey;
      this._filteredLog = this.attendanceLogData.filter(l => {
        const w = codeToWorker[l.code];
        if (s.logDate && s.logDate !== 'all' && l.date !== s.logDate) return false;
        if (s.logType !== 'all' && l.type !== s.logType) return false;
        if (s.logDept !== 'all' && (!w || w.dept !== s.logDept)) return false;
        if ((s.logProject || 'all') !== 'all' && (!w || this.projectOfWorker(w) !== s.logProject)) return false;
        if ((s.logSector || 'all') !== 'all' && (!w || this.sectorOfProject(this.projectOfWorker(w)).sectorCode !== s.logSector)) return false;
        if (s.logSearch && !(l.code.includes(s.logSearch) || (w && w.name.includes(s.logSearch)))) return false;
        return true;
      });
    }
    const filteredLog = this._filteredLog;
    const drafts = s.wDraft || {};
    const withSelect = (w) => {
      const pc = this.projectOfWorker(w);
      const geo = this.sectorOfProject(pc);
      const dr = drafts[w.code] || {};
      const dirty = !!drafts[w.code];
      const pick = (k, fb) => (dr[k] !== undefined ? dr[k] : fb);
      const status = pick('status', w.status || 'نشط');
      const rateV = pick('rate', w.rate != null && w.rate !== '' ? w.rate : this.categoryRate(pick('category', w.category)));
      const hoursV = pick('hours', w.hours || '8');
      return {
        ...w,
        category: pick('category', w.category),
        dirty,
        rowBg: dirty ? 'var(--color-accent-100)' : 'transparent',
        saveHandler: () => this.saveWorkerDraft(w.code),
        revertHandler: () => this.revertWorkerDraft(w.code),
        regDate: w.regDate || '17/07/2022',
        startDate: w.startDate || '01/08/2022',
        contractorName: (this._contractorName || {})[w.contractor] || '—',
        status,
        statusTag: status === 'نشط' ? 'tag-accent' : 'tag-accent-2',
        rateValue: rateV,
        allowanceValue: pick('allowance', w.allowance != null ? w.allowance : 0),
        hoursValue: hoursV,
        hourlyValue: this.perHour(rateV, hoursV),
        birthDate: (() => { const b = w.birthDate || this.birthFromCard(w.card); return b ? b.split('-').reverse().join('/') : '—'; })(),
        age: this.ageFrom(w.birthDate || this.birthFromCard(w.card)),
        birthPlace: w.birthPlace || this.placeFromCard(w.card) || '—',
        editHandler: () => this.openEditWorker(w.code),
        allowanceHandler: (e) => this.setWorkerDraft(w.code, 'allowance', e.target.value),
        hoursHandler: (e) => this.setWorkerDraft(w.code, 'hours', e.target.value),
        projectLabel: pc + ' — ' + geo.siteName,
        sectorLabel: geo.sectorName,
        leaveDate: w.leaveDate || '—',
        selectHandler: () => this.selectWorker(w.code),
        deleteHandler: () => this.deleteWorker(w.code),
        categoryHandler: (e) => this.setWorkerDraft(w.code, 'category', e.target.value),
        statusHandler: (e) => this.setWorkerDraft(w.code, 'status', e.target.value),
        rateHandler: (e) => this.setWorkerDraft(w.code, 'rate', e.target.value),
      };
    };
    const onWorkers = s.screen === 'workers';
    const wmKey = (s.workerSearch || '') + '|' + (s.wfSector || 'all') + '|' + (s.wfProject || 'all') + '|' + (s.wfContractor || 'all') + '|' + s.workerRev;
    if (onWorkers && this._wmKey !== wmKey) {
      this._wmKey = wmKey;
      const q = s.workerSearch, sec = s.wfSector || 'all', prj = s.wfProject || 'all', con = s.wfContractor || 'all';
      const plain = !q && sec === 'all' && prj === 'all' && con === 'all';
      this._workerMatches = plain ? this.workers : this.workers.filter(w => {
        if (q && !(w.name.includes(q) || w.code.includes(q) || (w.profession || '').includes(q))) return false;
        if (prj !== 'all' && w.project !== prj) return false;
        if (con !== 'all' && w.contractor !== con) return false;
        if (sec !== 'all' && this.sectorOfProject(w.project).sectorCode !== sec) return false;
        return true;
      });
    }
    const workerMatches = onWorkers ? (this._workerMatches || this.workers) : [];
    const workerMatchCount = workerMatches.length;
    const wPages = Math.max(1, Math.ceil(workerMatchCount / this.WORKER_VIEW_LIMIT));
    const wPage = Math.min(s.workerPage || 0, wPages - 1);
    const wStart = wPage * this.WORKER_VIEW_LIMIT;
    const filteredWorkers = workerMatches.slice(wStart, wStart + this.WORKER_VIEW_LIMIT).map(withSelect);
    const workerViewNote = 'عرض ' + (workerMatchCount ? (wStart + 1) : 0) + ' – ' +
      Math.min(wStart + this.WORKER_VIEW_LIMIT, workerMatchCount) + ' من ' +
      workerMatchCount.toLocaleString('en-US') + ' عامل';
    const workerPageLabel = (wPage + 1) + ' / ' + wPages.toLocaleString('en-US');
    const gotoWorkerPage = (d) => this.setState({ workerPage: Math.min(wPages - 1, Math.max(0, wPage + d)) });
    const scanLog = s.scanLog.map(x => ({ ...x, typeLabel: x.type === 'in' ? 'دخول' : 'خروج', tagClass: x.type === 'in' ? 'tag-accent' : 'tag-accent-2' }));
    if (this._profBarsRev !== s.workerRev || !this._profBars) {
      this._profBarsRev = s.workerRev;
      const professionCounts = {};
      this.workers.forEach(w => { professionCounts[w.profession] = (professionCounts[w.profession] || 0) + 1; });
      const maxCount = Math.max(1, ...Object.values(professionCounts));
      this._profBars = Object.entries(professionCounts)
        .sort((a, b) => b[1] - a[1]).slice(0, 12)
        .map(([name, count]) => ({ name, count, pct: Math.round((count / maxCount) * 100) }));
    }
    const professionBars = this._profBars;
    const dash = this.dashboardAnalytics();

    const totalWorkers = this.workers.length;
    const presentCount = dash.ov.presentToday;
    const sarakCount = this.sarakRecords.length;
    const matchedCount = this.sarakRecords.filter(r => r.status === 'مطابق').length;

    return {
      screen: s.screen,
      ...dash,
      workerViewNote,
      noWorkerResults: onWorkers && workerMatchCount === 0,
      workerMatchCount,
      workerPageLabel,
      gotoWorkerPrev: () => gotoWorkerPage(-1),
      gotoWorkerNext: () => gotoWorkerPage(1),
      gotoWorkerFirst: () => this.setState({ workerPage: 0 }),
      gotoWorkerLast: () => this.setState({ workerPage: wPages - 1 }),
      dsProjects: (s.datasetInfo || {}).projects || this.projectsData.length,
      dsSelf: ((s.datasetInfo || {}).self || 0).toLocaleString('en-US'),
      dsSub: ((s.datasetInfo || {}).sub || 0).toLocaleString('en-US'),
      dsContractors: (s.datasetInfo || {}).contractors || this.state.contractors.length,
      isDashboard: s.screen === 'dashboard', dashboardActive: s.screen === 'dashboard' ? 'active' : '',
      isAnalytics: s.screen === 'analytics', analyticsActive: s.screen === 'analytics' ? 'active' : '',
      an: s.screen === 'analytics' ? this.analytics().an : {},
      anChart: s.screen === 'analytics' ? this.analytics().chart : [],
      anWeekdays: s.screen === 'analytics' ? this.analytics().weekdays : [],
      anForecast: s.screen === 'analytics' ? this.analytics().forecast : [],
      anRoles: s.screen === 'analytics' ? this.analytics().roleAnalysis : [],
      anProjects: s.screen === 'analytics' ? this.analytics().projectAnalysis : [],
      anDays: s.screen === 'analytics' ? this.analytics().dayRows : [],
      isWorkers: s.screen === 'workers', workersActive: s.screen === 'workers' ? 'active' : '',
      isScan: s.screen === 'scan', scanActive: s.screen === 'scan' ? 'active' : '',
      isContractors: s.screen === 'contractors', contractorsActive: s.screen === 'contractors' ? 'active' : '',
      isProfessions: s.screen === 'professions', professionsActive: s.screen === 'professions' ? 'active' : '',
      isShifts: s.screen === 'shifts', shiftsActive: s.screen === 'shifts' ? 'active' : '',
      isAttendanceLog: s.screen === 'attendanceLog', attendanceLogActive: s.screen === 'attendanceLog' ? 'active' : '',
      isSarak: s.screen === 'sarak', sarakActive: s.screen === 'sarak' ? 'active' : '',
      isSarakWork: s.screen === 'sarakWork', sarakWorkActive: s.screen === 'sarakWork' ? 'active' : '',
      isSarakPrint: s.screen === 'sarakPrint', sarakPrintActive: s.screen === 'sarakPrint' ? 'active' : '',
      isAllowances: s.screen === 'allowances', allowancesActive: s.screen === 'allowances' ? 'active' : '',
      isTransfers: s.screen === 'transfers', transfersActive: s.screen === 'transfers' ? 'active' : '',
      ...this.sarakPrintVals(),
      ...this.dayTotalsVals(),
      isDayTotals: s.screen === 'dayTotals', dayTotalsActive: s.screen === 'dayTotals' ? 'active' : '',
      ...this.hrVals(),
      isAlerts: s.screen === 'alerts', alertsActive: s.screen === 'alerts' ? 'active' : '',
      isProjectSheet: s.screen === 'projectSheet', projectSheetActive: s.screen === 'projectSheet' ? 'active' : '',
      isUpload: s.screen === 'upload', uploadActive: s.screen === 'upload' ? 'active' : '',
      isReports: s.screen === 'reports', reportsActive: s.screen === 'reports' ? 'active' : '',
      isUsers: s.screen === 'users', usersActive: s.screen === 'users' ? 'active' : '',
      setScreen: (scr) => this.setScreen(scr),
      goPrintFin: () => { this.setState({ spForm: 'fin' }); this.setScreen('sarakPrint'); },
      goPrintTec: () => { this.setState({ spForm: 'tec' }); this.setScreen('sarakPrint'); },
      nav: {
        dashboard: () => this.setScreen('dashboard'),
        analytics: () => this.setScreen('analytics'),
        workers: () => this.setScreen('workers'),
        contractors: () => this.setScreen('contractors'),
        professions: () => this.setScreen('professions'),
        shifts: () => this.setScreen('shifts'),
        scan: () => this.setScreen('scan'),
        attendanceLog: () => this.setScreen('attendanceLog'),
        sarak: () => this.setScreen('sarak'),
        sarakWork: () => this.setScreen('sarakWork'),
        sarakPrint: () => this.setScreen('sarakPrint'),
        dayTotals: () => this.setScreen('dayTotals'),
        allowances: () => this.setScreen('allowances'),
        transfers: () => this.setScreen('transfers'),
        alerts: () => this.setScreen('alerts'),
        projectSheet: () => this.setScreen('projectSheet'),
        upload: () => this.setScreen('upload'),
        reports: () => this.setScreen('reports'),
        users: () => this.setScreen('users'),
      },
      roleHandlers: {
        admin: () => this.setRoleView('إدارة عليا'),
        sup: () => this.setRoleView('إشراف'),
        entry: () => this.setRoleView('إدخال بيانات'),
      },

      workers: this.workers.slice(0, 100),
      dirtyCount: Object.keys(s.wDraft || {}).length,
      hasDirty: Object.keys(s.wDraft || {}).length > 0,
      lastSavedLabel: s.lastSaved ? 'آخر حفظ: ' + s.lastSaved : 'لا تعديلات محفوظة في هذه الجلسة',
      saveAllWorkers: () => this.saveAllWorkerDrafts(),
      revertAllWorkers: () => this.revertAllWorkerDrafts(),
      catRatesSavedLabel: s.catRatesSaved ? 'محفوظة — ' + s.catRatesSaved : 'لم تُحفظ بعد',
      saveCatRates: () => this.saveCatRates(),
      showWorkerForm: s.showWorkerForm,
      workerFormLabel: s.showWorkerForm ? 'إغلاق النموذج ✕' : '+ إضافة عامل',
      toggleWorkerForm: () => this.toggleWorkerForm(),
      nw: s.nw,
      nwContractorOptions: nwCons,
      nwContractorDisabled: !s.nw.project,
      nwContractorPlaceholder: !s.nw.project ? 'اختر المشروع أولًا' : (nwCons.length ? 'اختر اسم المقاول' : 'لا يوجد مقاولون مسجلون لهذا المشروع'),
      nwProjectCode: s.nw.project || '—',
      nwContractorCode: s.nw.contractor === 'SELF' ? 'عمالة ذاتية' : (s.nw.contractor || '—'),
      nextWorkerCode: nwCode,
      nwAutoCode: nwCode || '—',
      nwCodeNote: nwCode
        ? (s.nw.contractor === 'SELF'
          ? 'عمالة ذاتية — الكود مشتق من كود المشروع ' + s.nw.project + ' ويكمل آخر كود مسجَّل به · غير قابل للتعديل'
          : 'كود المقاول ' + s.nw.contractor + ' يبدأ بكود المشروع ' + s.nw.project + ' — وكود العامل يكمل آخر كود مسجَّل على هذا المقاول فى نفس المشروع · غير قابل للتعديل')
        : 'اختر المشروع والمقاول أولًا ليتم توليد كود العامل آليًا من كود المقاول',
      nwSaveDisabled: !(nwCode && s.nw.project && s.nw.contractor && s.nw.name.trim()
        && (s.nw.birthDate || this.birthFromCard(s.nw.card))
        && ((s.nw.birthPlace || '').trim() || this.placeFromCard(s.nw.card))
        && !this.findByCard(s.nw.card)),
      nwContractorName: (s.contractors.find(c => c.code === s.nw.contractor) || {}).name || '—',
      onNwName: (e) => this.setNw('name', e.target.value),
      onNwCode: (e) => this.setNw('code', e.target.value),
      onNwProfession: (e) => this.setNw('profession', e.target.value),
      onNwCard: (e) => this.setNw('card', e.target.value),
      onNwAllowance: (e) => this.setNw('allowance', e.target.value),
      onNwCategory: (e) => {
        const v = e.target.value;
        const cr = this.state.catRates[v] || {};
        const hr = this.catHour(v);
        this.setState(st => ({ nw: { ...st.nw, category: v,
          allowance: cr.allowance != null ? cr.allowance : st.nw.allowance,
          rate: hr ? String(hr) : st.nw.rate } }));
      },
      onNwRate: (e) => this.setNw('rate', e.target.value),
      onNwHours: (e) => this.setNw('hours', e.target.value),
      hourOptions: this.hourOptions,
      nwHourly: this.perHour(s.nw.rate, s.nw.hours || '8'),
      onNwStatus: (e) => this.setNw('status', e.target.value),
      nwSectorOptions: [{ code: 'all', name: 'كل القطاعات' }]
        .concat(this.sectorDefs.map(x => ({ code: x.code, name: x.code + ' — ' + x.name }))),
      nwProjectOptions: this.projectsData
        .filter(p => s.nw.sector === 'all' || this.sectorOfProject(p.code).sectorCode === s.nw.sector)
        .map(p => ({ code: p.code, name: p.code + ' — ' + p.name })),
      nwSectorLabel: this.sectorOfProject(s.nw.project).sectorName,
      onNwSector: (e) => {
        const sec = e.target.value;
        this.setState(st => ({ nw: { ...st.nw, sector: sec, project: '' } }));
      },
      onNwProject: (e) => this.setState(st => ({ nw: { ...st.nw, project: e.target.value, contractor: '' } })),
      nwRegDateIso: this.toIso(s.nw.regDate),
      nwStartDateIso: this.toIso(s.nw.startDate),
      onNwRegDate: (e) => this.setNw('regDate', this.toDmy(e.target.value)),
      onNwStartDate: (e) => this.setNw('startDate', this.toDmy(e.target.value)),
      onNwContractor: (e) => this.setNw('contractor', e.target.value),
      addWorker: () => this.addWorker(),
      workerSearch: s.workerSearch,
      wfSector: s.wfSector || 'all',
      wfProject: s.wfProject || 'all',
      wfSectorOptions: this.nwSectorOpts(),
      wfProjectOptions: onWorkers ? this.projectOptsFor(s.wfSector || 'all') : [],
      onWfSector: (e) => this.setState({ wfSector: e.target.value, wfProject: 'all', wfContractor: 'all', workerPage: 0 }),
      onWfProject: (e) => this.setState({ wfProject: e.target.value, wfContractor: 'all', workerPage: 0 }),
      wfContractor: s.wfContractor || 'all',
      wfContractorOptions: onWorkers ? this.contractorOptsFor(s.wfSector || 'all', s.wfProject || 'all') : [],
      onWfContractor: (e) => this.setState({ wfContractor: e.target.value, workerPage: 0 }),
      onSearchChange: (e) => this.onSearchChange(e),
      filteredWorkers,

      manualCode: s.manualCode,
      onManualChange: (e) => this.onManualChange(e),
      doScan: () => this.doScan(),
      doManualScan: () => this.doManualScan(),
      scanLog,
      scanHint: 'وجّه الكاميرا نحو باركود بطاقة العامل',
      nowLabel: 'الموقع: ' + (this.state.datasetInfo && this.state.datasetInfo.projects ? 'كل المشاريع (' + this.state.datasetInfo.projects + ')' : 'لا توجد مشاريع مسجَّلة'),

      contractors: s.contractors,
      scopeLabel: dash.projectRows.length ? 'كل المشاريع — ' + dash.projectRows.length + ' مشروع نشط' : 'لا توجد مشاريع مسجَّلة',
      activeContractorLabel: ac.code === '—' ? 'لا يوجد مقاولون مسجَّلون' : 'المقاول ' + ac.code + ' — ' + ac.name,
      activeContractorCount: acCount.toLocaleString('en-US'),
      contractor: { ...ac, statusLabel: ac.active ? 'العمل مستمر' : 'متوقف', projectName: ac.projectName || 'كل المشاريع' },
      contractorPos: (s.contractors.length ? s.contractorIndex + 1 : 0) + ' / ' + s.contractors.length,
      contractorWorkers: (this._byContractor.get(ac.code) || []).slice(0, 60).map(withSelect),
      contractorWorkerCount: acCount.toLocaleString('en-US'),
      contractorPickValue: String(s.contractorIndex),
      contractorOptions: s.contractors.map((c, i) => ({ i: String(i), label: c.code + ' — ' + c.name + ' (' + (c.count || 0) + ')' })),
      onPickContractor: (e) => this.setState({ contractorIndex: Number(e.target.value), selectedWorkerCode: null }),
      canDeleteContractor: s.contractors.length > 1,
      gotoContractorPrev: () => this.gotoContractor(-1),
      gotoContractorNext: () => this.gotoContractor(1),
      addContractor: () => this.addContractor(),
      deleteContractor: () => this.deleteContractor(),
      newContractorCode: s.newContractorCode,
      newContractorProject: s.newContractorProject,
      newContractorNamePick: s.newContractorNamePick,
      newContractorNameLocked: !!s.newContractorNamePick,
      newContractorAutoCode: newConCode || '—',
      newContractorSaveDisabled: !(newConCode && (s.newContractorNamePick || s.newContractorName.trim())),
      newContractorCodeNote: newConCode
        ? (s.newContractorType === 'عمالة ذاتى'
          ? 'عمالة ذاتية — أول ثلاثة أرقام هى كود المشروع ' + s.newContractorProject + ' ، وأكواد العمال تكمل العمالة الذاتية المسجلة بنفس المشروع'
          : 'مشتق من كود المشروع ' + s.newContractorProject + ' — يكمل تسلسل مقاولى نفس المشروع · المقاول المتكرر فى مشروع آخر يأخذ كودًا مستقلاً')
        : 'اختر المشروع أولًا ليتم توليد كود المقاول آليًا',
      contractorNameOptions: this.contractorNameList(),
      ...(s.screen === 'contractors' ? (() => {
        const sec = s.cnSector || 'all', prj = s.cnProject || 'all';
        const rows = this.contractorNameBox(sec, prj);
        return {
          cnRows: rows,
          cnCount: rows.length.toLocaleString('en-US'),
          cnMergedCount: rows.filter(r => r.merged).length.toLocaleString('en-US'),
          cnSector: sec, cnProject: prj,
          cnSectorOptions: this.nwSectorOpts(),
          cnProjectOptions: this.projectOptsFor(sec),
          onCnSector: (e) => this.setState({ cnSector: e.target.value, cnProject: 'all' }),
          onCnProject: (e) => this.setState({ cnProject: e.target.value }),
        };
      })() : { cnRows: [], cnCount: '0', cnMergedCount: '0', cnSector: 'all', cnProject: 'all', cnSectorOptions: [], cnProjectOptions: [], onCnSector: () => {}, onCnProject: () => {} }),
      onNewContractorProject: (e) => this.setState({ newContractorProject: e.target.value }),
      onNewContractorNamePick: (e) => this.setState({ newContractorNamePick: e.target.value, newContractorName: '' }),
      newContractorName: s.newContractorName,
      newContractorType: s.newContractorType,
      newContractorDate: s.newContractorDate,
      onNewContractorCode: (e) => this.onNewContractorField('newContractorCode', e),
      onNewContractorName: (e) => this.onNewContractorField('newContractorName', e),
      onNewContractorType: (e) => this.onNewContractorField('newContractorType', e),
      newContractorDateIso: this.toIso(s.newContractorDate),
      onNewContractorDate: (e) => this.setState({ newContractorDate: this.toDmy(e.target.value) }),

      categoryRates: ['A', 'B', 'C', 'D', 'E'].map(k => ({
        key: k,
        label: (s.catRates[k] || {}).label || '—',
        daily: (s.catRates[k] || {}).daily || '',
        rate: this.catHour(k) ? this.catHour(k).toFixed(2) : '—',
        overtime: this.catHour(k) ? this.catHour(k).toFixed(2) : '—',
        allowance: (s.catRates[k] || {}).allowance || '',
        onDaily: (e) => this.setCatRate(k, 'daily', e.target.value),
        onAllowance: (e) => this.setCatRate(k, 'allowance', e.target.value),
      })),
      professionsPage: (this._profListRev === (s.workerRev + '|' + s.addedProfessions.length) ? this._profList
        : (this._profListRev = s.workerRev + '|' + s.addedProfessions.length, this._profList = [...this.professionsData, ...s.addedProfessions]))
        .slice(s.profPage * this.PROF_PAGE_SIZE, s.profPage * this.PROF_PAGE_SIZE + this.PROF_PAGE_SIZE)
        .map(p => ({ ...p, statusLabel: p.stopped ? 'متوقفة' : 'سارية', deptLabel: p.dept || '—',
          dailyRate: p.dailyPay != null ? p.dailyPay : Math.round((p.hourRate || 0) * this.DAY_HOURS * 100) / 100 })),
      professions: [...this.professionsData, ...s.addedProfessions].map(p => ({ ...p, statusLabel: p.stopped ? 'متوقفة' : 'سارية' })),
      profPageLabel: (s.profPage + 1) + ' / ' + Math.max(1, Math.ceil((this.professionsData.length + s.addedProfessions.length) / this.PROF_PAGE_SIZE)),
      gotoProfPrev: () => this.gotoProfPage(-1), gotoProfNext: () => this.gotoProfPage(1),
      newProfName: s.newProfName,
      newProfCategory: s.newProfCategory,
      availableProfessionTitles: this.sarakJobTitles,
      onNewProfName: (e) => this.setState({ newProfName: e.target.value }),
      onNewProfCategory: (e) => this.setState({ newProfCategory: e.target.value }),
      addProfession: () => this.addProfession(),

      shifts: this.shiftsData.map(sh => ({ ...sh, fullLabel: sh.full ? 'كاملة' : 'حسب الحضور' })),

      attendanceLogPage: filteredLog.slice(s.logPage * this.PAGE_SIZE, s.logPage * this.PAGE_SIZE + this.PAGE_SIZE)
        .map(l => { const w = codeToWorker[l.code] || {}; return { ...l, name: w.name || '—', dept: w.dept || '—', typeLabel: l.type === 'In' ? 'دخول' : 'خروج' }; }),
      logPageLabel: (s.logPage + 1) + ' / ' + Math.max(1, Math.ceil(filteredLog.length / this.PAGE_SIZE)),
      gotoLogPrev: () => this.gotoLogPage(-1), gotoLogNext: () => this.gotoLogPage(1),
      logSearch: s.logSearch, onLogSearch: (e) => this.onLogSearch(e),
      logDate: s.logDate || 'all',
      logDateOptions: (this.attendanceDates || []).slice().reverse(),
      onLogDate: (e) => this.setState({ logDate: e.target.value, logPage: 0 }),
      logDept: s.logDept, onLogDept: (e) => this.onLogDept(e),
      logType: s.logType, onLogType: (e) => this.onLogType(e),
      deptOptions: this.allDepts(),
      logSector: s.logSector || 'all',
      logProject: s.logProject || 'all',
      logSectorOptions: this.nwSectorOpts(),
      logProjectOptions: s.screen === 'attendanceLog' ? this.projectOptsFor(s.logSector || 'all') : [],
      onLogSector: (e) => this.setState({ logSector: e.target.value, logProject: 'all', logPage: 0 }),
      onLogProject: (e) => this.setState({ logProject: e.target.value, logPage: 0 }),

      permRows: this.permDefs.map(p => ({
        label: p.label,
        adminOn: this.permOn('إدارة عليا', p.key),
        supOn: this.permOn('إشراف', p.key),
        entryOn: this.permOn('إدخال بيانات', p.key),
        toggleAdmin: () => this.togglePerm('إدارة عليا', p.key),
        toggleSup: () => this.togglePerm('إشراف', p.key),
        toggleEntry: () => this.togglePerm('إدخال بيانات', p.key),
      })),

      enrollFp: () => this.setNw('fp', !s.nw.fp),
      fpDisabled: !this.permOn(s.roleView || 'إدارة عليا', 'fp'),
      fpButtonLabel: s.nw.fp ? 'إلغاء تعريف البصمة' : 'تعريف البصمة على الجهاز',
      fpTagClass: s.nw.fp ? 'tag-accent' : 'tag-neutral',
      fpTagLabel: s.nw.fp ? 'البصمة مُعرّفة — يُحتسب حضوره بالبصمة' : 'البصمة غير مُعرّفة',
      fpPermNote: this.permOn(s.roleView || 'إدارة عليا', 'fp')
        ? 'الدور الحالى: ' + (s.roleView || 'إدارة عليا') + ' — مسموح له بإضافة عامل وتعريف بصمته'
        : 'الدور الحالى: ' + (s.roleView || '—') + ' — تعريف البصمة مغلق من مصفوفة الصلاحيات',

      shSector: s.shSector || '10101',
      shHead: this.shValue(),
      shSectorOptions: this.sectorDefs.map(x => ({ code: x.code, name: x.code + ' — ' + x.name })),
      onShSector: (e) => this.setState({ shSector: e.target.value, shHeadDraft: null }),
      onShHead: (e) => this.setState({ shHeadDraft: e.target.value }),
      saveSectorHead: () => this.saveSectorHead(),
      addSectorHead: () => this.addSectorHeadName(),
      clearSectorHeads: () => this.clearSectorHeads(),
      anSectorHead: (s.anSector && s.anSector !== 'all')
        ? (this.headsOf(s.anSector).join('، ') || 'لم يُسجل بعد')
        : 'كل القطاعات',
      sectorHeadRows: this.sectorDefs.map(sec => {
        const heads = this.headsOf(sec.code);
        return {
          code: sec.code, name: sec.name,
          heads: heads.map((h, i) => ({ name: h, tagClass: i === 0 ? 'tag-accent' : 'tag-neutral', remove: () => this.removeSectorHead(sec.code, h) })),
          statusClass: heads.length ? 'tag-accent' : 'tag-outline',
          statusLabel: heads.length ? 'مسجّل' : 'بدون اسم',
        };
      }),

      swDate: s.swDate, onSwDate: (e) => this.setState({ swDate: e.target.value }),
      swDept: s.swDept, onSwDept: (e) => this.setState({ swDept: e.target.value }),
      swDeptOptions: this.allDepts(),
      swShift: s.swShift, onSwShift: (e) => this.setState({ swShift: e.target.value }),
      swIn: s.swIn, onSwIn: (e) => this.setState({ swIn: e.target.value }),
      swOut: s.swOut, onSwOut: (e) => this.setState({ swOut: e.target.value }),
      swHours: this.swHoursCalc().label,
      swCount: s.swCount, onSwCount: (e) => this.setState({ swCount: e.target.value }),
      swSector: s.swSector, onSwSector: (e) => this.setState({ swSector: e.target.value, swProject: '', swRegion: '' }),
      swSectorOptions: this.sectorDefs.map(x => ({ code: x.code, name: x.code + ' — ' + x.name })),
      swProject: s.swProject, onSwProject: (e) => this.setState({ swProject: e.target.value }),
      swProjectOptions: s.screen === 'sarakWork'
        ? this.projectsData.filter(p => this.sectorOfProject(p.code).sectorCode === s.swSector).map(p => ({ code: p.code, name: p.code + ' — ' + p.name }))
        : [],
      swDetails: s.swDetails, onSwDetails: (e) => this.setState({ swDetails: e.target.value }),
      swRegion: s.swRegion, onSwRegion: (e) => this.setState({ swRegion: e.target.value }),
      swRegionOptions: this.regionOptions(s.swSector),
      addSarakWork: () => this.addSarakWork(),
      swSaveDisabled: !s.swDetails.trim() || !s.swProject || !this.permOn(s.roleView || 'إدارة عليا', 'sarakWork'),
      swNote: !s.swProject ? 'اختر القطاع والمشروع ثم اكتب تفاصيل العمل والإدارة التابع لها'
        : 'نوع العمل يُسجل تحت إدارة: ' + s.swDept,
      swCountLabel: this.state.sarakWorks.length + ' بيان عمل',
      sarakWorkRows: s.sarakWorks.map((r, i) => ({ ...r, remove: () => this.deleteSarakWork(i) })),
      sarakWorkerOptions: (() => {
        if (!this._enrolledWorkers) {
          const set = new Set(this.attendanceLogData.map(l => l.code));
          const punched = this.workers.filter(w => set.has(w.code)).slice(0, 200);
          this._enrolledWorkers = punched.length ? punched : this.workers.slice(0, 60);
        }
        return this._enrolledWorkers;
      })(),

      selectWorker: (code) => this.selectWorker(code),
      clearWorker: () => this.clearWorker(),
      hasSelectedWorker: !!s.selectedWorkerCode,
      selectedWorker: (() => {
        if (!s.selectedWorkerCode) return null;
        const w = codeToWorker[s.selectedWorkerCode];
        if (!w) return null;
        return {
          ...w,
          logs: this.attendanceLogData.filter(l => l.code === w.code).slice(0, 12).map(l => ({ ...l, typeLabel: l.type === 'In' ? 'دخول' : 'خروج' })),
          sarak: this.sarakRecords.filter(r => r.workerCode === w.code),
        };
      })(),

      sarakRecords: this.sarakRecords,
      sarakPage: [...this.sarakRecords, ...s.addedSaraks].map(r => {
        const adj = (s.sarakAdj || {})[r.code] || {};
        return { ...r, shiftName: this.shiftName(r.shift),
          ot: adj.ot != null ? adj.ot : (r.ot || '0'),
          ded: adj.ded != null ? adj.ded : (r.ded || '0'),
          note: adj.note != null ? adj.note : (r.note || ''),
          onOt: (e) => this.setSarakAdj(r.code, 'ot', e.target.value),
          onDed: (e) => this.setSarakAdj(r.code, 'ded', e.target.value),
          onNote: (e) => this.setSarakAdj(r.code, 'note', e.target.value),
        };
      }),
      newSarakRegion: s.newSarakRegion, onNewSarakRegion: (e) => this.setState({ newSarakRegion: e.target.value }),
      sarakRegionOptions: this.regionOptions('all'),
      newSarakOt: s.newSarakOt, onNewSarakOt: (e) => this.setState({ newSarakOt: e.target.value }),
      newSarakDed: s.newSarakDed, onNewSarakDed: (e) => this.setState({ newSarakDed: e.target.value }),
      newSarakNote: s.newSarakNote, onNewSarakNote: (e) => this.setState({ newSarakNote: e.target.value }),
      newSarakWorker: s.newSarakWorker, onNewSarakWorker: (e) => this.setState({ newSarakWorker: e.target.value }),
      newSarakDate: s.newSarakDate,
      newSarakDateIso: this.toIso(s.newSarakDate),
      punchMinIso: this.toIso((this.attendanceDates || [])[0] || ''),
      punchMaxIso: this.toIso((this.attendanceDates || [])[(this.attendanceDates || []).length - 1] || ''),
      onNewSarakDate: (e) => this.setState({ newSarakDate: this.toDmy(e.target.value) }),
      newSarakWork: s.newSarakWork, onNewSarakWork: (e) => this.setState({ newSarakWork: e.target.value }),
      newSarakShift: s.newSarakShift, onNewSarakShift: (e) => this.setState({ newSarakShift: e.target.value }),
      addSarak: () => this.addSarak(),
      uploadedFiles: s.uploadedFiles,
      newUploadTarget: s.newUploadTarget, onNewUploadTarget: (e) => this.setState({ newUploadTarget: e.target.value }),
      onUploadFile: (e) => this.onUploadFile(e),
      addUpload: () => this.addUpload(),
      allAlerts: this.allAlertsData,
      topAlerts: this.allAlertsData.slice(0, 3),
      alertCount: this.allAlertsData.length,

      professionBars,
      bsc: dash.ov.enrolled ? {
        cost: dash.ov.presentMonthPct + '%', match: '0.4 يوم',
        commit: dash.ov.presentTodayPct + '%', adoption: Math.round((dash.ov.enrolled / Math.max(1, dash.ov.totalRegistered)) * 100) + '%',
      } : { cost: '—', match: '—', commit: '—', adoption: '—' },

      dashboardKpis: [
        { code: 'KPI-01', label: 'نسبة الحضور اليوم', value: dash.ov.presentTodayPct + '%', meta: dash.ov.presentToday + ' من ' + dash.ov.enrolledLabel + ' عامل على أجهزة البصمة', color: 'var(--color-accent-700)' },
        { code: 'KPI-02', label: 'نسبة المطابقة الآلية', value: (sarakCount ? Math.round((matchedCount / sarakCount) * 100) : 0) + '%', meta: matchedCount + ' من ' + sarakCount + ' سرك', color: 'var(--color-text)' },
        { code: 'KPI-03', label: 'ساعات إضافية (الشهر)', value: String(dash.ov.overtimeHours != null ? dash.ov.overtimeHours : 0), meta: 'ساعة إجمالي', color: 'var(--color-accent-2-700)' },
        { code: 'KPI-04', label: 'استثناءات مفتوحة', value: String(this.allAlertsData.length), meta: 'تحتاج مراجعة', color: 'var(--color-text)' },
      ].filter(k => !s.hiddenKpis.includes(k.code)).map(k => ({ ...k, deleteHandler: () => this.deleteKpi(k.code) })),
      reportKpis: [
        { code: 'KPI-11', label: 'تكلفة العمالة الفعلية', value: dash.ov.enrolled ? dash.ov.costLabel : '—', meta: dash.ov.periodLabel !== '—' ? 'جنيه — ' + dash.ov.monthLabel : 'لا توجد بيانات' },
        { code: 'KPI-12', label: 'دقة التسجيل', value: dash.ov.enrolled ? dash.ov.presentMonthPct + '%' : '—', meta: 'مؤشر SMART تشغيلي' },
        { code: 'KPI-13', label: 'التزام الحضور بالمقاولين', value: dash.ov.enrolled ? dash.ov.presentTodayPct + '%' : '—', meta: 'مؤشر مقاولون — BSC' },
      ].filter(k => !s.hiddenKpis.includes(k.code)).map(k => ({ ...k, deleteHandler: () => this.deleteKpi(k.code) })),
      hasHiddenKpis: s.hiddenKpis.length > 0,
      hiddenKpiCount: s.hiddenKpis.length,
      restoreKpis: () => this.restoreKpis(),

      kpis: {
        totalWorkers,
        presentCount,
        attendanceRate: totalWorkers ? Math.round((presentCount / totalWorkers) * 100) : 0,
        sarakCount,
        matchedCount,
        matchRate: sarakCount ? Math.round((matchedCount / sarakCount) * 100) : 0,
        overtimeHours: dash.ov.overtimeHours != null ? dash.ov.overtimeHours : 0,
      },

      users: s.users.map((u, i) => ({ ...u, deleteHandler: () => this.deleteUser(i) })),
      newUserName: s.newUserName,
      newUserRole: s.newUserRole,
      newUserProject: s.newUserProject,
      projects: this.projectsData,

      ...(s.screen === 'analytics' ? (() => {
        const st = this.sectorStats(s.anDept);
        const inSector = s.anSector !== 'all';
        const sites = st.sites.filter(x => !inSector || x.sectorCode === s.anSector);
        const fmt = (x) => ({ ...x,
          workersLabel: x.workers ? x.workers.toLocaleString('en-US') : '—',
          presentLabel: x.enrolled ? x.present.toLocaleString('en-US') : 'لا بصمة',
          pctLabel: x.enrolled ? Math.round((x.present / x.enrolled) * 100) + '%' : 'لا بصمة',
          pct: x.enrolled ? Math.round((x.present / x.enrolled) * 100) : 0,
          barColor: !x.enrolled ? 'var(--color-neutral-400)'
            : (x.present / x.enrolled) >= 0.8 ? 'var(--color-accent)'
            : (x.present / x.enrolled) >= 0.5 ? 'var(--color-accent-700)' : 'var(--color-accent-2-700)',
          rowBg: s.anSite === x.code ? 'var(--color-accent-100)' : 'transparent',
          refsLabel: x.refNames.length ? x.refNames.join(' · ') : 'لم يُربط بمشروع في القاعدة',
          refsColor: x.refNames.length ? 'var(--color-text)' : 'var(--color-neutral-500)',
          pickHandler: () => this.setState({ anSite: s.anSite === x.code ? 'all' : x.code }),
        });
        return {
          anDeptRows: this.deptStats().map(x => ({ ...x,
            rowBg: s.anDept === x.name ? 'var(--color-accent-100)' : 'transparent',
            pickHandler: () => this.setState({ anDept: s.anDept === x.name ? 'all' : x.name, anSector: 'all', anSite: 'all' }) })),
          anShowSectors: !inSector,
          anShowSites: inSector,
          secSectorRows: st.sectors.map(x => ({ ...x,
            pickHandler: () => this.setState({ anSector: x.code, anSite: 'all' }) })),
          secSiteRows: sites.map(fmt),
          secSiteCount: sites.length,
          secKpiSites: st.sites.length.toLocaleString('en-US'),
          secKpiLinked: st.linkedSites,
          secUnmappedCount: st.unmapped.length,
          secUnmappedWorkers: st.unmappedWorkers.toLocaleString('en-US'),
          siteOptions: [{ code: 'all', name: inSector ? 'كل مواقع القطاع' : 'كل المواقع' }]
            .concat(sites.map(x => ({ code: x.code, name: x.code + ' — ' + x.name }))),
        };
      })() : { anDeptRows: [], secSectorRows: [], secSiteRows: [], siteOptions: [] }),
      anDept: s.anDept,
      anDeptLabel: s.anDept === 'all' ? 'كل الإدارات' : s.anDept,
      anDeptOptions: [{ code: 'all', name: 'كل الإدارات' }].concat(this.allDepts().map(d => ({ code: d, name: d }))),
      onAnDept: (e) => this.setState({ anDept: e.target.value, anSector: 'all', anSite: 'all' }),
      sectorOptions: [{ code: 'all', name: 'كل القطاعات' }].concat(this.sectorDefs.map(x => ({ code: x.code, name: x.code + ' — ' + x.name }))),
      anSector: s.anSector,
      anSite: s.anSite,
      onAnSector: (e) => this.setState({ anSector: e.target.value, anSite: 'all' }),
      onAnSite: (e) => this.setState({ anSite: e.target.value }),
      resetAnScope: () => this.setState({ anDept: 'all', anSector: 'all', anSite: 'all' }),
      onNewUserName: (e) => this.setState({ newUserName: e.target.value }),
      onNewUserRole: (e) => this.setState({ newUserRole: e.target.value }),
      onNewUserProject: (e) => this.setState({ newUserProject: e.target.value }),
      addUser: () => this.addUser(),
      roleView: s.roleView,
      setRoleView: (r) => this.setRoleView(r),
      roleDescription: this.roleDescriptions[s.roleView],
      roleAdminClass: s.roleView === 'إدارة عليا' ? 'on' : '',
      roleSupClass: s.roleView === 'إشراف' ? 'on' : '',
      roleEntryClass: s.roleView === 'إدخال بيانات' ? 'on' : '',
    };
  }
}

</script>
</body>
</html>
