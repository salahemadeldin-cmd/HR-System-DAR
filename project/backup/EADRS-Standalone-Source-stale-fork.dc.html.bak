<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
<meta name="ext-resource-dependency" content="./data/eadrs-data.json" data-resource-id="eadrsData" />
<template id="__bundler_thumbnail" data-bg-color="#2B3080">
  <svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
    <rect width="1200" height="800" fill="#2B3080"/>
    <rect x="360" y="220" width="480" height="360" rx="28" fill="#ECEEF8"/>
    <rect x="410" y="290" width="380" height="34" rx="8" fill="#2B3080"/>
    <rect x="410" y="356" width="240" height="22" rx="6" fill="#D5D9EF"/>
    <rect x="410" y="404" width="300" height="22" rx="6" fill="#D5D9EF"/>
    <rect x="410" y="452" width="180" height="22" rx="6" fill="#D5D9EF"/>
    <circle cx="750" cy="486" r="46" fill="#22276B"/>
    <path d="M728 486l16 17 30-33" stroke="#ECEEF8" stroke-width="10" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</template>
</head>
<body>
<x-dc>

<helmet>
  <link rel="stylesheet" href="_ds/broadsheet-60b6b6f7-4da6-4861-a698-cdc2e96f33e5/styles.css">
  <script src="_ds/broadsheet-60b6b6f7-4da6-4861-a698-cdc2e96f33e5/_ds_bundle.js"></script>
  <style>
    html,body{margin:0}
    .app{--color-accent:#2B3080;--color-accent-700:#22276b;--color-accent-100:#eceef8;--color-accent-200:#d5d9ef;--color-accent-2-700:#8a2b2b;--color-text:#3A3A3C;direction:rtl;font-family:var(--font-body);background:var(--color-bg);color:var(--color-text);min-height:100vh;display:flex}
    .side{width:230px;flex:none;background:var(--color-surface);padding:var(--space-4) var(--space-3);display:flex;flex-direction:column;gap:var(--space-2);border-inline-start:1px solid var(--color-divider)}
    .side .brand{margin-bottom:var(--space-4)}
    .side .brand img{width:100%;max-width:150px;display:block;margin:0 auto var(--space-2)}
    .side .brand .sys{font-family:var(--font-heading);font-size:13px;font-weight:600;text-align:center;color:var(--color-accent);border-top:1px solid var(--color-divider);padding-top:8px}
    .navitem{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:var(--radius-md);cursor:pointer;font-size:14.5px;color:var(--color-neutral-800)}
    .navitem:hover{background:var(--color-accent-100)}
    .navitem.active{background:var(--color-accent-100);color:var(--color-accent-700);font-weight:600}
    .main{flex:1;padding:var(--space-6) var(--space-8);overflow:auto;max-height:100vh}
    .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:var(--space-4);margin-bottom:var(--space-6)}
    .kpi-num{font-family:var(--font-heading);font-size:34px;font-weight:600;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .kpi-grid .card{min-width:0;overflow-wrap:break-word;word-break:normal}
    .kpi-grid .card-meta{line-height:1.5}
    .toolbar{display:flex;gap:var(--space-3);align-items:center;margin-bottom:var(--space-4);flex-wrap:wrap}
    table.dt{width:100%;border-collapse:collapse;font-size:14px}
    table.dt th{text-align:right;padding:10px 12px;border-bottom:2px solid var(--color-accent);font-family:var(--font-heading);font-weight:600;font-size:13px;color:var(--color-accent-700)}
    table.dt td{padding:10px 12px;border-bottom:1px solid var(--color-neutral-300)}
    table.dt tr:hover td{background:var(--color-neutral-100)}
    .phone{width:340px;margin:0 auto;background:var(--color-text);border-radius:28px;padding:14px}
    .phone-screen{background:var(--color-bg);border-radius:18px;padding:var(--space-4);min-height:520px;display:flex;flex-direction:column;gap:var(--space-3)}
    .scan-target{aspect-ratio:1;border:3px dashed var(--color-accent);border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center;color:var(--color-accent-700);font-size:13px;background:var(--color-accent-100)}
    .alert-card{display:flex;gap:12px;align-items:flex-start;padding:var(--space-3) 0;border-bottom:1px solid var(--color-neutral-300)}
    .segwrap{display:inline-flex;border:1px solid var(--color-neutral-400);border-radius:var(--radius-md);overflow:hidden}
    .segwrap button{border:none;background:transparent;padding:8px 16px;font-family:var(--font-body);font-size:13px;cursor:pointer;color:var(--color-neutral-700)}
    .segwrap button.on{background:var(--color-accent);color:#fff}
    input.date-input{font-family:var(--font-body);text-align:left;position:relative;cursor:pointer}
    input.date-input::-webkit-calendar-picker-indicator{cursor:pointer;opacity:.75;filter:invert(31%) sepia(84%) saturate(1500%) hue-rotate(165deg)}
    input.date-input:hover::-webkit-calendar-picker-indicator{opacity:1}
    input.date-input:hover{border-color:var(--color-accent)}
    input.date-input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}
    .sheet{background:#fff;width:297mm;max-width:100%;box-sizing:border-box;padding:6mm;margin:0 auto;box-shadow:var(--shadow-md)}
    .sheet-head{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:2.5px solid var(--color-accent);padding-bottom:5px;margin-bottom:6px}
    .sheet-head img{height:36px;width:auto}
    table.sheet-tbl{width:100%;border-collapse:collapse;font-size:11px}
    table.sheet-tbl th{background:var(--color-accent);color:#fff;border:1px solid var(--color-accent-700);padding:5px 4px;font-weight:600;font-size:11px}
    table.sheet-tbl td{border:1px solid var(--color-accent-200);padding:4px;height:20px}
    table.sheet-tbl tbody tr:nth-child(even) td{background:#f7f8fc}
    table.sheet-tbl tr.sheet-total td{background:var(--color-accent-100);font-weight:700;color:var(--color-accent-700)}
    .sheet-sign{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:10px;padding-top:6px;border-top:1px solid var(--color-accent-200)}
    .sheet + .sheet{margin-top:24px}
    table.sheet-tbl.tight{font-size:9.5px}
    table.sheet-tbl.tight th{padding:4px 2px;font-size:9.5px}
    table.sheet-tbl.tight td{padding:2px;height:18px}
    table.sheet-tbl td.work-cell{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:0;font-size:9px}
    table.sheet-tbl td.clip{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:0}
    table.sheet-tbl.tight td{line-height:1.2}
    .wbar{display:flex;flex-wrap:wrap;gap:2px 14px;font-size:10.5px;margin-bottom:5px;padding:3px 6px;background:var(--color-accent-100);border:1px solid var(--color-accent-200)}
    .sheet-p{background:#fff;width:210mm;max-width:100%;box-sizing:border-box;padding:10mm;margin:0 auto var(--space-6);box-shadow:var(--shadow-md);page:a4p}
    @page a4p{size:A4 portrait;margin:10mm}
    table.sheet-tbl td.sig-cell{height:34px}
    @media print{
      @page{size:A4 landscape;margin:6mm}
      html,body{background:#fff}
      .app{display:block;min-height:0}
      .side,.no-print{display:none !important}
      .main{padding:0;max-height:none;overflow:visible}
      .sheet{box-shadow:none;width:auto;padding:0;margin:0;page-break-after:always;break-after:page}
      .sheet:last-of-type{page-break-after:auto;break-after:auto}
      .sheet + .sheet{margin-top:0}
      .sheet-p{box-shadow:none;width:auto;max-width:none;padding:0;margin:0;page-break-after:always;break-after:page}
      .sheet-p:last-of-type{page-break-after:auto;break-after:auto}
      table.sheet-tbl,table.sheet-tbl tbody,table.sheet-tbl thead{break-inside:auto !important;page-break-inside:auto !important}
      table.sheet-tbl tr{break-inside:avoid !important;page-break-inside:avoid !important}
      table.sheet-tbl tr.sheet-total{break-inside:avoid !important}
    }
  </style>
</helmet>
<div class="app">

  <nav class="side">
    <div class="brand">
      <img src="brand-logo.png" alt="الشروق للمقاولات العمومية والتوريدات"/>
      <div class="sys">نظام العمالة غير المنتظمة — شركة الشروق للمقاولات</div>
    </div>
    <div class="navitem {{ dashboardActive }}" onClick="{{ nav.dashboard }}">🏠︀ لوحة التحكم</div>
    <div class="navitem {{ analyticsActive }}" onClick="{{ nav.analytics }}">📊︀ تحليل الحضور والتنبّؤ</div>
    <div class="navitem {{ workersActive }}" onClick="{{ nav.workers }}">👥︀ العمال</div>
    <div class="navitem {{ contractorsActive }}" onClick="{{ nav.contractors }}">🏗︀ المقاولون</div>
    <div class="navitem {{ professionsActive }}" onClick="{{ nav.professions }}">🛠︀ المهن وفئات الأجر</div>
    <div class="navitem {{ allowancesActive }}" onClick="{{ nav.allowances }}">💰︀ البدلات والمشروعات</div>
    <div class="navitem {{ transfersActive }}" onClick="{{ nav.transfers }}">🔁︀ نقل الموظفين والتاريخ الوظيفي</div>
    <div class="navitem {{ shiftsActive }}" onClick="{{ nav.shifts }}">🕒︀ الورديات</div>
    <div class="navitem {{ scanActive }}" onClick="{{ nav.scan }}">📷︀ تسجيل الحضور (QR)</div>
    <div class="navitem {{ attendanceLogActive }}" onClick="{{ nav.attendanceLog }}">🗓︀ سجل الحضور الكامل</div>
    <div class="navitem {{ sarakActive }}" onClick="{{ nav.sarak }}">📋︀ السراكي والمطابقة</div>
    <div class="navitem {{ sarakWorkActive }}" onClick="{{ nav.sarakWork }}">🧰︀ اضافة بيانات عمل سركي</div>
    <div class="navitem {{ sarakPrintActive }}" onClick="{{ nav.sarakPrint }}">🖨︀ طباعة مستخلص سركي</div>
    <div class="navitem {{ dayTotalsActive }}" onClick="{{ nav.dayTotals }}">🧾︀ تقرير إجمالي اليوميات</div>
    <div class="navitem {{ alertsActive }}" onClick="{{ nav.alerts }}">⚠︀ التنبيهات <span class="tag tag-accent-2" style="margin-inline-start:auto">{{ alertCount }}</span></div>
    <div class="navitem {{ projectSheetActive }}" onClick="{{ nav.projectSheet }}">🗂︀ نموذج بيانات المشروع</div>
    <div class="navitem {{ uploadActive }}" onClick="{{ nav.upload }}">⬆︀ رفع بيانات وملفات</div>
    <div class="navitem {{ reportsActive }}" onClick="{{ nav.reports }}">📈︀ التقارير</div>
    <div class="navitem {{ usersActive }}" onClick="{{ nav.users }}">🔐︀ المستخدمون والصلاحيات</div>
    <div style="margin-top:auto;font-size:12px;color:var(--color-neutral-600);padding:8px 12px">{{ scopeLabel }}</div>
  </nav>

  <main class="main">

    <sc-if value="{{ isDashboard }}" hint-placeholder-val="{{ true }}">
      <h1 style="font-size:26px;margin-bottom:2px">لوحة التحكم الرئيسية</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-5)">نظرة يومية على الحضور والمطابقة والاستحقاقات — {{ scopeLabel }}</p>
      <div class="kpi-grid">
        <sc-for list="{{ dashboardKpis }}" as="k" hint-placeholder-count="4">
          <div class="card elev-sm">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-2)">
              <div>
                <div class="card-kicker">{{ k.label }}</div>
                <div style="font-size:11px;color:var(--color-neutral-500);letter-spacing:.04em">{{ k.code }}</div>
              </div>
              <button class="btn btn-ghost" title="حذف المؤشر" style="padding:2px 8px;font-size:15px;line-height:1;color:var(--color-accent-2-700)" onClick="{{ k.deleteHandler }}">✕</button>
            </div>
            <div class="kpi-num" style="color:{{ k.color }}">{{ k.value }}</div>
            <div class="card-meta">{{ k.meta }}</div>
          </div>
        </sc-for>
      </div>
      <sc-if value="{{ hasHiddenKpis }}" hint-placeholder-val="{{ false }}">
        <div style="margin-bottom:var(--space-5);display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap">
          <span style="font-size:13px;color:var(--color-neutral-600)">مؤشرات محذوفة ({{ hiddenKpiCount }}) — محفوظة في النسخة الاحتياطية</span>
          <button class="btn btn-ghost" style="font-size:13px" onClick="{{ restoreKpis }}">استعادة الكل</button>
        </div>
      </sc-if>

      <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);align-items:baseline;justify-content:space-between;margin-bottom:var(--space-4);font-size:13px;color:var(--color-neutral-600)">
        <span>مصدر الحضور: {{ ov.logSource }}</span>
        <span>بصمات غير مرتبطة بملف عامل: {{ ov.unlinkedPunches }}</span>
      </div>

      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-4);margin-bottom:var(--space-6)">
        <div class="card elev-sm" style="border-top:3px solid var(--color-accent)">
          <div class="card-kicker">إجمالي عمال السراكي المسجلين</div>
          <div class="kpi-num" style="color:var(--color-accent-700)">{{ ov.totalRegistered }}</div>
          <div class="card-meta">في {{ ov.projectCount }} مشروع · {{ ov.contractorCount }} مقاول</div>
        </div>
        <div class="card elev-sm" style="border-top:3px solid var(--color-accent)">
          <div class="card-kicker">الحاضرون اليوم</div>
          <div class="kpi-num" style="color:var(--color-accent-700)">{{ ov.presentToday }}</div>
          <div class="card-meta">{{ ov.presentTodayPct }}% من {{ ov.enrolledLabel }} عامل على أجهزة البصمة · {{ ov.today }}</div>
        </div>
        <div class="card elev-sm" style="border-top:3px solid var(--color-accent)">
          <div class="card-kicker">الحاضرون هذا الشهر</div>
          <div class="kpi-num">{{ ov.presentMonth }}</div>
          <div class="card-meta">عامل مختلف سجّل حركة · {{ ov.monthLabel }}</div>
        </div>
        <div class="card elev-sm" style="border-top:3px solid var(--color-accent-2-700)">
          <div class="card-kicker">الغياب اليوم</div>
          <div class="kpi-num" style="color:var(--color-accent-2-700)">{{ ov.absentToday }}</div>
          <div class="card-meta">مسجل على البصمة ولم يسجل حركة دخول اليوم</div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:var(--space-5);margin-bottom:var(--space-6)">
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-3)">العمال والحضور بحسب المشروع</div>
          <table class="dt">
            <thead><tr><th>المشروع</th><th>المقاولون</th><th>مسجلون</th><th>حاضرون</th><th>نسبة الحضور</th></tr></thead>
            <tbody>
              <sc-for list="{{ projectRows }}" as="p" hint-placeholder-count="0">
                <tr>
                  <td><strong>{{ p.code }}</strong> — {{ p.name }}</td>
                  <td>{{ p.contractors }}</td>
                  <td>{{ p.registered }}</td>
                  <td>{{ p.present }}</td>
                  <td>
                    <div style="display:flex;align-items:center;gap:8px">
                      <div style="flex:1;min-width:60px;background:var(--color-neutral-200);border-radius:4px;height:8px;overflow:hidden">
                        <div style="height:100%;border-radius:4px;background:{{ p.barColor }};width:{{ p.pct }}%"></div>
                      </div>
                      <span style="font-size:13px;font-weight:600;color:{{ p.barColor }};white-space:nowrap">{{ p.pctLabel }}</span>
                    </div>
                  </td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </div>
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-3)">التوزيع الوظيفي للعمالة</div>
          <sc-for list="{{ roleRows }}" as="r" hint-placeholder-count="4">
            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--color-neutral-300)">
              <div>
                <div style="font-size:14px;font-weight:600">{{ r.label }}</div>
                <div style="font-size:12px;color:var(--color-neutral-600)">{{ r.hint }}</div>
              </div>
              <div style="text-align:left">
                <div style="font-family:var(--font-heading);font-size:24px;font-weight:600;color:var(--color-accent-700)">{{ r.count }}</div>
                <div style="font-size:12px;color:var(--color-neutral-600)">{{ r.pct }}% · حاضر {{ r.present }}</div>
              </div>
            </div>
          </sc-for>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:var(--space-5)">
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-3)">الحضور بحسب المهنة</div>
          <sc-for list="{{ professionBars }}" as="p" hint-placeholder-count="5">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
              <div style="width:120px;font-size:13px">{{ p.name }}</div>
              <div style="flex:1;background:var(--color-neutral-200);border-radius:4px;height:10px;overflow:hidden">
                <div style="height:100%;background:var(--color-accent);border-radius:4px;width:{{ p.pct }}%"></div>
              </div>
              <div style="width:32px;font-size:12px;color:var(--color-neutral-600);text-align:left">{{ p.count }}</div>
            </div>
          </sc-for>
        </div>
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-2)">أحدث التنبيهات</div>
          <sc-for list="{{ topAlerts }}" as="a" hint-placeholder-count="3">
            <div class="alert-card">
              <span class="tag {{ a.tagClass }}">{{ a.level }}</span>
              <div>
                <div style="font-size:14px">{{ a.text }}</div>
                <div style="font-size:12px;color:var(--color-neutral-600)">{{ a.time }}</div>
              </div>
            </div>
          </sc-for>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{ isWorkers }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">إدارة العمال والمقاولين</h1>
      <div class="toolbar" style="flex-wrap:wrap;align-items:flex-end">
        <span class="tag tag-neutral">{{ activeContractorCount }} عامل</span>
        <div class="field" style="margin:0 0 0 auto;min-width:180px">
          <label>القطاع</label>
          <select class="input" value="{{ wfSector }}" onChange="{{ onWfSector }}">
            <sc-for list="{{ wfSectorOptions }}" as="so" hint-placeholder-count="8">
              <option value="{{ so.code }}">{{ so.name }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="margin:0;min-width:220px">
          <label>المشروع</label>
          <select class="input" value="{{ wfProject }}" onChange="{{ onWfProject }}">
            <sc-for list="{{ wfProjectOptions }}" as="po" hint-placeholder-count="6">
              <option value="{{ po.code }}">{{ po.name }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="margin:0;min-width:220px">
          <label>المقاول</label>
          <select class="input" value="{{ wfContractor }}" onChange="{{ onWfContractor }}">
            <sc-for list="{{ wfContractorOptions }}" as="co" hint-placeholder-count="5">
              <option value="{{ co.code }}">{{ co.name }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="margin:0;min-width:220px">
          <label>بحث</label>
          <input class="input" placeholder="بحث بالاسم أو الكود…" value="{{ workerSearch }}" onChange="{{ onSearchChange }}"/>
        </div>
        <button class="btn btn-primary" onClick="{{ toggleWorkerForm }}">{{ workerFormLabel }}</button>
      </div>
      <sc-if value="{{ showWorkerForm }}" hint-placeholder-val="{{ false }}">
        <div class="card elev-sm" style="margin-bottom:var(--space-4)">
          <div class="card-kicker">الخطوة الأولى</div>
          <div class="card-title" style="margin-bottom:var(--space-3)">تحديد المشروع والمقاول</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)">
            <div class="field"><label>القطاع الجغرافى</label>
              <select class="input" value="{{ nw.sector }}" onChange="{{ onNwSector }}">
                <sc-for list="{{ nwSectorOptions }}" as="so" hint-placeholder-count="8">
                  <option value="{{ so.code }}">{{ so.name }}</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>اسم المشروع / الموقع</label>
              <select class="input" value="{{ nw.project }}" onChange="{{ onNwProject }}">
                <option value="">اختر المشروع</option>
                <sc-for list="{{ nwProjectOptions }}" as="po" hint-placeholder-count="6">
                  <option value="{{ po.code }}">{{ po.name }}</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>كود المشروع</label><input class="input" value="{{ nwProjectCode }}" readOnly="{{ true }}" dir="ltr" style="background:var(--color-neutral-100);font-family:var(--font-heading);font-size:18px"/></div>
            <div class="field"><label>اسم المقاول التابع له</label>
              <select class="input" value="{{ nw.contractor }}" onChange="{{ onNwContractor }}" disabled="{{ nwContractorDisabled }}">
                <option value="">{{ nwContractorPlaceholder }}</option>
                <sc-for list="{{ nwContractorOptions }}" as="c" hint-placeholder-count="3">
                  <option value="{{ c.code }}">{{ c.name }}</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>كود المقاول فى هذا المشروع</label><input class="input" value="{{ nwContractorCode }}" readOnly="{{ true }}" dir="ltr" style="background:var(--color-neutral-100);font-family:var(--font-heading);font-size:18px"/></div>
            <div class="field"><label>كود العامل (تلقائى)</label><input class="input" value="{{ nwAutoCode }}" readOnly="{{ true }}" dir="ltr" style="background:var(--color-neutral-100);font-family:var(--font-heading);font-size:18px;font-weight:600"/></div>
            <div class="field" style="grid-column:span 3"><span style="font-size:13px;color:var(--color-neutral-600)">{{ nwCodeNote }}</span></div>
          </div>
          <div class="card-kicker" style="margin-top:var(--space-4)">الخطوة الثانية</div>
          <div class="card-title" style="margin-bottom:var(--space-3)">بيانات العامل الجديد</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)">
            <div class="field"><label>اسم العامل</label><input class="input" placeholder="الاسم رباعي" value="{{ nw.name }}" onChange="{{ onNwName }}"/></div>
            <div class="field"><label>المهنة</label>
              <select class="input" value="{{ nw.profession }}" onChange="{{ onNwProfession }}">
                <option value="">اختر مهنة</option>
                <sc-for list="{{ availableProfessionTitles }}" as="t" hint-placeholder-count="5">
                  <option value="{{ t }}">{{ t }}</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>الرقم القومي / رقم البطاقة *</label>
              <input class="input" dir="ltr" placeholder="14 رقماً" value="{{ nw.card }}" onChange="{{ onNwCard }}"/>
              <span style="font-size:12px;color:var(--color-neutral-600)">{{ nwCardNote }}</span>
            </div>
            <div class="field"><label>تاريخ الميلاد (تلقائي من الرقم القومي)</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ nwBirthDateAuto }}" onChange="{{ onNwBirthDate }}"/></div>
            <div class="field"><label>السن (تلقائي)</label><input class="input" value="{{ nwAge }}" readOnly="{{ true }}" style="background:var(--color-neutral-100)"/></div>
            <div class="field"><label>محل الميلاد (تلقائي من الرقم القومي)</label><input class="input" placeholder="المحافظة" value="{{ nwBirthPlaceAuto }}" onChange="{{ onNwBirthPlace }}"/></div>
            <div class="field"><label>بدل المنطقة (جنيه/يوم)</label><input class="input" placeholder="0" value="{{ nw.allowance }}" onChange="{{ onNwAllowance }}"/></div>
            <div class="field"><label>الفئة</label>
              <select class="input" value="{{ nw.category }}" onChange="{{ onNwCategory }}">
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="D">D</option>
                <option value="E">E</option>
              </select>
            </div>
            <div class="field"><label>قيمة الفئة (جنيه/اليومية) — تُدخل يدويًا</label><input class="input" placeholder="مثال: 176" value="{{ nw.rate }}" onChange="{{ onNwRate }}"/></div>
            <div class="field"><label>ساعات العمل اليومية</label>
              <select class="input" value="{{ nw.hours }}" onChange="{{ onNwHours }}">
                <sc-for list="{{ hourOptions }}" as="h" hint-placeholder-count="7">
                  <option value="{{ h }}">{{ h }} ساعات</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>أجر الساعة المحتسب (قيمة الفئة ÷ ساعات العمل)</label><input class="input" value="{{ nwHourly }}" readOnly="{{ true }}" style="background:var(--color-neutral-100)"/></div>
            <div class="field"><label>حالة العامل</label>
              <select class="input" value="{{ nw.status }}" onChange="{{ onNwStatus }}">
                <option value="نشط">نشط</option>
                <option value="غير نشط">غير نشط (مغادرة)</option>
              </select>
            </div>
            <div class="field"><label>تاريخ التسجيل</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ nwRegDateIso }}" onChange="{{ onNwRegDate }}"/></div>
            <div class="field"><label>تاريخ أول يوم عمل</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ nwStartDateIso }}" onChange="{{ onNwStartDate }}"/></div>
          </div>
          <sc-if value="{{ nwDupFound }}" hint-placeholder-val="{{ false }}">
            <div class="card" style="margin-top:var(--space-3);border-top:3px solid var(--color-accent-2-700);background:var(--color-accent-2-100)">
              <div class="card-kicker" style="color:var(--color-accent-2-700)">⚠ الرقم القومي مسجّل مسبقاً</div>
              <div style="font-family:var(--font-heading);font-size:17px;margin:4px 0">{{ nwDup.name }} — كود {{ nwDup.code }}</div>
              <div style="font-size:13px;color:var(--color-neutral-700);line-height:1.9">
                المهنة: {{ nwDup.profession }} · الفئة: {{ nwDup.category }} · الإدارة: {{ nwDup.dept }}<br/>
                المشروع: {{ nwDup.project }} · المقاول: {{ nwDup.contractor }} · الحالة: {{ nwDup.status }}
              </div>
              <div style="display:flex;gap:var(--space-3);margin-top:var(--space-3)">
                <button class="btn btn-secondary" onClick="{{ nwDupOpen }}">فتح ملف العامل الحالي</button>
                <button class="btn btn-ghost" onClick="{{ nwDupClear }}">تصحيح الرقم القومي</button>
              </div>
            </div>
          </sc-if>
          <div class="card-kicker" style="margin-top:var(--space-4)">الخطوة الثالثة</div>
          <div class="card-title" style="margin-bottom:var(--space-2)">تعريف البصمة — لأخذ الحضور بعد ذلك بالبصمة</div>
          <div style="display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap">
            <button class="btn btn-secondary" onClick="{{ enrollFp }}" disabled="{{ fpDisabled }}">{{ fpButtonLabel }}</button>
            <span class="tag {{ fpTagClass }}">{{ fpTagLabel }}</span>
            <span style="font-size:13px;color:var(--color-neutral-600)">{{ fpPermNote }}</span>
          </div>
          <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)">
            <button class="btn btn-primary" onClick="{{ addWorker }}" disabled="{{ nwSaveDisabled }}">حفظ العامل</button>
            <span style="font-size:13px;color:var(--color-neutral-600)">اسم المقاول: {{ nwContractorName }} · القطاع: {{ nwSectorLabel }}</span>
          </div>
        </div>
      </sc-if>
      <sc-if value="{{ isEditingWorker }}" hint-placeholder-val="{{ false }}">
        <div class="card elev-md" style="margin-bottom:var(--space-4);border-top:3px solid var(--color-accent)">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-3)">
            <div>
              <div class="card-kicker">تعديل بيانات موظف</div>
              <div class="card-title">{{ ew.name }}</div>
            </div>
            <button class="btn btn-ghost" onClick="{{ closeEditWorker }}">إغلاق ✕</button>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)">
            <div class="field"><label>كود الموظف (غير قابل للتعديل)</label>
              <input class="input" value="{{ ew.code }}" readOnly="{{ true }}" dir="ltr" style="background:var(--color-neutral-200);font-family:var(--font-heading);font-size:18px;font-weight:600;cursor:not-allowed"/>
              <span style="font-size:12px;color:var(--color-neutral-600)">🔒 الكود ثابت مدى الحياة الوظيفية ولا يُعاد استخدامه</span>
            </div>
            <div class="field"><label>اسم الموظف</label><input class="input" value="{{ ew.name }}" onChange="{{ onEw.name }}"/></div>
            <div class="field"><label>الرقم القومي</label><input class="input" dir="ltr" value="{{ ew.card }}" onChange="{{ onEw.card }}"/></div>
            <div class="field"><label>تاريخ الميلاد (تلقائي من الرقم القومي)</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ ewBirthDateAuto }}" onChange="{{ onEw.birthDate }}"/></div>
            <div class="field"><label>السن (تلقائي)</label><input class="input" value="{{ ewAge }}" readOnly="{{ true }}" style="background:var(--color-neutral-100)"/></div>
            <div class="field"><label>محل الميلاد (تلقائي)</label><input class="input" value="{{ ewBirthPlaceAuto }}" onChange="{{ onEw.birthPlace }}"/></div>
            <div class="field"><label>المهنة</label>
              <select class="input" value="{{ ew.profession }}" onChange="{{ onEw.profession }}">
                <sc-for list="{{ availableProfessionTitles }}" as="t" hint-placeholder-count="5">
                  <option value="{{ t }}">{{ t }}</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>الإدارة / القسم</label>
              <select class="input" value="{{ ew.dept }}" onChange="{{ onEw.dept }}">
                <sc-for list="{{ deptOptions }}" as="d" hint-placeholder-count="6">
                  <option value="{{ d }}">{{ d }}</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>الفئة</label>
              <select class="input" value="{{ ew.category }}" onChange="{{ onEw.category }}">
                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option>
              </select>
            </div>
            <div class="field"><label>قيمة الفئة (يومية)</label><input class="input" dir="ltr" value="{{ ew.rate }}" onChange="{{ onEw.rate }}"/></div>
            <div class="field"><label>بدل المنطقة</label><input class="input" dir="ltr" value="{{ ew.allowance }}" onChange="{{ onEw.allowance }}"/></div>
            <div class="field"><label>بدل السكن</label><input class="input" dir="ltr" value="{{ ew.housing }}" onChange="{{ onEw.housing }}"/></div>
            <div class="field"><label>بدل الانتقال</label><input class="input" dir="ltr" value="{{ ew.transport }}" onChange="{{ onEw.transport }}"/></div>
            <div class="field"><label>ساعات العمل اليومية</label>
              <select class="input" value="{{ ew.hours }}" onChange="{{ onEw.hours }}">
                <sc-for list="{{ hourOptions }}" as="h" hint-placeholder-count="7">
                  <option value="{{ h }}">{{ h }} ساعات</option>
                </sc-for>
              </select>
            </div>
            <div class="field"><label>الحالة</label>
              <select class="input" value="{{ ew.status }}" onChange="{{ onEw.status }}">
                <option value="نشط">نشط</option><option value="غير نشط">غير نشط</option>
              </select>
            </div>
            <div class="field"><label>تاريخ التسجيل</label><input class="input" value="{{ ew.regDate }}" onChange="{{ onEw.regDate }}"/></div>
          </div>
          <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-4)">
            <button class="btn btn-primary" onClick="{{ saveEditWorker }}">حفظ التعديلات</button>
            <button class="btn btn-ghost" onClick="{{ closeEditWorker }}">إلغاء</button>
            <span style="font-size:13px;color:var(--color-neutral-600)">{{ ewNote }}</span>
          </div>
        </div>
      </sc-if>
      <sc-if value="{{ hasDirty }}" hint-placeholder-val="{{ false }}">
        <div class="card elev-md" style="position:sticky;top:0;z-index:5;margin-bottom:var(--space-3);border-top:3px solid var(--color-accent-2-700);display:flex;flex-wrap:wrap;gap:var(--space-3);align-items:center">
          <div>
            <div class="card-kicker">تعديلات غير محفوظة</div>
            <div style="font-family:var(--font-heading);font-size:18px">{{ dirtyCount }} عامل بانتظار الحفظ</div>
          </div>
          <div style="margin-inline-start:auto;display:flex;gap:var(--space-3);align-items:center">
            <span style="font-size:12px;color:var(--color-neutral-600)">{{ lastSavedLabel }}</span>
            <button class="btn btn-ghost" onClick="{{ revertAllWorkers }}">تراجع عن الكل</button>
            <button class="btn btn-primary" onClick="{{ saveAllWorkers }}">حفظ كل التعديلات</button>
          </div>
        </div>
      </sc-if>
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);align-items:center;justify-content:space-between;margin:var(--space-3) 0;font-size:13px;color:var(--color-neutral-600)">
        <span>{{ workerViewNote }} · {{ lastSavedLabel }}</span>
        <span>القاعدة الفعلية: {{ dsSelf }} عامل ذاتى · {{ dsSub }} عامل مقاولين · {{ dsContractors }} مقاول · {{ dsProjects }} مشروع</span>
      </div>
      <table class="dt">
        <thead><tr><th>كود العامل</th><th>الاسم</th><th>المهنة</th><th>الرقم القومي</th><th>تاريخ الميلاد</th><th>السن</th><th>محل الميلاد</th><th>بدل المنطقة</th><th>الفئة</th><th>قيمة الفئة</th><th>ساعات العمل</th><th>أجر الساعة</th><th>الحالة</th><th>تاريخ المغادرة</th><th>المشروع / الموقع</th><th>القطاع الجغرافى</th><th>تاريخ التسجيل</th><th>أول يوم عمل</th><th>كود المقاول</th><th>اسم المقاول</th><th></th></tr></thead>
        <tbody>
          <sc-for list="{{ filteredWorkers }}" as="w" hint-placeholder-count="6">
            <tr style="background:{{ w.rowBg }}">
              <td>{{ w.code }}</td>
              <td style="cursor:pointer" onClick="{{ w.selectHandler }}">{{ w.name }}</td>
              <td>{{ w.profession }}</td>
              <td dir="ltr" style="text-align:right">{{ w.card }}</td>
              <td dir="ltr" style="text-align:right;font-size:12px">{{ w.birthDate }}</td>
              <td style="text-align:center">{{ w.age }}</td>
              <td style="font-size:12px">{{ w.birthPlace }}</td>
              <td><input class="input" style="padding:2px 6px;font-size:13px;width:72px" value="{{ w.allowanceValue }}" onChange="{{ w.allowanceHandler }}"/></td>
              <td>
                <select class="input" style="padding:2px 6px;font-size:13px;min-width:64px" value="{{ w.category }}" onChange="{{ w.categoryHandler }}">
                  <option value="A">A</option>
                  <option value="B">B</option>
                  <option value="C">C</option>
                  <option value="D">D</option>
                  <option value="E">E</option>
                </select>
              </td>
              <td><input class="input" style="padding:2px 6px;font-size:13px;width:72px" value="{{ w.rateValue }}" onChange="{{ w.rateHandler }}"/></td>
              <td>
                <select class="input" style="padding:2px 6px;font-size:13px;min-width:72px" value="{{ w.hoursValue }}" onChange="{{ w.hoursHandler }}">
                  <sc-for list="{{ hourOptions }}" as="h" hint-placeholder-count="7">
                    <option value="{{ h }}">{{ h }}</option>
                  </sc-for>
                </select>
              </td>
              <td style="font-family:var(--font-heading);color:var(--color-accent-700)">{{ w.hourlyValue }}</td>
              <td>
                <select class="input" style="padding:2px 6px;font-size:13px;min-width:96px" value="{{ w.status }}" onChange="{{ w.statusHandler }}">
                  <option value="نشط">نشط</option>
                  <option value="غير نشط">غير نشط</option>
                </select>
              </td>
              <td style="font-size:12px;color:var(--color-neutral-600)">{{ w.leaveDate }}</td>
              <td style="font-size:12px">{{ w.projectLabel }}</td>
              <td style="font-size:12px">{{ w.sectorLabel }}</td>
              <td>{{ w.regDate }}</td>
              <td>{{ w.startDate }}</td>
              <td>{{ w.contractor }}</td>
              <td>{{ w.contractorName }}</td>
              <td>
                <div style="display:flex;gap:6px;align-items:center">
                  <sc-if value="{{ w.dirty }}" hint-placeholder-val="{{ false }}">
                    <button class="btn btn-primary" style="padding:3px 10px;font-size:12px" title="حفظ تعديلات هذا العامل" onClick="{{ w.saveHandler }}">حفظ</button>
                    <button class="btn btn-ghost" style="padding:3px 8px;font-size:12px" title="تراجع" onClick="{{ w.revertHandler }}">↺</button>
                  </sc-if>
                  <button class="btn btn-ghost" title="تعديل كل بيانات العامل" style="padding:3px 8px;font-size:12px" onClick="{{ w.editHandler }}">✎ تعديل</button>
                  <button class="btn btn-ghost" title="حذف العامل" style="padding:2px 8px;color:var(--color-accent-2-700)" onClick="{{ w.deleteHandler }}">✕</button>
                </div>
              </td>
            </tr>
          </sc-for>
        </tbody>
      </table>
      <div style="display:flex;justify-content:center;align-items:center;gap:var(--space-3);margin-top:var(--space-3)">
        <button class="btn btn-ghost btn-icon" title="الصفحة الأولى" onClick="{{ gotoWorkerFirst }}">⏮</button>
        <button class="btn btn-ghost btn-icon" onClick="{{ gotoWorkerPrev }}">◄</button>
        <span style="font-size:13px;color:var(--color-neutral-600)">صفحة {{ workerPageLabel }}</span>
        <button class="btn btn-ghost btn-icon" onClick="{{ gotoWorkerNext }}">►</button>
        <button class="btn btn-ghost btn-icon" title="الصفحة الأخيرة" onClick="{{ gotoWorkerLast }}">⏭</button>
      </div>
      <sc-if value="{{ hasSelectedWorker }}" hint-placeholder-val="{{ false }}">
        <div class="card elev-md" style="margin-top:var(--space-4)">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div class="card-title">ملف العامل: {{ selectedWorker.name }} ({{ selectedWorker.code }})</div>
            <button class="btn btn-ghost" onClick="{{ clearWorker }}">إغلاق ✕</button>
          </div>
          <p style="font-size:13px;color:var(--color-neutral-600)">المهنة: {{ selectedWorker.profession }} — رقم البطاقة: {{ selectedWorker.card }}</p>
          <div style="font-size:13px;font-weight:600;margin:var(--space-2) 0">آخر حركات الحضور</div>
          <table class="dt">
            <thead><tr><th>التاريخ</th><th>الوقت</th><th>النوع</th></tr></thead>
            <tbody>
              <sc-for list="{{ selectedWorker.logs }}" as="l" hint-placeholder-count="2">
                <tr><td>{{ l.date }}</td><td>{{ l.time }}</td><td><span class="tag {{ l.type === 'In' ? 'tag-accent' : 'tag-accent-2' }}">{{ l.typeLabel }}</span></td></tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </sc-if>
    </sc-if>

    <sc-if value="{{ isContractors }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">إضافة/عرض عمال المقاول</h1>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-3)">إضافة مقاول جديد</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3);align-items:end">
          <div class="field"><label>المشروع الذى يعمل به</label>
            <select class="input" value="{{ newContractorProject }}" onChange="{{ onNewContractorProject }}">
              <option value="">اختر المشروع</option>
              <sc-for list="{{ projects }}" as="p" hint-placeholder-count="6">
                <option value="{{ p.code }}">{{ p.code }} — {{ p.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>اسم المقاول — من المقاولين المسجلين</label>
            <select class="input" value="{{ newContractorNamePick }}" onChange="{{ onNewContractorNamePick }}">
              <option value="">— مقاول جديد —</option>
              <sc-for list="{{ contractorNameOptions }}" as="n" hint-placeholder-count="4">
                <option value="{{ n.name }}">{{ n.label }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>أو اسم مقاول جديد</label><input class="input" placeholder="الاسم كما فى العقد" value="{{ newContractorName }}" onChange="{{ onNewContractorName }}" disabled="{{ newContractorNameLocked }}"/></div>
          <div class="field"><label>كود المقاول (تلقائى من كود المشروع)</label><input class="input" value="{{ newContractorAutoCode }}" readOnly="{{ true }}" dir="ltr" style="background:var(--color-neutral-100);font-family:var(--font-heading);font-size:18px"/></div>
          <div class="field">
            <label>نوع الأعمال</label>
            <select class="input" value="{{ newContractorType }}" onChange="{{ onNewContractorType }}">
              <option value="عمالة ذاتى">عمالة ذاتى</option>
              <option value="عمالة باطن">عمالة باطن</option>
            </select>
          </div>
          <div class="field"><label>تاريخ التسجيل</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ newContractorDateIso }}" onChange="{{ onNewContractorDate }}"/></div>
        </div>
        <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)">
          <button class="btn btn-primary" onClick="{{ addContractor }}" disabled="{{ newContractorSaveDisabled }}">+ إضافة المقاول</button>
          <span style="font-size:13px;color:var(--color-neutral-600)">{{ newContractorCodeNote }}</span>
        </div>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4);border-top:3px solid var(--color-accent)">
        <div class="card-kicker">أسماء بدون أكواد</div>
        <div class="card-title" style="margin-bottom:var(--space-1)">اسم المقاول · المشروع · القطاع</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">الاسم المتكرر بأكواد أو صيغ مختلفة يظهر مدمجًا فى سطر واحد وتُفصل صيغ الاسم بفاصلة «،»</div>
        <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;align-items:flex-end;margin-bottom:var(--space-3)">
          <div class="field" style="margin:0;min-width:240px">
            <label>القطاع الجغرافى</label>
            <select class="input" value="{{ cnSector }}" onChange="{{ onCnSector }}">
              <sc-for list="{{ cnSectorOptions }}" as="so" hint-placeholder-count="8">
                <option value="{{ so.code }}">{{ so.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="margin:0;min-width:260px">
            <label>المشروع</label>
            <select class="input" value="{{ cnProject }}" onChange="{{ onCnProject }}">
              <sc-for list="{{ cnProjectOptions }}" as="po" hint-placeholder-count="6">
                <option value="{{ po.code }}">{{ po.name }}</option>
              </sc-for>
            </select>
          </div>
          <span class="tag tag-neutral">{{ cnCount }} اسم مقاول</span>
          <span class="tag tag-accent-2">{{ cnMergedCount }} مدمج</span>
        </div>
        <table class="dt">
          <thead><tr><th>اسم المقاول</th><th>المشروع</th><th>القطاع الجغرافى</th><th>الحالة</th><th>العمال</th></tr></thead>
          <tbody>
            <sc-for list="{{ cnRows }}" as="r" hint-placeholder-count="6">
              <tr>
                <td style="font-weight:600">{{ r.names }}</td>
                <td>{{ r.projectName }}</td>
                <td>{{ r.sectorName }}</td>
                <td><span class="tag {{ r.mergeClass }}">{{ r.mergeLabel }}</span></td>
                <td>{{ r.workers }}</td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-5)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-3)">
          <div style="display:flex;gap:var(--space-3);align-items:center;flex:1">
            <span style="font-size:13px;color:var(--color-neutral-600);white-space:nowrap">سجل {{ contractorPos }}</span>
            <select class="input" style="max-width:420px" value="{{ contractorPickValue }}" onChange="{{ onPickContractor }}">
              <sc-for list="{{ contractorOptions }}" as="o" hint-placeholder-count="4">
                <option value="{{ o.i }}">{{ o.label }}</option>
              </sc-for>
            </select>
          </div>
          <div style="display:flex;gap:6px">
            <button class="btn btn-ghost btn-icon" onClick="{{ gotoContractorPrev }}">◄</button>
            <button class="btn btn-ghost btn-icon" onClick="{{ gotoContractorNext }}">►</button>
            <button class="btn btn-secondary" disabled="{{ !canDeleteContractor }}" onClick="{{ deleteContractor }}">🗑 حذف المقاول</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:var(--space-4)">
          <div class="field"><label>كود المقاول</label><input class="input" value="{{ contractor.code }}" readOnly="{{ true }}"/></div>
          <div class="field"><label>اسم المقاول</label><input class="input" value="{{ contractor.name }}" readOnly="{{ true }}"/></div>
          <div class="field"><label>نوع الأعمال</label><input class="input" value="{{ contractor.type }}" readOnly="{{ true }}"/></div>
          <div class="field"><label>تاريخ التسجيل</label><input class="input" value="{{ contractor.regDate }}" readOnly="{{ true }}"/></div>
        </div>
        <div style="margin-top:var(--space-3)">
          <span class="tag {{ contractor.active ? 'tag-accent' : 'tag-accent-2' }}">{{ contractor.statusLabel }}</span>
          <span class="tag tag-neutral" style="margin-inline-start:8px">عدد العمال: {{ contractorWorkerCount }}</span>
          <span class="tag tag-neutral" style="margin-inline-start:8px">المشروع: {{ contractor.projectName }}</span>
        </div>
      </div>
      <div class="card-title" style="margin-bottom:var(--space-2)">بيانات عمال هذا المقاول</div>
      <table class="dt">
        <thead><tr><th>كود العامل</th><th>اسم العامل</th><th>رقم البطاقة</th><th>المهنة الافتراضية</th><th>تاريخ التسجيل</th></tr></thead>
        <tbody>
          <sc-for list="{{ contractorWorkers }}" as="w" hint-placeholder-count="6">
            <tr style="cursor:pointer" onClick="{{ w.selectHandler }}"><td>{{ w.code }}</td><td>{{ w.name }}</td><td>{{ w.card }}</td><td>{{ w.profession }}</td><td>17/07/2022</td></tr>
          </sc-for>
        </tbody>
      </table>
      <sc-if value="{{ hasSelectedWorker }}" hint-placeholder-val="{{ false }}">
        <div class="card elev-md" style="margin-top:var(--space-4)">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div class="card-title">ملف العامل: {{ selectedWorker.name }} ({{ selectedWorker.code }})</div>
            <button class="btn btn-ghost" onClick="{{ clearWorker }}">إغلاق ✕</button>
          </div>
          <p style="font-size:13px;color:var(--color-neutral-600)">المهنة: {{ selectedWorker.profession }} — رقم البطاقة: {{ selectedWorker.card }}</p>
          <div style="font-size:13px;font-weight:600;margin:var(--space-2) 0">آخر حركات الحضور</div>
          <table class="dt">
            <thead><tr><th>التاريخ</th><th>الوقت</th><th>النوع</th></tr></thead>
            <tbody>
              <sc-for list="{{ selectedWorker.logs }}" as="l" hint-placeholder-count="2">
                <tr><td>{{ l.date }}</td><td>{{ l.time }}</td><td><span class="tag {{ l.type === 'In' ? 'tag-accent' : 'tag-accent-2' }}">{{ l.typeLabel }}</span></td></tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </sc-if>
    </sc-if>

    <sc-if value="{{ isAnalytics }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px;margin-bottom:2px">تحليل الحضور والانصراف والتنبّؤ</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-5)">تحليل {{ an.dayCount }} يوم بصمة ({{ an.period }}) — إجمالي القوة {{ an.totalForce }} عامل · المشمولون بالبصمة {{ an.enrolled }} ({{ an.coverage }})</p>

      <div class="card elev-sm" style="margin-bottom:var(--space-4);border-top:3px solid var(--color-accent)">
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-4);align-items:flex-end">
          <div class="field" style="margin:0;min-width:240px">
            <label>الإدارة / القسم</label>
            <select class="input" value="{{ anDept }}" onChange="{{ onAnDept }}">
              <sc-for list="{{ anDeptOptions }}" as="dp" hint-placeholder-count="6">
                <option value="{{ dp.code }}">{{ dp.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="margin:0;min-width:260px">
            <label>القطاع الجغرافى</label>
            <select class="input" value="{{ anSector }}" onChange="{{ onAnSector }}">
              <sc-for list="{{ sectorOptions }}" as="so" hint-placeholder-count="8">
                <option value="{{ so.code }}">{{ so.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="margin:0;min-width:300px">
            <label>الموقع التابع للقطاع</label>
            <select class="input" value="{{ anSite }}" onChange="{{ onAnSite }}">
              <sc-for list="{{ siteOptions }}" as="si" hint-placeholder-count="6">
                <option value="{{ si.code }}">{{ si.name }}</option>
              </sc-for>
            </select>
          </div>
          <div style="flex:1;min-width:220px;padding-bottom:6px">
            <div style="font-size:11px;color:var(--color-neutral-500);letter-spacing:.04em">نطاق التحليل الحالي</div>
            <div style="font-family:var(--font-heading);font-size:16px;color:var(--color-accent-700)">{{ an.scopeLabel }}</div>
          </div>
          <button class="btn btn-ghost" style="margin-bottom:6px" onClick="{{ resetAnScope }}">إعادة تعيين النطاق</button>
        </div>
        <div style="margin-top:var(--space-3);font-size:12px;color:var(--color-neutral-600)">
          {{ secKpiSites }} موقعًا مكوّدًا في 7 قطاعات · {{ secKpiLinked }} موقعًا به عمالة مسجلة · {{ secUnmappedCount }} مشروعًا بانتظار التكويد ({{ secUnmappedWorkers }} عامل)
        </div>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-kicker">رئاسة القطاعات</div>
        <div class="card-title" style="margin-bottom:var(--space-1)">اسم رئيس القطاع</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">الأسماء تُحفظ كبيانات مسجّلة — وعند اختيار القطاع يُقترح الاسم تلقائيًا مع إمكانية التعديل أو الحذف أو إضافة اسم آخر · رئيس القطاع المحدد فى التحليل أعلاه: {{ anSectorHead }}</div>
        <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;align-items:flex-end;margin-bottom:var(--space-3)">
          <div class="field" style="margin:0;min-width:240px">
            <label>القطاع</label>
            <select class="input" value="{{ shSector }}" onChange="{{ onShSector }}">
              <sc-for list="{{ shSectorOptions }}" as="so" hint-placeholder-count="7">
                <option value="{{ so.code }}">{{ so.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="margin:0;min-width:280px">
            <label>اسم رئيس القطاع (مقترح تلقائيًا — قابل للتعديل)</label>
            <input class="input" placeholder="مثال: م. أحمد سعيد" value="{{ shHead }}" onChange="{{ onShHead }}"/>
          </div>
          <button class="btn btn-primary" onClick="{{ saveSectorHead }}">حفظ الاسم</button>
          <button class="btn btn-secondary" onClick="{{ addSectorHead }}">+ إضافة اسم آخر</button>
          <button class="btn btn-ghost" onClick="{{ clearSectorHeads }}">🗑 حذف أسماء هذا القطاع</button>
        </div>
        <table class="dt">
          <thead><tr><th>القطاع</th><th>الكود</th><th>رئاسة القطاع</th><th>الحالة</th></tr></thead>
          <tbody>
            <sc-for list="{{ sectorHeadRows }}" as="r" hint-placeholder-count="7">
              <tr>
                <td>{{ r.name }}</td>
                <td dir="ltr">{{ r.code }}</td>
                <td>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                    <sc-for list="{{ r.heads }}" as="h" hint-placeholder-count="1">
                      <span class="tag {{ h.tagClass }}">{{ h.name }} <button class="btn btn-ghost btn-icon" title="حذف" onClick="{{ h.remove }}">✕</button></span>
                    </sc-for>
                  </div>
                </td>
                <td><span class="tag {{ r.statusClass }}">{{ r.statusLabel }}</span></td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>

      <div class="kpi-grid" style="margin-bottom:var(--space-4)">
        <div class="card elev-sm">
          <div class="card-kicker">إجمالي القوة المسجلة</div>
          <div class="kpi-num">{{ an.totalForce }}</div>
          <div class="card-meta">المشمولون بأجهزة البصمة {{ an.enrolled }} · التغطية {{ an.coverage }}</div>
        </div>
        <div class="card elev-sm" style="border-top:3px solid var(--color-accent)">
          <div class="card-kicker">متوسط الحاضرين يوميًا</div>
          <div class="kpi-num" style="color:var(--color-accent-700)">{{ an.avgPresent }}</div>
          <div class="card-meta">نسبة حضور {{ an.avgRate }} من المشمولين بالبصمة</div>
        </div>
        <div class="card elev-sm" style="border-top:3px solid var(--color-accent-2-700)">
          <div class="card-kicker">متوسط الغياب اليومي</div>
          <div class="kpi-num" style="color:var(--color-accent-2-700)">{{ an.avgAbsent }}</div>
          <div class="card-meta">معدل غياب {{ an.absenceRate }} · متأخرون {{ an.avgLate }} يوميًا</div>
        </div>
        <div class="card elev-sm">
          <div class="card-kicker">الاتجاه العام</div>
          <div class="kpi-num" style="color:{{ an.trendColor }};font-size:26px">{{ an.trendLabel }}</div>
          <div class="card-meta">{{ an.slopeLabel }} على آخر 7 أيام · التنبؤ التالي: {{ an.nextDayLabel }}</div>
        </div>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-1)">١ · التحليل بحسب الإدارة / القسم</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">المستوى الأول للتحليل — اضغط «تحليل» لقصر القطاعات والمواقع وكل مؤشرات الصفحة على إدارة واحدة · الإدارة الحالية: {{ anDeptLabel }}</div>
        <table class="dt">
          <thead><tr><th>الإدارة / القسم</th><th>العمالة</th><th>على البصمة</th><th>حاضر اليوم</th><th>غائب</th><th>نسبة الحضور</th><th></th></tr></thead>
          <tbody>
            <sc-for list="{{ anDeptRows }}" as="dp" hint-placeholder-count="6">
              <tr style="background:{{ dp.rowBg }}">
                <td><strong>{{ dp.name }}</strong></td>
                <td>{{ dp.workersLabel }}</td>
                <td>{{ dp.enrolled }}</td>
                <td>{{ dp.present }}</td>
                <td>{{ dp.absent }}</td>
                <td>
                  <div style="display:flex;align-items:center;gap:8px">
                    <div style="flex:1;height:6px;background:var(--color-neutral-300);border-radius:3px;overflow:hidden">
                      <div style="width:{{ dp.pct }}%;height:100%;background:{{ dp.barColor }}"></div>
                    </div>
                    <span style="font-size:12px;min-width:52px">{{ dp.pctLabel }}</span>
                  </div>
                </td>
                <td><button class="btn btn-ghost" style="font-size:12px;padding:4px 10px" onClick="{{ dp.pickHandler }}">تحليل</button></td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>

      <sc-if value="{{ anShowSectors }}" hint-placeholder-val="{{ true }}">
        <div class="card elev-sm" style="margin-bottom:var(--space-4)">
          <div class="card-title" style="margin-bottom:var(--space-1)">٢ · التحليل بحسب القطاع الجغرافى</div>
          <div class="card-meta" style="margin-bottom:var(--space-3)">اختر قطاعًا من القائمة أعلاه — أو اضغط «تحليل» بجوار القطاع — لعرض مواقعه وقصر كل مؤشرات هذه الصفحة عليه</div>
          <table class="dt">
            <thead><tr><th>كود القطاع</th><th>القطاع الجغرافى</th><th>المواقع</th><th>مواقع نشطة</th><th>العمالة</th><th>حاضر اليوم</th><th>نسبة الحضور</th><th></th></tr></thead>
            <tbody>
              <sc-for list="{{ secSectorRows }}" as="sec" hint-placeholder-count="7">
                <tr>
                  <td><strong>{{ sec.code }}</strong></td>
                  <td>{{ sec.name }}</td>
                  <td>{{ sec.sites }}</td>
                  <td>{{ sec.linked }}</td>
                  <td>{{ sec.workersLabel }}</td>
                  <td>{{ sec.presentLabel }}</td>
                  <td>
                    <div style="display:flex;align-items:center;gap:8px">
                      <div style="flex:1;height:6px;background:var(--color-neutral-300);border-radius:3px;overflow:hidden">
                        <div style="width:{{ sec.pct }}%;height:100%;background:{{ sec.barColor }}"></div>
                      </div>
                      <span style="font-size:12px;min-width:52px">{{ sec.pctLabel }}</span>
                    </div>
                  </td>
                  <td><button class="btn btn-ghost" style="font-size:12px;padding:4px 10px" onClick="{{ sec.pickHandler }}">تحليل</button></td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </sc-if>

      <sc-if value="{{ anShowSites }}" hint-placeholder-val="{{ false }}">
        <div class="card elev-sm" style="margin-bottom:var(--space-4)">
          <div class="card-title" style="margin-bottom:var(--space-1)">٣ · مواقع القطاع ({{ secSiteCount }})</div>
          <div class="card-meta" style="margin-bottom:var(--space-3)">اضغط «تحليل» لقصر الصفحة على موقع واحد — والسطر المظلّل هو الموقع المحدد حاليًا</div>
          <table class="dt">
            <thead><tr><th>الموقع</th><th>كود الموقع</th><th>كود القطاع</th><th>العمالة</th><th>حاضر اليوم</th><th>نسبة الحضور</th><th>مشاريع القاعدة المرتبطة</th><th></th></tr></thead>
            <tbody>
              <sc-for list="{{ secSiteRows }}" as="st" hint-placeholder-count="10">
                <tr style="background:{{ st.rowBg }}">
                  <td><strong>{{ st.name }}</strong></td>
                  <td>{{ st.code }}</td>
                  <td>{{ st.sectorCode }}</td>
                  <td>{{ st.workersLabel }}</td>
                  <td>{{ st.presentLabel }}</td>
                  <td>{{ st.pctLabel }}</td>
                  <td style="font-size:12px;color:{{ st.refsColor }}">{{ st.refsLabel }}</td>
                  <td><button class="btn btn-ghost" style="font-size:12px;padding:4px 10px" onClick="{{ st.pickHandler }}">تحليل</button></td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </sc-if>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-1)">منحنى الحضور اليومي الفعلي</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">أعلى يوم: {{ an.bestLabel }} · أدنى يوم: {{ an.worstLabel }}</div>
        <div style="display:flex;align-items:flex-end;gap:6px;height:180px;padding-top:8px">
          <sc-for list="{{ anChart }}" as="d" hint-placeholder-count="22">
            <div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;height:100%" title="{{ d.date }}">
              <div style="font-size:10px;color:var(--color-neutral-600)">{{ d.rate }}%</div>
              <div style="width:100%;height:{{ d.h }}%;border-radius:var(--radius-sm);background:var(--color-accent)"></div>
              <div style="font-size:11px;color:var(--color-neutral-600)">{{ d.dayLabel }}</div>
            </div>
          </sc-for>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);margin-bottom:var(--space-4)">
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-1)">التنبؤ بالحضور — 5 أيام قادمة</div>
          <div class="card-meta" style="margin-bottom:var(--space-3)">نموذج انحدار خطي على آخر 7 أيام مُعدَّل بمعامل يوم الأسبوع</div>
          <table class="dt">
            <thead><tr><th>التاريخ</th><th>اليوم</th><th>حضور متوقع</th><th>غياب متوقع</th><th>النسبة</th><th>الثقة</th></tr></thead>
            <tbody>
              <sc-for list="{{ anForecast }}" as="f" hint-placeholder-count="5">
                <tr>
                  <td dir="ltr" style="text-align:right">{{ f.date }}</td><td>{{ f.weekday }}</td>
                  <td>{{ f.present }}</td><td>{{ f.absent }}</td><td>{{ f.rate }}</td>
                  <td><span class="tag {{ f.tagClass }}">{{ f.conf }}</span></td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </div>
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-1)">النمط الأسبوعي</div>
          <div class="card-meta" style="margin-bottom:var(--space-3)">متوسط الحضور بحسب يوم الأسبوع — أساس معامل التنبؤ</div>
          <table class="dt">
            <thead><tr><th>اليوم</th><th>عدد الأيام</th><th>متوسط الحضور</th><th>النسبة</th><th>معامل</th><th>متأخرون</th></tr></thead>
            <tbody>
              <sc-for list="{{ anWeekdays }}" as="w" hint-placeholder-count="6">
                <tr><td>{{ w.weekday }}</td><td>{{ w.n }}</td><td>{{ w.avg }}</td><td>{{ w.rate }}%</td><td dir="ltr" style="text-align:right">×{{ w.factor }}</td><td>{{ w.late }}</td></tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);margin-bottom:var(--space-4)">
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-3)">تحليل القوة بحسب الدور</div>
          <table class="dt">
            <thead><tr><th>الدور</th><th>القوة</th><th>حاضر</th><th>غائب</th><th>نسبة الحضور</th></tr></thead>
            <tbody>
              <sc-for list="{{ anRoles }}" as="r" hint-placeholder-count="4">
                <tr><td>{{ r.label }}</td><td>{{ r.countLabel }}</td><td>{{ r.present }}</td><td>{{ r.absent }}</td><td>{{ r.rate }}%</td></tr>
              </sc-for>
            </tbody>
          </table>
        </div>
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-3)">تحليل الحضور بحسب المشروع</div>
          <table class="dt">
            <thead><tr><th>المشروع</th><th>مسجل</th><th>على البصمة</th><th>حاضر</th><th>غائب</th><th>النسبة</th></tr></thead>
            <tbody>
              <sc-for list="{{ anProjects }}" as="p" hint-placeholder-count="6">
                <tr><td>{{ p.name }}</td><td>{{ p.registeredLabel }}</td><td>{{ p.enrolled }}</td><td>{{ p.present }}</td><td>{{ p.absent }}</td><td>{{ p.pctLabel }}</td></tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card elev-sm">
        <div class="card-title" style="margin-bottom:var(--space-1)">التفصيل اليومي</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">بصمات ناقصة (دخول بدون انصراف) خلال الفترة: {{ an.incomplete }} حالة</div>
        <table class="dt">
          <thead><tr><th>التاريخ</th><th>اليوم</th><th>حاضر</th><th>غائب</th><th>نسبة الحضور</th><th>متوسط ساعات العمل</th><th>متأخرون</th><th>بصمة ناقصة</th></tr></thead>
          <tbody>
            <sc-for list="{{ anDays }}" as="d" hint-placeholder-count="10">
              <tr>
                <td dir="ltr" style="text-align:right">{{ d.date }}</td><td>{{ d.weekday }}</td>
                <td>{{ d.presentLabel }}</td><td>{{ d.absentLabel }}</td>
                <td><span class="tag {{ d.tagClass }}">{{ d.rateLabel }}</span></td>
                <td>{{ d.avgHours }}</td><td>{{ d.late }}</td><td>{{ d.incomplete }}</td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>
    </sc-if>

    <sc-if value="{{ isProfessions }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">المهن وفئات الأجر</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">الفئة تُحدَّد باليومية — واليوم 9 ساعات منها ساعة راحة أى 8 ساعات عمل فعلية، وعليها يُحتسب الإضافي والخصم</p>
      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-3)">إضافة مهنة / وظيفة جديدة</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3);align-items:end">
          <div class="field"><label>اسم المهنة</label>
            <input class="input" list="prof-titles" placeholder="اكتب مهنة جديدة أو اختر من القائمة" value="{{ newProfName }}" onChange="{{ onNewProfName }}"/>
            <datalist id="prof-titles">
              <sc-for list="{{ availableProfessionTitles }}" as="t" hint-placeholder-count="5">
                <option value="{{ t }}"></option>
              </sc-for>
            </datalist>
          </div>
          <div class="field"><label>الإدارة التابعة لها</label>
            <select class="input" value="{{ newProfDept }}" onChange="{{ onNewProfDept }}">
              <sc-for list="{{ deptOptions }}" as="d" hint-placeholder-count="6">
                <option value="{{ d }}">{{ d }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field">
            <label>الفئة الخاصة بالمهنة</label>
            <select class="input" value="{{ newProfCategory }}" onChange="{{ onNewProfCategory }}">
              <option value="A">A — إشراف</option>
              <option value="B">B — فني/صنايعي</option>
              <option value="C">C — مساعد</option>
              <option value="D">D — عمالة عادية</option>
              <option value="E">E — تحت التدريب</option>
            </select>
          </div>
          <div class="field"><label>قيمة المقابل المادي (يومية ج.م)</label><input class="input" dir="ltr" placeholder="{{ newProfPayHint }}" value="{{ newProfPay }}" onChange="{{ onNewProfPay }}"/></div>
          <div class="field"><label>تاريخ الاستحقاق / التطبيق</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ newProfEff }}" onChange="{{ onNewProfEff }}"/></div>
          <button class="btn btn-primary" onClick="{{ addProfession }}">+ إضافة المهنة</button>
        </div>
        <div style="margin-top:var(--space-3);padding:10px 12px;background:var(--color-accent-100);border-radius:var(--radius-md);font-size:13px;color:var(--color-neutral-700);line-height:1.9">
          <b style="color:var(--color-accent-700)">خصائص الفئة المختارة ({{ newProfCategory }}):</b> {{ newProfCatDesc }}
        </div>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-1)">تعديل فئة مهنة بتاريخ استحقاق</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">التعديل لا يسري إلا من تاريخ الاستحقاق المحدد — وتبقى الفئة السابقة سارية على كل السراكي قبل ذلك التاريخ</div>
        <div style="display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:var(--space-3);align-items:end">
          <div class="field"><label>المهنة</label>
            <select class="input" value="{{ chProf }}" onChange="{{ onChProf }}">
              <option value="">اختر المهنة</option>
              <sc-for list="{{ allProfTitles }}" as="t" hint-placeholder-count="6">
                <option value="{{ t }}">{{ t }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>الفئة الجديدة</label>
            <select class="input" value="{{ chCat }}" onChange="{{ onChCat }}">
              <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option>
            </select>
          </div>
          <div class="field"><label>تاريخ الاستحقاق</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ chEff }}" onChange="{{ onChEff }}"/></div>
          <button class="btn btn-secondary" onClick="{{ addCatChange }}" disabled="{{ chDisabled }}">اعتماد التعديل</button>
        </div>
        <sc-if value="{{ hasCatHistory }}" hint-placeholder-val="{{ false }}">
          <table class="dt" style="margin-top:var(--space-3)">
            <thead><tr><th>المهنة</th><th>من فئة</th><th>إلى فئة</th><th>تاريخ الاستحقاق</th><th>الحالة</th><th>تاريخ الاعتماد</th></tr></thead>
            <tbody>
              <sc-for list="{{ catHistory }}" as="h" hint-placeholder-count="2">
                <tr>
                  <td>{{ h.prof }}</td><td>{{ h.from }}</td><td><span class="tag tag-accent">{{ h.to }}</span></td>
                  <td dir="ltr" style="text-align:right">{{ h.eff }}</td>
                  <td><span class="tag {{ h.tagClass }}">{{ h.statusLabel }}</span></td>
                  <td dir="ltr" style="text-align:right;font-size:12px">{{ h.created }}</td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </sc-if>
      </div>
      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-1)">قيم الفئات باليومية وبدل المنطقة</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">أدخل قيمة اليومية لكل فئة — اليوم 9 ساعات منها ساعة راحة = 8 ساعات عمل، وقيمة ساعة الإضافي تساوى قيمة ساعة العمل العادية دون زيادة</div>
        <table class="dt">
          <thead><tr><th>الفئة</th><th>الوصف</th><th>قيمة اليومية (ج.م / 8 ساعات)</th><th>قيمة الساعة</th><th>ساعة إضافي (= قيمة ساعة العمل)</th><th>بدل المنطقة (ج.م/يوم)</th></tr></thead>
          <tbody>
            <sc-for list="{{ categoryRates }}" as="c" hint-placeholder-count="5">
              <tr>
                <td><span class="tag tag-accent">{{ c.key }}</span></td>
                <td>{{ c.label }}</td>
                <td><input class="input" dir="ltr" style="padding:4px 8px;font-size:13px;max-width:110px" value="{{ c.daily }}" onChange="{{ c.onDaily }}"/></td>
                <td dir="ltr" style="text-align:right">{{ c.rate }}</td>
                <td dir="ltr" style="text-align:right">{{ c.overtime }}</td>
                <td><input class="input" dir="ltr" style="padding:4px 8px;font-size:13px;max-width:110px" value="{{ c.allowance }}" onChange="{{ c.onAllowance }}"/></td>
              </tr>
            </sc-for>
          </tbody>
        </table>
        <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)">
          <button class="btn btn-primary" onClick="{{ saveCatRates }}">حفظ قيم الفئات</button>
          <span style="font-size:12px;color:var(--color-neutral-600)">{{ catRatesSavedLabel }}</span>
        </div>
      </div>
      <table class="dt">
        <thead><tr><th>كود المهنة</th><th>المهنة</th><th>الإدارة التابعة</th><th>الفئة</th><th>قيمة المقابل المادي (يومية)</th><th>سعر الساعة</th><th>سعر ساعة إضافي</th><th>سعر خصم الساعة</th><th>الحالة</th></tr></thead>
        <tbody>
          <sc-for list="{{ professionsPage }}" as="p" hint-placeholder-count="15">
            <tr>
              <td>{{ p.code }}</td><td>{{ p.name }}</td><td style="font-size:12px">{{ p.deptLabel }}</td><td>{{ p.category }}</td>
              <td style="font-family:var(--font-heading);color:var(--color-accent-700)">{{ p.dailyRate }} ج.م</td><td>{{ p.hourRate }} ج.م</td><td>{{ p.overtimeRate }} ج.م</td><td>{{ p.deductionRate }} ج.م</td>
              <td><span class="tag {{ p.stopped ? 'tag-accent-2' : 'tag-accent' }}">{{ p.statusLabel }}</span></td>
            </tr>
          </sc-for>
        </tbody>
      </table>
      <div style="display:flex;justify-content:center;align-items:center;gap:var(--space-3);margin-top:var(--space-3)">
        <button class="btn btn-ghost btn-icon" onClick="{{ gotoProfPrev }}">◄</button>
        <span style="font-size:13px;color:var(--color-neutral-600)">صفحة {{ profPageLabel }}</span>
        <button class="btn btn-ghost btn-icon" onClick="{{ gotoProfNext }}">►</button>
      </div>
    </sc-if>

    <sc-if value="{{ isAllowances }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">البدلات والمشروعات</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">مقايسات التعاقد · البدلات الثابتة · بدل المشروع المرتبط بالمنطقة وقواعد صرفه</p>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-kicker">١ · مرفقات المشروعات</div>
        <div class="card-title" style="margin-bottom:var(--space-1)">رفع مقايسة التعاقد</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">تُرفق المقايسة المعتمدة لكل مشروع وتُستخدم كمرجع لاعتماد بنود الأعمال والبدلات</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);align-items:end">
          <div class="field"><label>المشروع</label>
            <select class="input" value="{{ qProject }}" onChange="{{ onQProject }}">
              <option value="">اختر المشروع</option>
              <sc-for list="{{ allProjectOptions }}" as="p" hint-placeholder-count="6">
                <option value="{{ p.code }}">{{ p.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>رقم / اسم المقايسة</label><input class="input" placeholder="مقايسة رقم …" value="{{ qRef }}" onChange="{{ onQRef }}"/></div>
          <div class="field"><label>قيمة المقايسة (ج.م)</label><input class="input" dir="ltr" placeholder="0" value="{{ qAmount }}" onChange="{{ onQAmount }}"/></div>
          <div class="field"><label>تاريخ التعاقد</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ qDate }}" onChange="{{ onQDate }}"/></div>
        </div>
        <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3);flex-wrap:wrap">
          <label class="btn btn-secondary" style="cursor:pointer;margin:0">📎 اختر ملف المقايسة<input type="file" accept=".pdf,.xlsx,.xls,.doc,.docx,image/*" style="display:none" onChange="{{ onQFile }}"/></label>
          <span style="font-size:13px;color:var(--color-neutral-700)">{{ qFileLabel }}</span>
          <button class="btn btn-primary" style="margin-inline-start:auto" onClick="{{ addQuote }}" disabled="{{ qDisabled }}">حفظ المرفق</button>
        </div>
        <sc-if value="{{ hasQuotes }}" hint-placeholder-val="{{ false }}">
          <table class="dt" style="margin-top:var(--space-3)">
            <thead><tr><th>المشروع</th><th>المقايسة</th><th>القيمة</th><th>تاريخ التعاقد</th><th>الملف المرفق</th><th>تاريخ الرفع</th></tr></thead>
            <tbody>
              <sc-for list="{{ quotes }}" as="q" hint-placeholder-count="2">
                <tr>
                  <td>{{ q.projectName }}</td><td>{{ q.ref }}</td>
                  <td dir="ltr" style="text-align:right;font-family:var(--font-heading)">{{ q.amount }}</td>
                  <td dir="ltr" style="text-align:right">{{ q.date }}</td>
                  <td style="font-size:12px">📄 {{ q.fileName }}</td>
                  <td dir="ltr" style="text-align:right;font-size:12px">{{ q.uploaded }}</td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </sc-if>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-kicker">٢ · شريحة البدلات الثابتة</div>
        <div class="card-title" style="margin-bottom:var(--space-1)">بدل السكن وبدل الانتقال لكل فئة</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">قيم يومية تُضاف على اليومية الأساسية عند احتساب المستحقات</div>
        <table class="dt">
          <thead><tr><th>الفئة</th><th>الوصف</th><th>اليومية الأساسية</th><th>بدل السكن (ج.م/يوم)</th><th>بدل الانتقال (ج.م/يوم)</th><th>إجمالي اليومية بالبدلات</th></tr></thead>
          <tbody>
            <sc-for list="{{ fixedAllowRows }}" as="c" hint-placeholder-count="5">
              <tr>
                <td><span class="tag tag-accent">{{ c.key }}</span></td>
                <td>{{ c.label }}</td>
                <td dir="ltr" style="text-align:right">{{ c.daily }}</td>
                <td><input class="input" dir="ltr" style="padding:4px 8px;font-size:13px;max-width:110px" value="{{ c.housing }}" onChange="{{ c.onHousing }}"/></td>
                <td><input class="input" dir="ltr" style="padding:4px 8px;font-size:13px;max-width:110px" value="{{ c.transport }}" onChange="{{ c.onTransport }}"/></td>
                <td dir="ltr" style="text-align:right;font-family:var(--font-heading);color:var(--color-accent-700)">{{ c.total }}</td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-kicker">٣ · إعدادات بدل المشروع</div>
        <div class="card-title" style="margin-bottom:var(--space-3)">إدراج بدل مشروع مرتبط بالمنطقة</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);align-items:end">
          <div class="field"><label>القطاع الجغرافي</label>
            <select class="input" value="{{ paSector }}" onChange="{{ onPaSector }}">
              <sc-for list="{{ sectorOptions }}" as="so" hint-placeholder-count="7">
                <option value="{{ so.code }}">{{ so.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>المنطقة / الموقع</label>
            <select class="input" value="{{ paRegion }}" onChange="{{ onPaRegion }}">
              <option value="">اختر المنطقة</option>
              <sc-for list="{{ paRegionOptions }}" as="rg" hint-placeholder-count="5">
                <option value="{{ rg.code }}">{{ rg.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>قيمة بدل المشروع (ج.م/يوم)</label><input class="input" dir="ltr" placeholder="0" value="{{ paValue }}" onChange="{{ onPaValue }}"/></div>
          <button class="btn btn-primary" onClick="{{ addProjAllowance }}" disabled="{{ paDisabled }}">+ إدراج البدل</button>
        </div>
        <sc-if value="{{ hasProjAllowances }}" hint-placeholder-val="{{ false }}">
          <table class="dt" style="margin-top:var(--space-3)">
            <thead><tr><th>القطاع</th><th>المنطقة</th><th>قيمة البدل اليومي</th><th>الإدارات المستحقة</th><th>الحد الأدنى للساعات</th></tr></thead>
            <tbody>
              <sc-for list="{{ projAllowances }}" as="a" hint-placeholder-count="2">
                <tr>
                  <td style="font-size:12px">{{ a.sectorName }}</td><td>{{ a.regionName }}</td>
                  <td dir="ltr" style="text-align:right;font-family:var(--font-heading);color:var(--color-accent-700)">{{ a.value }} ج.م</td>
                  <td style="font-size:12px">{{ a.deptsLabel }}</td>
                  <td style="text-align:center">4 ساعات فعلية</td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </sc-if>
      </div>

      <div class="card elev-sm">
        <div class="card-kicker">٤ · قواعد صرف بدل المنطقة</div>
        <div class="card-title" style="margin-bottom:var(--space-3)">شرطان معًا — لا يُصرف البدل إلا باستيفائهما</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)">
          <div style="padding:14px;background:var(--color-accent-100);border-radius:var(--radius-md)">
            <div style="font-weight:600;color:var(--color-accent-700);margin-bottom:8px">شرط الإدارة</div>
            <div style="display:flex;flex-wrap:wrap;gap:6px">
              <sc-for list="{{ eligibleDepts }}" as="d" hint-placeholder-count="10">
                <span class="tag tag-accent">{{ d }}</span>
              </sc-for>
            </div>
            <div style="font-size:12px;color:var(--color-neutral-700);margin-top:10px">المهن التابعة لغير هذه الإدارات لا تستحق بدل المنطقة تلقائياً</div>
          </div>
          <div style="padding:14px;background:var(--color-accent-100);border-radius:var(--radius-md)">
            <div style="font-weight:600;color:var(--color-accent-700);margin-bottom:8px">شرط الوقت</div>
            <div style="font-family:var(--font-heading);font-size:30px;color:var(--color-accent)">≥ 4 ساعات</div>
            <div style="font-size:13px;color:var(--color-neutral-700);margin-top:6px;line-height:1.9">ساعات عمل فعلية مسجلة بالبصمة في اليوم الواحد. أقل من ذلك = البدل صفر لهذا اليوم مهما كانت الإدارة.</div>
          </div>
        </div>
        <div class="card-title" style="margin:var(--space-4) 0 var(--space-2)">اختبار القاعدة على حضور اليوم</div>
        <table class="dt">
          <thead><tr><th>الإدارة / القسم</th><th>عدد العمال</th><th>مستحقة للبدل</th><th>مستوفو 4 ساعات</th><th>الصرف المستحق اليوم</th></tr></thead>
          <tbody>
            <sc-for list="{{ allowanceCheck }}" as="r" hint-placeholder-count="6">
              <tr>
                <td>{{ r.dept }}</td>
                <td style="text-align:center">{{ r.count }}</td>
                <td><span class="tag {{ r.tagClass }}">{{ r.eligibleLabel }}</span></td>
                <td style="text-align:center">{{ r.qualified }}</td>
                <td dir="ltr" style="text-align:right;font-family:var(--font-heading);color:var(--color-accent-700)">{{ r.amount }} ج.م</td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>
    </sc-if>

    <sc-if value="{{ isTransfers }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">نقل الموظفين والتاريخ الوظيفي</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">نقل العامل بين المشروعات مع تعديل المهنة والفئة والبدل — وكل حركة تُوثَّق في السجل الوظيفي</p>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-kicker">أمر نقل جديد</div>
        <div class="card-title" style="margin-bottom:var(--space-3)">بيانات النقل</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)">
          <div class="field"><label>كود العامل أو اسمه</label>
            <input class="input" list="tr-workers" placeholder="ابحث بالكود أو الاسم" value="{{ trSearch }}" onChange="{{ onTrSearch }}"/>
            <datalist id="tr-workers">
              <sc-for list="{{ trWorkerOptions }}" as="w" hint-placeholder-count="6">
                <option value="{{ w.value }}"></option>
              </sc-for>
            </datalist>
          </div>
          <div class="field"><label>المشروع الحالي</label><input class="input" value="{{ trFromProject }}" readOnly="{{ true }}" style="background:var(--color-neutral-100)"/></div>
          <div class="field"><label>المهنة الحالية / الفئة</label><input class="input" value="{{ trCurrent }}" readOnly="{{ true }}" style="background:var(--color-neutral-100)"/></div>
          <div class="field"><label>المشروع المنقول إليه</label>
            <select class="input" value="{{ trToProject }}" onChange="{{ onTrToProject }}">
              <option value="">اختر المشروع</option>
              <sc-for list="{{ allProjectOptions }}" as="p" hint-placeholder-count="6">
                <option value="{{ p.code }}">{{ p.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>المهنة بعد النقل</label>
            <select class="input" value="{{ trProfession }}" onChange="{{ onTrProfession }}">
              <option value="">بدون تغيير</option>
              <sc-for list="{{ allProfTitles }}" as="t" hint-placeholder-count="6">
                <option value="{{ t }}">{{ t }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>الوظيفة / الإدارة بعد النقل</label>
            <select class="input" value="{{ trDept }}" onChange="{{ onTrDept }}">
              <option value="">بدون تغيير</option>
              <sc-for list="{{ deptOptions }}" as="d" hint-placeholder-count="6">
                <option value="{{ d }}">{{ d }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>الفئة بعد النقل</label>
            <select class="input" value="{{ trCategory }}" onChange="{{ onTrCategory }}">
              <option value="">بدون تغيير</option>
              <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option>
            </select>
          </div>
          <div class="field"><label>البدل بعد النقل (ج.م/يوم)</label><input class="input" dir="ltr" placeholder="بدون تغيير" value="{{ trAllowance }}" onChange="{{ onTrAllowance }}"/></div>
          <div class="field"><label>تاريخ تطبيق النقل *</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ trEff }}" onChange="{{ onTrEff }}"/></div>
          <div class="field" style="grid-column:span 3"><label>سبب النقل / ملاحظات</label><input class="input" placeholder="احتياج تشغيلي…" value="{{ trNote }}" onChange="{{ onTrNote }}"/></div>
        </div>
        <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)">
          <button class="btn btn-primary" onClick="{{ doTransfer }}" disabled="{{ trDisabled }}">اعتماد النقل</button>
          <span style="font-size:13px;color:var(--color-neutral-600)">{{ trHint }}</span>
        </div>
      </div>

      <div class="card elev-sm">
        <div class="card-kicker">سجل الحركات الوظيفية</div>
        <div class="card-title" style="margin-bottom:var(--space-1)">History Log — المسار الوظيفي الكامل</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">{{ historyCountLabel }}</div>
        <div class="toolbar" style="margin-bottom:var(--space-3)">
          <div class="field" style="min-width:240px;margin:0"><label>تصفية بكود أو اسم العامل</label><input class="input" placeholder="كل العمال" value="{{ hlSearch }}" onChange="{{ onHlSearch }}"/></div>
        </div>
        <table class="dt">
          <thead><tr><th>كود العامل</th><th>الاسم</th><th>نوع الحركة</th><th>من</th><th>إلى</th><th>المهنة</th><th>الوظيفة/الإدارة</th><th>الفئة</th><th>البدل</th><th>تاريخ التطبيق</th><th>تاريخ الاعتماد</th><th>ملاحظات</th></tr></thead>
          <tbody>
            <sc-for list="{{ historyRows }}" as="h" hint-placeholder-count="4">
              <tr>
                <td dir="ltr" style="text-align:right">{{ h.code }}</td><td>{{ h.name }}</td>
                <td><span class="tag {{ h.tagClass }}">{{ h.kind }}</span></td>
                <td style="font-size:12px">{{ h.from }}</td><td style="font-size:12px">{{ h.to }}</td>
                <td style="font-size:12px">{{ h.profession }}</td><td style="font-size:12px">{{ h.dept }}</td>
                <td style="text-align:center">{{ h.category }}</td>
                <td dir="ltr" style="text-align:right">{{ h.allowance }}</td>
                <td dir="ltr" style="text-align:right">{{ h.eff }}</td>
                <td dir="ltr" style="text-align:right;font-size:12px">{{ h.created }}</td>
                <td style="font-size:12px;color:var(--color-neutral-600)">{{ h.note }}</td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>
    </sc-if>

    <sc-if value="{{ isShifts }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">تعريف الورديات</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">وردية عمل العمال 9 ساعات منها ساعة راحة = 8 ساعات عمل · وردية عمل الأمن 12 ساعة عمل</p>
      <table class="dt">
        <thead><tr><th>الوردية</th><th>كود الوقت</th><th>بداية العمل</th><th>نهاية العمل</th><th>مدة الراحة (ساعة)</th><th>عدد ساعات العمل</th><th>حساب الساعات كاملة</th></tr></thead>
        <tbody>
          <sc-for list="{{ shifts }}" as="sh" hint-placeholder-count="3">
            <tr>
              <td><strong>{{ sh.name }}</strong></td><td>{{ sh.code }}</td><td>{{ sh.start }}</td><td>{{ sh.end }}</td><td>{{ sh.breakHours }}</td><td>{{ sh.hours }}</td>
              <td><span class="tag {{ sh.full ? 'tag-accent' : 'tag-outline' }}">{{ sh.fullLabel }}</span></td>
            </tr>
          </sc-for>
        </tbody>
      </table>
    </sc-if>

    <sc-if value="{{ isAttendanceLog }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">سجل دخول وخروج العمال</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">كل حركة مسح فعلية — مصدر الحقيقة الزمنية لمطابقة السراكي · {{ ov.logSource }}</p>
      <div class="toolbar">
        <div class="field" style="min-width:220px"><label>بحث بالكود أو اسم العامل</label><input class="input" placeholder="14710001 أو اسم العامل" value="{{ logSearch }}" onChange="{{ onLogSearch }}"/></div>
        <div class="field" style="min-width:200px">
          <label>القطاع الجغرافى</label>
          <select class="input" value="{{ logSector }}" onChange="{{ onLogSector }}">
            <sc-for list="{{ logSectorOptions }}" as="so" hint-placeholder-count="8">
              <option value="{{ so.code }}">{{ so.name }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="min-width:220px">
          <label>المشروع</label>
          <select class="input" value="{{ logProject }}" onChange="{{ onLogProject }}">
            <sc-for list="{{ logProjectOptions }}" as="po" hint-placeholder-count="6">
              <option value="{{ po.code }}">{{ po.name }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="min-width:180px">
          <label>الإدارة / القسم</label>
          <select class="input" value="{{ logDept }}" onChange="{{ onLogDept }}">
            <option value="all">كل الأقسام والمواقع</option>
            <sc-for list="{{ deptOptions }}" as="d" hint-placeholder-count="4">
              <option value="{{ d }}">{{ d }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="min-width:160px">
          <label>التاريخ</label>
          <select class="input" value="{{ logDate }}" onChange="{{ onLogDate }}">
            <option value="all">كل الأيام</option>
            <sc-for list="{{ logDateOptions }}" as="d" hint-placeholder-count="4">
              <option value="{{ d }}">{{ d }}</option>
            </sc-for>
          </select>
        </div>
        <div class="field" style="min-width:150px">
          <label>نوع الحركة</label>
          <select class="input" value="{{ logType }}" onChange="{{ onLogType }}">
            <option value="all">الكل</option>
            <option value="In">دخول</option>
            <option value="Out">خروج</option>
          </select>
        </div>
      </div>
      <table class="dt">
        <thead><tr><th>مسلسل</th><th>كود العامل</th><th>الاسم</th><th>القسم/الموقع</th><th>التاريخ</th><th>الوقت</th><th>نوع الحركة</th></tr></thead>
        <tbody>
          <sc-for list="{{ attendanceLogPage }}" as="l" hint-placeholder-count="5">
            <tr><td>{{ l.id }}</td><td>{{ l.code }}</td><td>{{ l.name }}</td><td>{{ l.dept }}</td><td>{{ l.date }}</td><td>{{ l.time }}</td>
              <td><span class="tag {{ l.type === 'In' ? 'tag-accent' : 'tag-accent-2' }}">{{ l.typeLabel }}</span></td>
            </tr>
          </sc-for>
        </tbody>
      </table>
      <div style="display:flex;justify-content:center;align-items:center;gap:var(--space-3);margin-top:var(--space-3)">
        <button class="btn btn-ghost btn-icon" onClick="{{ gotoLogPrev }}">◄</button>
        <span style="font-size:13px;color:var(--color-neutral-600)">صفحة {{ logPageLabel }}</span>
        <button class="btn btn-ghost btn-icon" onClick="{{ gotoLogNext }}">►</button>
      </div>
    </sc-if>

    <sc-if value="{{ isScan }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">تسجيل الحضور — مراقب الموقع</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-5)">مسح باركود/QR العامل عند الدخول والخروج في مواقع الشركة</p>
      <div style="display:grid;grid-template-columns:auto 1fr;gap:var(--space-6);align-items:flex-start">
        <div class="phone">
          <div class="phone-screen">
            <div style="font-size:13px;color:var(--color-neutral-600);text-align:center">{{ nowLabel }}</div>
            <div class="scan-target">{{ scanHint }}</div>
            <button class="btn btn-primary btn-block" onClick="{{ doScan }}">مسح باركود عامل</button>
            <div class="field">
              <label>أو أدخل كود العامل يدويًا</label>
              <input class="input" placeholder="14710001" value="{{ manualCode }}" onChange="{{ onManualChange }}"/>
            </div>
            <button class="btn btn-secondary btn-block" onClick="{{ doManualScan }}">تسجيل يدوي</button>
          </div>
        </div>
        <div class="card elev-sm">
          <div class="card-title" style="margin-bottom:var(--space-2)">سجل حركات اليوم</div>
          <table class="dt">
            <thead><tr><th>كود العامل</th><th>الاسم</th><th>الوقت</th><th>النوع</th></tr></thead>
            <tbody>
              <sc-for list="{{ scanLog }}" as="s" hint-placeholder-count="4">
                <tr>
                  <td>{{ s.code }}</td>
                  <td>{{ s.name }}</td>
                  <td>{{ s.time }}</td>
                  <td><span class="tag {{ s.tagClass }}">{{ s.typeLabel }}</span></td>
                </tr>
              </sc-for>
            </tbody>
          </table>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{ isSarak }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">سجل السراكي اليومي والمطابقة</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">مطابقة تلقائية بين بيان العمل المسجَّل وحركات الحضور الفعلية</p>
      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-3)">إضافة سرك جديد</div>
        <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3);align-items:end">
          <div class="field"><label>العامل</label>
            <select class="input" value="{{ newSarakWorker }}" onChange="{{ onNewSarakWorker }}">
              <option value="">اختر عامل</option>
              <sc-for list="{{ sarakWorkerOptions }}" as="w" hint-placeholder-count="6">
                <option value="{{ w.code }}">{{ w.code }} — {{ w.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>التاريخ</label>
            <input class="input date-input" type="date" lang="en-GB" dir="ltr" min="{{ punchMinIso }}" max="{{ punchMaxIso }}" value="{{ newSarakDateIso }}" onChange="{{ onNewSarakDate }}"/>
          </div>
          <div class="field"><label>بيان العمل</label><input class="input" placeholder="مثال: صيانة المعدات" value="{{ newSarakWork }}" onChange="{{ onNewSarakWork }}"/></div>
          <div class="field"><label>الوردية</label>
            <select class="input" value="{{ newSarakShift }}" onChange="{{ onNewSarakShift }}">
              <sc-for list="{{ shifts }}" as="sh" hint-placeholder-count="2">
                <option value="{{ sh.code }}">{{ sh.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>المنطقة</label>
            <select class="input" value="{{ newSarakRegion }}" onChange="{{ onNewSarakRegion }}">
              <option value="">اختر المنطقة</option>
              <sc-for list="{{ sarakRegionOptions }}" as="rg" hint-placeholder-count="5">
                <option value="{{ rg.code }}">{{ rg.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>الإضافي (ساعة)</label><input class="input" dir="ltr" placeholder="0" value="{{ newSarakOt }}" onChange="{{ onNewSarakOt }}"/></div>
          <div class="field"><label>الخصم (ساعة)</label><input class="input" dir="ltr" placeholder="0" value="{{ newSarakDed }}" onChange="{{ onNewSarakDed }}"/></div>
          <div class="field" style="grid-column:span 2"><label>ملاحظات الإدارى</label><input class="input" placeholder="سبب الإضافي أو الخصم" value="{{ newSarakNote }}" onChange="{{ onNewSarakNote }}"/></div>
          <button class="btn btn-primary" onClick="{{ addSarak }}">+ إضافة</button>
        </div>
        <div style="margin-top:var(--space-3);font-size:12px;color:var(--color-neutral-600)">اليومية 9 ساعات منها ساعة راحة (8 ساعات عمل) وما زاد عنها إضافي · أوقات الدخول والخروج وساعات العمل تُدخل وتُحسب من صفحة «بيان عمل السركى»</div>
      </div>
      <table class="dt">
        <thead><tr><th>كود السرك</th><th>التاريخ</th><th>العامل</th><th>المهنة</th><th>المنطقة</th><th>بيان العمل</th><th>الوردية</th><th>الإضافي (س)</th><th>الخصم (س)</th><th>ملاحظات الإدارى</th><th>حالة المطابقة</th></tr></thead>
        <tbody>
          <sc-for list="{{ sarakPage }}" as="s" hint-placeholder-count="6">
            <tr>
              <td>{{ s.code }}</td>
              <td>{{ s.date }}</td>
              <td>{{ s.workerName }}</td>
              <td>{{ s.profession }}</td>
              <td>{{ s.region }}</td>
              <td>{{ s.work }}</td>
              <td>{{ s.shiftName }}</td>
              <td><input class="input" dir="ltr" style="padding:4px 6px;font-size:13px;max-width:72px" value="{{ s.ot }}" onChange="{{ s.onOt }}"/></td>
              <td><input class="input" dir="ltr" style="padding:4px 6px;font-size:13px;max-width:72px" value="{{ s.ded }}" onChange="{{ s.onDed }}"/></td>
              <td><input class="input" style="padding:4px 6px;font-size:13px;min-width:170px" value="{{ s.note }}" onChange="{{ s.onNote }}"/></td>
              <td><span class="tag {{ s.statusClass }}">{{ s.status }}</span></td>
            </tr>
          </sc-for>
        </tbody>
      </table>
    </sc-if>

    <sc-if value="{{ isSarakPrint }}" hint-placeholder-val="{{ false }}">
      <div class="no-print">
        <h1 style="font-size:26px;margin-bottom:2px">طباعة مستخلص سركي</h1>
        <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">حدّد المنطقة والمشروع والفترة الزمنية — يُطبع كشف كل عامل في صفحة A4 مستقلة بإجمالياته، وتُختم النسخة بصفحة "إحصائيات فئات"</p>
        <div class="toolbar">
          <div class="field" style="max-width:170px"><label>من تاريخ</label>
            <input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ spFrom }}" onChange="{{ onSpFrom }}"/>
          </div>
          <div class="field" style="max-width:170px"><label>إلى تاريخ</label>
            <input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ spTo }}" onChange="{{ onSpTo }}"/>
          </div>
          <div class="field" style="max-width:220px"><label>المنطقة</label>
            <select class="input" value="{{ spRegion }}" onChange="{{ onSpRegion }}">
              <option value="all">كل المناطق</option>
              <sc-for list="{{ spRegionOptions }}" as="rg" hint-placeholder-count="4">
                <option value="{{ rg.name }}">{{ rg.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="max-width:260px"><label>المشروع</label>
            <select class="input" value="{{ spProject }}" onChange="{{ onSpProject }}">
              <sc-for list="{{ spProjectOptions }}" as="po" hint-placeholder-count="4">
                <option value="{{ po.code }}">{{ po.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="max-width:200px"><label>بحث بكود أو اسم العامل</label>
            <input class="input" placeholder="اتركه فارغًا لطباعة الكل" value="{{ spSearch }}" onChange="{{ onSpSearch }}"/>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <label style="font-size:12px;color:var(--color-neutral-700)">نموذج الطباعة</label>
            <div class="segwrap">
              <button class="{{ spFinClass }}" onClick="{{ onSpFormFin }}">الإدارة المالية</button>
              <button class="{{ spTecClass }}" onClick="{{ onSpFormTec }}">المكتب الفني</button>
            </div>
          </div>
          <span class="tag tag-accent" style="align-self:center">{{ spCountLabel }}</span>
          <button class="btn btn-primary" style="margin-inline-start:auto;align-self:center" onClick="{{ doPrint }}">🖨 طباعة (A4)</button>
        </div>
      </div>

      <sc-for list="{{ spPages }}" as="p" hint-placeholder-count="2">
        <div class="sheet">
          <div class="sheet-head">
            <img src="brand-logo.png" alt="الشروق"/>
            <div style="text-align:center;flex:1">
              <div style="font-family:var(--font-heading);font-size:16px;font-weight:700;color:var(--color-accent)">الشروق للمقاولات العمومية والتوريدات للقطاع العام</div>
              <div style="font-size:12.5px;font-weight:600;margin-top:3px">مستخلص سركي العمالة — {{ spFormLabel }}</div>
              <div style="font-size:12px;margin-top:3px">المنطقة: <b>{{ spRegionLabel }}</b> &nbsp;·&nbsp; المشروع: <b>{{ p.projLabel }}</b></div>
            </div>
            <div style="font-size:10.5px;line-height:1.8;text-align:left;min-width:140px">
              <div>الفترة: <b dir="ltr">{{ spPeriod }}</b></div>
              <div>صفحة: <b dir="ltr">{{ p.pageLabel }}</b></div>
            </div>
          </div>

          <div class="wbar">
            <span>كود الموظف: <b dir="ltr">{{ p.workerCode }}</b></span>
            <span>اسم الموظف: <b>{{ p.workerName }}</b></span>
            <span>المهنة: <b>{{ p.profession }}</b></span>
            <span>الفئة: <b>{{ p.cat }}</b></span>
            <span>قيمة الفئة: <b dir="ltr">{{ p.catVal }}</b> ج.م/ساعة</span>
            <span>الإدارة: <b>{{ p.dept }}</b></span>
          </div>

          <table class="sheet-tbl tight">
            <thead>
              <tr>
                <th style="width:22px">م</th>
                <th style="width:62px">كود الموظف</th>
                <th style="text-align:right;width:105px">اسم الموظف</th>
                <th style="text-align:right;width:88px">المهنة</th>
                <th style="width:30px">الفئة</th>
                <th style="width:50px">قيمة الفئة</th>
                <th style="width:52px">اليوم</th>
                <th style="width:62px">التاريخ</th>
                <th style="text-align:right">بيان العمل</th>
                <th style="width:42px">الدخول</th>
                <th style="width:42px">الخروج</th>
                <th style="width:42px">ساعات العمل</th>
                <th style="width:38px">إضافي</th>
                <th style="width:38px">خصم</th>
                <th style="width:82px">{{ spColLabel }}</th>
              </tr>
            </thead>
            <tbody>
              <sc-for list="{{ p.rows }}" as="r" hint-placeholder-count="6">
                <tr>
                  <td style="text-align:center">{{ r.no }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.workerCode }}</td>
                  <td class="clip" title="{{ r.workerName }}">{{ r.workerName }}</td>
                  <td class="clip" title="{{ r.profession }}">{{ r.profession }}</td>
                  <td style="text-align:center">{{ r.cat }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.catVal }}</td>
                  <td style="text-align:center">{{ r.day }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.date }}<div style="font-size:8px;color:var(--color-accent-2);font-weight:700">{{ r.nightTag }}</div></td>
                  <td class="work-cell" title="{{ r.work }}">{{ r.work }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.inTime }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.outTime }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.hours }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.ot }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.ded }}</td>
                  <td style="font-size:9px">{{ r.mark }}</td>
                </tr>
              </sc-for>
              <tr class="sheet-total">
                <td colspan="8" style="text-align:right">إجمالي العامل — عدد الأيام: {{ p.days }} · ساعات بعد 12 ليلاً: {{ p.totalNight }} · إجمالي الاستحقاق: {{ p.totalAmount }} ج.م</td>
                <td style="text-align:center">الإجماليات</td>
                <td></td>
                <td></td>
                <td style="text-align:center" dir="ltr">{{ p.totalHours }}</td>
                <td style="text-align:center" dir="ltr">{{ p.totalOt }}</td>
                <td style="text-align:center" dir="ltr">{{ p.totalDed }}</td>
                <td></td>
              </tr>
            </tbody>
          </table>

          <div class="sheet-sign">
            <sc-for list="{{ spSigners }}" as="g" hint-placeholder-count="4">
              <div style="text-align:center">
                <div style="font-weight:600;color:var(--color-accent);font-size:12px">{{ g.role }}</div>
                <div style="height:18px"></div>
                <div style="border-top:1px solid var(--color-text);padding-top:4px;font-size:11px;color:var(--color-neutral-600)">الاسم / التوقيع</div>
              </div>
            </sc-for>
          </div>
        </div>
      </sc-for>

      <div class="sheet">
        <div class="sheet-head">
          <img src="brand-logo.png" alt="الشروق"/>
          <div style="text-align:center;flex:1">
            <div style="font-family:var(--font-heading);font-size:16px;font-weight:700;color:var(--color-accent)">إحصائيات فئات</div>
            <div style="font-size:12px;margin-top:3px">المنطقة: <b>{{ spRegionLabel }}</b> &nbsp;·&nbsp; المشروع: <b>{{ spProjectLabel }}</b></div>
          </div>
          <div style="font-size:10.5px;line-height:1.8;text-align:left;min-width:140px">
            <div>الفترة: <b dir="ltr">{{ spPeriod }}</b></div>
            <div>عدد العمال: <b dir="ltr">{{ spCount }}</b></div>
          </div>
        </div>

        <table class="sheet-tbl tight">
          <thead>
            <tr>
              <th style="text-align:right">المهنة</th>
              <th style="width:34px">الفئة</th>
              <th style="width:78px">عدد اليوميات للبند بالساعة</th>
              <th style="width:86px">إجمالي حساب اليوميات للبند</th>
              <th style="width:74px">إجمالي عدد صافي الإضافي</th>
              <th style="width:86px">إجمالي عدد الساعات بعد الساعة 12 ليلاً</th>
              <th style="width:74px">إجمالي عدد ساعات الخصم</th>
              <th style="width:86px">إجمالي حسابات ساعات الخصم</th>
              <th style="width:90px">إجمالي البند</th>
            </tr>
          </thead>
          <tbody>
            <sc-for list="{{ spStats }}" as="c" hint-placeholder-count="5">
              <tr>
                <td>{{ c.profession }}</td>
                <td style="text-align:center">{{ c.cat }}</td>
                <td style="text-align:center" dir="ltr">{{ c.hours }}</td>
                <td style="text-align:center" dir="ltr">{{ c.hoursAmount }}</td>
                <td style="text-align:center" dir="ltr">{{ c.ot }}</td>
                <td style="text-align:center" dir="ltr">{{ c.night }}</td>
                <td style="text-align:center" dir="ltr">{{ c.ded }}</td>
                <td style="text-align:center" dir="ltr">{{ c.dedAmount }}</td>
                <td style="text-align:center;font-weight:700" dir="ltr">{{ c.total }}</td>
              </tr>
            </sc-for>
            <tr class="sheet-total">
              <td colspan="2" style="text-align:right">الإجمالي العام</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.hours }}</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.hoursAmount }}</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.ot }}</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.night }}</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.ded }}</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.dedAmount }}</td>
              <td style="text-align:center" dir="ltr">{{ spGrand.total }}</td>
            </tr>
          </tbody>
        </table>

        <div class="sheet-sign">
          <sc-for list="{{ spSigners }}" as="g" hint-placeholder-count="4">
            <div style="text-align:center">
              <div style="font-weight:600;color:var(--color-accent);font-size:12px">{{ g.role }}</div>
              <div style="height:18px"></div>
              <div style="border-top:1px solid var(--color-text);padding-top:4px;font-size:11px;color:var(--color-neutral-600)">الاسم / التوقيع</div>
            </div>
          </sc-for>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{ isAlerts }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">التنبيهات والاستثناءات</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">حالات تحتاج مراجعة مشرف قبل ترحيلها للأجور</p>
      <sc-for list="{{ allAlerts }}" as="a" hint-placeholder-count="5">
        <div class="card elev-sm" style="margin-bottom:var(--space-3);display:flex;justify-content:space-between;align-items:center;gap:12px">
          <div style="display:flex;gap:12px;align-items:flex-start">
            <span class="tag {{ a.tagClass }}">{{ a.level }}</span>
            <div>
              <div style="font-size:15px">{{ a.text }}</div>
              <div style="font-size:12px;color:var(--color-neutral-600)">{{ a.time }} · {{ a.workerCode }}</div>
            </div>
          </div>
          <button class="btn btn-secondary">مراجعة</button>
        </div>
      </sc-for>
    </sc-if>

    <sc-if value="{{ isUpload }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">رفع بيانات وملفات</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">رفع جداول إكسل/CSV (عمال، سراكي، حضور وانصراف، مهن) وربطها بجزء السيستم المناسب لتحديث بياناته</p>
      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-3)">رفع جدول جديد</div>
        <div style="display:grid;grid-template-columns:1.4fr 1fr auto;gap:var(--space-3);align-items:end">
          <div class="field"><label>الملف</label><input class="input" type="file" accept=".xlsx,.xls,.csv" onChange="{{ onUploadFile }}"/></div>
          <div class="field">
            <label>ربط البيانات بـ</label>
            <select class="input" value="{{ newUploadTarget }}" onChange="{{ onNewUploadTarget }}">
              <option value="workers">العمال</option>
              <option value="sarak">السراكي</option>
              <option value="attendance">الحضور والانصراف</option>
              <option value="professions">المهن وفئات الأجر</option>
              <option value="contractors">المقاولون</option>
            </select>
          </div>
          <button class="btn btn-primary" onClick="{{ addUpload }}">رفع وربط</button>
        </div>
      </div>
      <table class="dt">
        <thead><tr><th>اسم الملف</th><th>مرتبط بـ</th><th>تاريخ الرفع</th><th>الحالة</th></tr></thead>
        <tbody>
          <sc-for list="{{ uploadedFiles }}" as="f" hint-placeholder-count="3">
            <tr><td>{{ f.name }}</td><td>{{ f.targetLabel }}</td><td>{{ f.date }}</td><td><span class="tag tag-accent">مرتبط</span></td></tr>
          </sc-for>
        </tbody>
      </table>
    </sc-if>


    <sc-if value="{{ isProjectSheet }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">نموذج بيانات المشروع</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">يُغذَّى آليًا من سجلات العمال — بديل مباشر لملف الإكسل اليدوي، وقابل للتصدير بنفس الأعمدة</p>
      <div class="toolbar">
        <span class="tag tag-accent">{{ scopeLabel }}</span>
        <button class="btn btn-primary" style="margin-inline-start:auto">تصدير Excel</button>
      </div>
      <table class="dt">
        <thead><tr><th>م</th><th>الكود</th><th>الاسم</th><th>رقم البطاقة</th><th>المهنة</th><th>الإدارة/القسم</th><th>الفئة الحالية</th><th>البدل</th><th>اجمالى اليوميات</th><th>المشروع</th></tr></thead>
        <tbody>
          <sc-for list="{{ workers }}" as="w" hint-placeholder-count="8">
            <tr>
              <td>{{ $index }}</td><td>{{ w.code }}</td><td>{{ w.name }}</td><td>{{ w.card }}</td><td>{{ w.profession }}</td>
              <td>{{ w.dept }}</td><td>{{ w.category }}</td><td>{{ w.allowance }}</td><td>{{ w.dailyTotal }}</td><td>{{ w.project }}</td>
            </tr>
          </sc-for>
        </tbody>
      </table>
    </sc-if>

    <sc-if value="{{ isDayTotals }}" hint-placeholder-val="{{ false }}">
      <div class="no-print">
        <h1 style="font-size:26px;margin-bottom:2px">تقرير عن إجمالي يوميات العمل للعمال</h1>
        <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">تقرير A4 عمودي للطباعة والمراجعة — لكل كود عامل: المهنة وعدد اليوميات والقيمة المستحقة عن الفترة، مع خانة توقيع أو بصمة</p>
        <div class="toolbar">
          <div class="field" style="max-width:170px"><label>من تاريخ</label>
            <input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ dtFrom }}" onChange="{{ onDtFrom }}"/>
          </div>
          <div class="field" style="max-width:170px"><label>إلى تاريخ</label>
            <input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ dtTo }}" onChange="{{ onDtTo }}"/>
          </div>
          <div class="field" style="max-width:240px"><label>المشروع</label>
            <select class="input" value="{{ dtProject }}" onChange="{{ onDtProject }}">
              <sc-for list="{{ dtProjectOptions }}" as="po" hint-placeholder-count="4">
                <option value="{{ po.code }}">{{ po.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="max-width:220px"><label>المقاول</label>
            <select class="input" value="{{ dtContractor }}" onChange="{{ onDtContractor }}">
              <sc-for list="{{ dtContractorOptions }}" as="co" hint-placeholder-count="4">
                <option value="{{ co.code }}">{{ co.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="max-width:200px"><label>المنطقة</label>
            <select class="input" value="{{ dtRegion }}" onChange="{{ onDtRegion }}">
              <option value="all">كل المناطق</option>
              <sc-for list="{{ dtRegionOptions }}" as="rg" hint-placeholder-count="4">
                <option value="{{ rg.name }}">{{ rg.name }}</option>
              </sc-for>
            </select>
          </div>
          <span class="tag tag-accent" style="align-self:center">{{ dtCountLabel }}</span>
          <button class="btn btn-primary" style="margin-inline-start:auto;align-self:center" onClick="{{ doPrint }}">🖨 طباعة (A4)</button>
          <button class="btn btn-secondary" style="align-self:center" onClick="{{ doPrint }}">⬇ تصدير PDF</button>
        </div>
      </div>

      <sc-for list="{{ dtPages }}" as="pg" hint-placeholder-count="1">
        <div class="sheet-p">
          <div class="sheet-head">
            <div style="line-height:1.6">
              <div style="font-family:var(--font-heading);font-size:15px;font-weight:700;color:var(--color-accent)">شركة الشروق للمقاولات العمومية والتوريدات للقطاع العام</div>
              <div style="font-size:11px;color:var(--color-neutral-700)">مقاولات عمومية · توريدات · أعمال إنشائية وتشغيل</div>
            </div>
            <img src="brand-logo.png" alt="الشروق"/>
          </div>

          <div style="text-align:center;margin:8px 0 10px">
            <div style="display:inline-block;background:var(--color-accent);color:#fff;font-family:var(--font-heading);font-size:15px;font-weight:700;padding:6px 28px">تقرير عن إجمالي يوميات العمل للعمال</div>
          </div>

          <div style="display:flex;justify-content:flex-start;margin-bottom:8px">
            <table style="border-collapse:collapse;font-size:11.5px">
              <tbody>
                <tr>
                  <td style="border:1px solid var(--color-accent);background:var(--color-accent-100);font-weight:700;color:var(--color-accent-700);padding:4px 12px">عن الفترة</td>
                  <td style="border:1px solid var(--color-accent);padding:4px 8px">من</td>
                  <td style="border:1px solid var(--color-accent);padding:4px 12px;font-weight:700" dir="ltr">{{ dtFromLabel }}</td>
                  <td style="border:1px solid var(--color-accent);padding:4px 8px">إلى</td>
                  <td style="border:1px solid var(--color-accent);padding:4px 12px;font-weight:700" dir="ltr">{{ dtToLabel }}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <table style="width:100%;border-collapse:collapse;font-size:11.5px;margin-bottom:8px">
            <tbody>
              <tr>
                <td style="border:1px solid var(--color-accent-200);background:var(--color-accent-100);font-weight:700;color:var(--color-accent-700);padding:5px 8px;width:70px">اسم المشروع</td>
                <td style="border:1px solid var(--color-accent-200);padding:5px 8px;font-weight:600">{{ dtProjectLabel }}</td>
                <td style="border:1px solid var(--color-accent-200);background:#e8f1ea;font-weight:700;color:#2e4b37;padding:5px 8px;width:66px">اسم المقاول</td>
                <td style="border:1px solid var(--color-accent-200);padding:5px 8px;font-weight:600">{{ dtContractorLabel }}</td>
                <td style="border:1px solid var(--color-accent-200);background:#f4eee2;font-weight:700;color:#5a4a2c;padding:5px 8px;width:52px">المنطقة</td>
                <td style="border:1px solid var(--color-accent-200);padding:5px 8px;font-weight:600">{{ dtRegionLabel }}</td>
              </tr>
            </tbody>
          </table>

          <table class="sheet-tbl">
            <thead>
              <tr>
                <th style="width:26px">م</th>
                <th style="width:74px">كود العامل</th>
                <th style="text-align:right">اسم العامل</th>
                <th style="text-align:right;width:96px">المهنة</th>
                <th style="width:60px">عدد اليوميات</th>
                <th style="width:86px">القيمة المستحقة</th>
                <th style="width:110px">التوقيع / البصمة</th>
              </tr>
            </thead>
            <tbody>
              <sc-for list="{{ pg.rows }}" as="r" hint-placeholder-count="10">
                <tr>
                  <td style="text-align:center">{{ r.no }}</td>
                  <td style="text-align:center" dir="ltr">{{ r.code }}</td>
                  <td class="clip" title="{{ r.name }}">{{ r.name }}</td>
                  <td class="clip" title="{{ r.profession }}">{{ r.profession }}</td>
                  <td style="text-align:center;font-weight:700" dir="ltr">{{ r.days }}</td>
                  <td style="text-align:center;font-weight:700;color:var(--color-accent-700)" dir="ltr">{{ r.amount }}</td>
                  <td class="sig-cell"></td>
                </tr>
              </sc-for>
            </tbody>
          </table>

          <sc-if value="{{ pg.isLast }}" hint-placeholder-val="{{ true }}">
            <div style="display:flex;align-items:center;justify-content:space-between;border:2px solid var(--color-accent);background:var(--color-accent-100);margin-top:10px">
              <div style="padding:7px 12px;font-family:var(--font-heading);font-size:13.5px;font-weight:700;color:var(--color-accent-700)">إجمالي المستحق للمقاول عن الفترة</div>
              <div style="padding:7px 18px;font-size:15px;font-weight:700;color:var(--color-accent);background:var(--color-accent-200)" dir="ltr">{{ dtGrandTotal }}</div>
            </div>
            <div style="margin-top:6px;font-size:11px;color:var(--color-neutral-700)">عدد العمال: <b dir="ltr">{{ dtWorkerCount }}</b> · إجمالي اليوميات: <b dir="ltr">{{ dtTotalDays }}</b></div>
            <div class="sheet-sign" style="grid-template-columns:repeat(3,1fr);margin-top:16px">
              <sc-for list="{{ dtSigners }}" as="g" hint-placeholder-count="3">
                <div style="text-align:center">
                  <div style="font-weight:600;color:var(--color-accent);font-size:12px">{{ g.role }}</div>
                  <div style="height:26px"></div>
                  <div style="border-top:1px solid var(--color-text);padding-top:4px;font-size:11px;color:var(--color-neutral-600)">الاسم / التوقيع</div>
                </div>
              </sc-for>
            </div>
          </sc-if>

          <div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;color:var(--color-neutral-700);border-top:1px solid var(--color-accent-200);padding-top:4px;margin-top:14px">
            <span>تاريخ ووقت الطباعة: {{ dtPrintedAt }}</span>
            <span dir="ltr">{{ pg.pageLabel }}</span>
          </div>
        </div>
      </sc-for>
    </sc-if>

    <sc-if value="{{ isReports }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">التقارير وتصدير البيانات</h1>
      <div class="toolbar">
        <button class="btn btn-primary">تصدير Excel</button>
        <button class="btn btn-secondary">تصدير PDF</button>
        <button class="btn btn-ghost">اتصال Power Query</button>
      </div>
      <div class="kpi-grid" style="grid-template-columns:repeat(3,1fr)">
        <sc-for list="{{ reportKpis }}" as="k" hint-placeholder-count="3">
          <div class="card elev-sm">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-2)">
              <div>
                <div class="card-kicker">{{ k.label }}</div>
                <div style="font-size:11px;color:var(--color-neutral-500);letter-spacing:.04em">{{ k.code }}</div>
              </div>
              <button class="btn btn-ghost" title="حذف المؤشر" style="padding:2px 8px;font-size:15px;line-height:1;color:var(--color-accent-2-700)" onClick="{{ k.deleteHandler }}">✕</button>
            </div>
            <div class="kpi-num">{{ k.value }}</div>
            <div class="card-meta">{{ k.meta }}</div>
          </div>
        </sc-for>
      </div>
      <div class="card elev-sm">
        <div class="card-title" style="margin-bottom:var(--space-3)">بطاقة الأداء المتوازن — لمحة</div>
        <table class="dt">
          <thead><tr><th>المحور</th><th>المؤشر</th><th>الهدف</th><th>الفعلي</th></tr></thead>
          <tbody>
            <tr><td>مالي</td><td>تكلفة العمالة/الموازنة</td><td>≤ 100%</td><td>{{ bsc.cost }}</td></tr>
            <tr><td>عمليات</td><td>زمن المطابقة الآلية</td><td>&lt; 1 يوم</td><td>{{ bsc.match }}</td></tr>
            <tr><td>مقاولون</td><td>التزام الحضور</td><td>≥ 95%</td><td>{{ bsc.commit }}</td></tr>
            <tr><td>نمو</td><td>تبني القراء الرقمي</td><td>100% مواقع</td><td>{{ bsc.adoption }}</td></tr>
          </tbody>
        </table>
      </div>
    </sc-if>

    <sc-if value="{{ isSarakWork }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">اضافة بيانات عمل سركي</h1>
      <p style="color:var(--color-neutral-600);margin-bottom:var(--space-4)">تفاصيل العمل اليومى مع الإدارة/القسم التابع له والوردية وأوقات الدخول والخروج وساعات العمل — كهرباء أو ميكانيكا أو مدنى أو غيره</p>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-3)">تسجيل بيان عمل</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)">
          <div class="field"><label>تاريخ العمل</label><input class="input date-input" type="date" lang="en-GB" dir="ltr" value="{{ swDate }}" onChange="{{ onSwDate }}"/></div>
          <div class="field"><label>الإدارة / القسم</label>
            <select class="input" value="{{ swDept }}" onChange="{{ onSwDept }}">
              <sc-for list="{{ swDeptOptions }}" as="d" hint-placeholder-count="8">
                <option value="{{ d }}">{{ d }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>عدد العمال على العمل</label><input class="input" placeholder="0" dir="ltr" value="{{ swCount }}" onChange="{{ onSwCount }}"/></div>
          <div class="field"><label>الوردية</label>
            <select class="input" value="{{ swShift }}" onChange="{{ onSwShift }}">
              <sc-for list="{{ shifts }}" as="sh" hint-placeholder-count="2">
                <option value="{{ sh.code }}">{{ sh.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>وقت الدخول</label><input class="input" type="time" dir="ltr" value="{{ swIn }}" onChange="{{ onSwIn }}"/></div>
          <div class="field"><label>وقت الخروج</label><input class="input" type="time" dir="ltr" value="{{ swOut }}" onChange="{{ onSwOut }}"/></div>
          <div class="field"><label>ساعات العمل (تُحسب آليًا)</label><input class="input" dir="ltr" value="{{ swHours }}" readOnly="{{ true }}" style="background:var(--color-neutral-100)"/></div>
          <div class="field"><label>القطاع الجغرافى</label>
            <select class="input" value="{{ swSector }}" onChange="{{ onSwSector }}">
              <sc-for list="{{ swSectorOptions }}" as="so" hint-placeholder-count="7">
                <option value="{{ so.code }}">{{ so.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>المشروع / الموقع</label>
            <select class="input" value="{{ swProject }}" onChange="{{ onSwProject }}">
              <option value="">اختر المشروع</option>
              <sc-for list="{{ swProjectOptions }}" as="po" hint-placeholder-count="6">
                <option value="{{ po.code }}">{{ po.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field"><label>المنطقة</label>
            <select class="input" value="{{ swRegion }}" onChange="{{ onSwRegion }}">
              <option value="">اختر المنطقة</option>
              <sc-for list="{{ swRegionOptions }}" as="rg" hint-placeholder-count="5">
                <option value="{{ rg.code }}">{{ rg.name }}</option>
              </sc-for>
            </select>
          </div>
          <div class="field" style="grid-column:span 3"><label>تفاصيل العمل المنفّذ</label><textarea class="input" rows="3" placeholder="مثال: تمديد مواسير كهرباء وتركيب لوحات إنارة بالدور الأرضى" value="{{ swDetails }}" onChange="{{ onSwDetails }}" style="resize:vertical;min-height:80px"></textarea></div>
        </div>
        <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)">
          <button class="btn btn-primary" onClick="{{ addSarakWork }}" disabled="{{ swSaveDisabled }}">+ إضافة بيان العمل</button>
          <span style="font-size:13px;color:var(--color-neutral-600)">{{ swNote }}</span>
        </div>
      </div>

      <div style="display:flex;gap:var(--space-3);align-items:center;margin-bottom:var(--space-2);flex-wrap:wrap">
        <div class="card-title">بيانات العمل المسجّلة</div>
        <span class="tag tag-neutral">{{ swCountLabel }}</span>
        <div style="display:flex;gap:var(--space-2);margin-inline-start:auto">
          <button class="btn btn-primary" onClick="{{ goPrintFin }}">🖨 طباعة — نموذج الإدارة المالية</button>
          <button class="btn btn-secondary" onClick="{{ goPrintTec }}">🖨 طباعة — نموذج المكتب الفني</button>
        </div>
      </div>
      <table class="dt">
        <thead><tr><th>التاريخ</th><th>الإدارة / القسم</th><th>تفاصيل العمل</th><th>المشروع</th><th>القطاع</th><th>المنطقة</th><th>العمال</th><th>الوردية</th><th>دخول</th><th>خروج</th><th>ساعات العمل</th><th></th></tr></thead>
        <tbody>
          <sc-for list="{{ sarakWorkRows }}" as="r" hint-placeholder-count="3">
            <tr>
              <td dir="ltr">{{ r.date }}</td>
              <td><span class="tag tag-accent">{{ r.dept }}</span></td>
              <td style="max-width:380px">{{ r.details }}</td>
              <td>{{ r.projectName }}</td>
              <td>{{ r.sectorName }}</td>
              <td>{{ r.region }}</td>
              <td>{{ r.count }}</td>
              <td>{{ r.shiftName }}</td>
              <td dir="ltr">{{ r.inTime }}</td>
              <td dir="ltr">{{ r.outTime }}</td>
              <td dir="ltr">{{ r.hours }}</td>
              <td><button class="btn btn-ghost btn-icon" title="حذف" onClick="{{ r.remove }}">✕</button></td>
            </tr>
          </sc-for>
        </tbody>
      </table>
    </sc-if>

    <sc-if value="{{ isUsers }}" hint-placeholder-val="{{ false }}">
      <h1 style="font-size:26px">المستخدمون والصلاحيات</h1>
      <div class="toolbar">
        <div class="segwrap">
          <button class="{{ roleAdminClass }}" onClick="{{ roleHandlers.admin }}">إدارة عليا</button>
          <button class="{{ roleSupClass }}" onClick="{{ roleHandlers.sup }}">إشراف</button>
          <button class="{{ roleEntryClass }}" onClick="{{ roleHandlers.entry }}">إدخال بيانات</button>
        </div>
      </div>
      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title">صلاحيات: {{ roleView }}</div>
        <div class="card-body">{{ roleDescription }}</div>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4);border-top:3px solid var(--color-accent)">
        <div class="card-kicker">مصفوفة الصلاحيات</div>
        <div class="card-title" style="margin-bottom:var(--space-1)">ما يستطيع كل دور فعله</div>
        <div class="card-meta" style="margin-bottom:var(--space-3)">مدخلو البيانات يمكن تمكينهم من إضافة عامل جديد وتعريف بصمته — فيُحتسب حضوره بالبصمة بعد ذلك</div>
        <table class="dt">
          <thead><tr><th>الصلاحية</th><th>إدارة عليا</th><th>إشراف</th><th>إدخال بيانات</th></tr></thead>
          <tbody>
            <sc-for list="{{ permRows }}" as="p" hint-placeholder-count="6">
              <tr>
                <td>{{ p.label }}</td>
                <td><input type="checkbox" checked="{{ p.adminOn }}" onChange="{{ p.toggleAdmin }}"/></td>
                <td><input type="checkbox" checked="{{ p.supOn }}" onChange="{{ p.toggleSup }}"/></td>
                <td><input type="checkbox" checked="{{ p.entryOn }}" onChange="{{ p.toggleEntry }}"/></td>
              </tr>
            </sc-for>
          </tbody>
        </table>
      </div>

      <div class="card elev-sm" style="margin-bottom:var(--space-4)">
        <div class="card-title" style="margin-bottom:var(--space-3)">إضافة مستخدم جديد</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:var(--space-3);align-items:end">
          <div class="field"><label>الاسم</label><input class="input" placeholder="اسم المستخدم" value="{{ newUserName }}" onChange="{{ onNewUserName }}"/></div>
          <div class="field">
            <label>الدور</label>
            <select class="input" value="{{ newUserRole }}" onChange="{{ onNewUserRole }}">
              <option value="إدارة عليا">إدارة عليا</option>
              <option value="إشراف">إشراف</option>
              <option value="إدخال بيانات">إدخال بيانات</option>
            </select>
          </div>
          <div class="field">
            <label>المشروع (النطاق)</label>
            <select class="input" value="{{ newUserProject }}" onChange="{{ onNewUserProject }}">
              <sc-for list="{{ projects }}" as="pr" hint-placeholder-count="3">
                <option value="{{ pr.code }}">{{ pr.code }} — {{ pr.name }}</option>
              </sc-for>
            </select>
          </div>
          <button class="btn btn-primary" onClick="{{ addUser }}">+ إضافة</button>
        </div>
        <p style="font-size:12px;color:var(--color-neutral-600);margin-top:var(--space-2)">دور "إشراف" أو "إدخال بيانات" يقيّد المستخدم بالمشروع المختار فقط — إضافة وتعديل ومراقبة بيانات هذا المشروع دون غيره. "إدارة عليا" وحدها تصل لكل المشاريع.</p>
      </div>

      <table class="dt">
        <thead><tr><th>المستخدم</th><th>الدور</th><th>النطاق</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
          <sc-for list="{{ users }}" as="u" hint-placeholder-count="4">
            <tr>
              <td>{{ u.name }}</td>
              <td><span class="tag tag-accent">{{ u.role }}</span></td>
              <td>{{ u.scope }}</td>
              <td>نشط</td>
              <td><button class="btn btn-ghost btn-icon" title="حذف" onClick="{{ u.deleteHandler }}">✕</button></td>
            </tr>
          </sc-for>
        </tbody>
      </table>
    </sc-if>

  </main>
</div>

</x-dc>
<script type="text/x-dc" data-dc-script>

class Component extends DCLogic {
  state = {
    screen: 'dashboard',
    anSector: 'all',
    anSite: 'all',
    workerSearch: '',
    wfSector: 'all',
    wfProject: 'all',
    wfContractor: 'all',
    manualCode: '',
    scanLog: [],
    roleView: 'إدارة عليا',
    contractorIndex: 0,
    contractors: [],
    cnSector: 'all', cnProject: 'all',
    newContractorCode: '', newContractorName: '', newContractorNamePick: '', newContractorProject: '', newContractorType: 'عمالة باطن', newContractorDate: '',
    selectedWorkerCode: null,
    profPage: 0,
    logDate: 'all',
    logPage: 0,
    addedProfessions: [],
    newProfName: '', newProfCategory: 'B',
    catRates: {
      A: { label: 'إشراف', daily: '256', allowance: '30' },
      B: { label: 'فني/صنايعي', daily: '176', allowance: '20' },
      C: { label: 'مساعد', daily: '128', allowance: '15' },
      D: { label: 'عمالة عادية', daily: '112', allowance: '10' },
      E: { label: 'تحت التدريب', daily: '88', allowance: '0' },
    },
    addedSaraks: [],
    sarakAdj: {},
    newSarakOt: '', newSarakDed: '', newSarakNote: '', newSarakRegion: '',
    anDept: 'all',
    spDate: '', spRegion: 'all', spFrom: '', spTo: '', spProject: 'all', spForm: 'fin', spSearch: '',
    editWorkerCode: null, ew: null,
    newProfDept: 'التنفيذ', newProfPay: '', newProfEff: '',
    chProf: '', chCat: 'B', chEff: '', catHistory: [],
    qProject: '', qRef: '', qAmount: '', qDate: '', qFile: '', quotes: [],
    catExtra: {},
    paSector: 'all', paRegion: '', paValue: '', projAllowances: [],
    trSearch: '', trToProject: '', trProfession: '', trDept: '', trCategory: '', trAllowance: '', trEff: '', trNote: '',
    transfers: [], hlSearch: '',
    newSarakWorker: '', newSarakDate: '', newSarakWork: '', newSarakShift: '8To17G',
    uploadedFiles: [],
    newUploadName: '', newUploadTarget: 'workers',
    logSearch: '', logDept: 'all', logType: 'all', logSector: 'all', logProject: 'all',
    sectorHeads: null, shSector: '10101', shHeadDraft: null,
    sarakWorks: [], swDate: '', swSector: '10101', swProject: '', swDept: 'التنفيذ', swDetails: '', swCount: '',
    swShift: '8To17G', swIn: '08:00', swOut: '17:00', swRegion: '',
    perms: {
      'إدارة عليا': { addWorker: true, fp: true, editWorker: true, sarakWork: true, approve: true, reports: true },
      'إشراف': { addWorker: true, fp: true, editWorker: true, sarakWork: true, approve: true, reports: true },
      'إدخال بيانات': { addWorker: true, fp: true, editWorker: true, sarakWork: true, approve: false, reports: false },
    },
    hiddenKpis: [],
    showWorkerForm: false,
    wDraft: {},
    lastSaved: '',
    catRatesSaved: '',
    workerRev: 0,
    nw: { name: '', code: '', profession: '', card: '', birthDate: '', birthPlace: '', allowance: '0', category: 'B', rate: '22', hours: '8', status: 'نشط', sector: 'all', project: '', regDate: '', startDate: '', contractor: '' },
    users: [],
    newUserName: '', newUserRole: 'إدخال بيانات', newUserProject: '',
  };
  PAGE_SIZE = 5;
  PROF_PAGE_SIZE = 15;
  WORKER_VIEW_LIMIT = 60;

  componentDidMount() { if (!/nodata/.test(location.search)) this.loadRealData(); }

  async loadRealData() {
    let d;
    const __u = (window.__resources && window.__resources.eadrsData) || 'data/eadrs-data.json';
    try { d = await (await fetch(__u)).json(); } catch (e) { return; }
    const projName = {}; d.projects.forEach(p => { projName[p.code] = p.name; });

    // المهن من ملف "العمالة الذاتى" (ورقة المهن) — كود المهنة + الإدارة
    this.professionsData = d.professions.map((j, i) => {
      const isSup = j.name.includes('مشرف') || j.name.includes('رئيس') || j.name.includes('مراقب');
      const isHelper = j.name.includes('مساعد') || j.name.startsWith('عامل');
      const category = isSup ? 'A' : (isHelper ? 'C' : 'B');
      const hourRate = isSup ? 32 : (isHelper ? 16 : 22);
      return { code: j.code || String(200 + i), name: j.name, dept: j.dept || 'غير محدد', category,
        hourRate, overtimeRate: hourRate, deductionRate: hourRate, stopped: false };
    });
    this.sarakJobTitles = this.professionsData.map(p => p.name);
    const catOf = {}; this.professionsData.forEach(p => { catOf[p.name] = p.category; });

    this.projectsData = d.projects.map(p => ({ code: p.code, name: p.name }));

    const SELF = 'SELF';
    const selfW = d.selfWorkers.map(r => ({
      code: r[0], name: r[1], card: r[2], profession: r[3], dept: (r[4] || 'غير محدد').trim(),
      project: r[5], manager: r[6], startDate: r[7], regDate: r[7],
      contractor: SELF, source: 'ذاتى',
      category: (!/^\d+(\.\d+)?$/.test(String(r[8] || '').trim()) && String(r[8] || '').trim())
        || ((/([A-E])\s*$/.exec(String(r[3] || '')) || [])[1]) || catOf[r[3]] || 'B',
      catValue: /^\d+(\.\d+)?$/.test(String(r[8] || '').trim()) ? String(r[8]).trim() : (r[9] || ''),
      allowance: Number(r[10] || 0), hours: '8', status: 'نشط', dailyTotal: 0,
    }));
    const conW = d.contractorWorkers.map(r => ({
      code: r[0], name: r[1], card: r[2], profession: r[3] || 'عامل', dept: 'عمالة مقاولين',
      project: r[5], contractor: r[4], source: 'باطن', category: catOf[r[3]] || 'C', allowance: 0, dailyTotal: 0,
    }));
    this.workers = selfW.concat(conW);

    this.state.contractors = [{ code: SELF, name: 'العمالة الذاتية — الشروق', type: 'عمالة ذاتى', active: true, regDate: '—', project: '', count: selfW.length }]
      .concat(d.contractors.map(c => ({ code: c.code, name: c.name, type: 'عمالة باطن', active: true,
        regDate: '—', project: c.project, projectName: projName[c.project] || '—', count: c.count })));

    this.sarakRecords = (d.sarak || []).map(r => ({ ...r, region: r.region || 'الادارة' }));

    if (d.attendance && d.attendance.rows && d.attendance.rows.length) {
      let id = 30000;
      this.attendanceLogData = d.attendance.rows.map(r => ({ id: id++, code: r[0], date: r[1], time: r[2], type: r[3] }));
      this.attendanceDates = d.attendance.dates;
      this.attendanceSource = 'سجل بصمة فعلي — ' + d.attendance.rows.length.toLocaleString('en-US') + ' حركة · ' +
        d.attendance.dates.length + ' يوم (' + d.attendance.dates[0] + ' – ' + d.attendance.dates[d.attendance.dates.length - 1] + ')';
    } else {
      this.attendanceLogData = [];
      this.attendanceDates = [];
      this.attendanceSource = 'لم يُرفع ملف بصمة بعد — سجل الحركات فارغ';
    }
    this._codeToWorker = null; this._dashCacheKey = null; this._byContractor = null;
    this._logKey = null; this._wmKey = null; this._profBars = null; this._enrolledWorkers = null;
    this.setState({ workerRev: this.state.workerRev + 1, dataLoaded: true, datasetInfo: {
      projects: this.projectsData.length, professions: this.professionsData.length,
      contractors: this.state.contractors.length, self: selfW.length, sub: conW.length, total: this.workers.length,
    } });
  }

  // سجل حضور تشغيلي مولَّد من العمالة الفعلية (٥ أيام) لحين ربط أجهزة البصمة
  buildAttendance(workers) {
    const out = []; let id = 30000;
    const days = [];
    for (let i = 2; i >= 0; i--) { const dt = new Date(2026, 7, 26 - i); days.push(dt.toLocaleDateString('en-GB')); }
    days.forEach((date, di) => {
      const isToday = di === days.length - 1;
      workers.forEach((w, wi) => {
        if (!isToday && wi % 4 !== 0) return; // الأيام السابقة بعينة أخف
        const h = (wi * 17 + di * 41) % 100;
        if (h < 11) return; // غياب ~11%
        const inM = 7 * 60 + 30 + ((wi * 3 + di) % 35);
        out.push({ id: id++, code: w.code, date, time: this.hm(inM), type: 'In' });
        if (h >= 15) out.push({ id: id++, code: w.code, date, time: this.hm(17 * 60 + ((wi * 5) % 30)), type: 'Out' });
      });
    });
    return out;
  }
  hm(m) { return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0'); }

  addProfession() {
    const s = this.state;
    if (!s.newProfName.trim()) return;
    const pay = Number(s.newProfPay) || this.catDaily(s.newProfCategory) || 176;
    const hr = Math.round((pay / this.DAY_HOURS) * 100) / 100;
    this.setState(st => ({
      addedProfessions: [...st.addedProfessions, {
        code: String(300 + st.addedProfessions.length), name: st.newProfName.trim(), category: st.newProfCategory,
        dept: st.newProfDept, dailyPay: pay, effDate: st.newProfEff ? st.newProfEff.split('-').reverse().join('/') : this.today(),
        hourRate: hr, overtimeRate: hr, deductionRate: hr, stopped: false,
      }],
      newProfName: '', newProfPay: '', newProfEff: '',
    }));
    return;
    const cr = s.catRates[s.newProfCategory] || {};
    const hourRate = this.catHour(s.newProfCategory) || 22.0;
    const prof = {
      code: String(300 + s.addedProfessions.length), name: s.newProfName.trim(), category: s.newProfCategory,
      hourRate, overtimeRate: hourRate, deductionRate: hourRate,
      stopped: false,
    };
    this.setState({ addedProfessions: [...s.addedProfessions, prof], newProfName: '' });
  }

  workers = [];

  analytics() {
    const scope = this.anScope();
    const key = 'an|' + this.state.workerRev + '|' + scope.key;
    if (this._anKey === key) return this._an;
    const logs = this.attendanceLogData;
    const dates = this.attendanceDates || [...new Set(logs.map(l => l.date))];
    if (!this._codeToWorker) { this._codeToWorker = {}; this.workers.forEach(w => { this._codeToWorker[w.code] = w; }); }
    let known = this._codeToWorker, scopedWorkers = this.workers;
    if (scope.projects || scope.dept) {
      known = {}; scopedWorkers = [];
      this.workers.forEach(w => {
        if (scope.projects && !scope.projects.has(this.projectOfWorker(w))) return;
        if (scope.dept && w.dept !== scope.dept) return;
        known[w.code] = w; scopedWorkers.push(w);
      });
    }
    const scopedForce = scopedWorkers.length;
    const enrolled = new Set(logs.filter(l => known[l.code]).map(l => l.code));
    const byDate = {};
    dates.forEach(d => { byDate[d] = { date: d, present: new Set(), pairs: {}, late: 0, early: 0 }; });
    const mins = (t) => { const p = String(t).split(':'); return (+p[0] || 0) * 60 + (+p[1] || 0); };
    logs.forEach(l => {
      const b = byDate[l.date]; if (!b || !known[l.code]) return;
      const p = b.pairs[l.code] || (b.pairs[l.code] = { in: null, out: null });
      if (l.type === 'In') { b.present.add(l.code); const m = mins(l.time); if (p.in === null || m < p.in) p.in = m; }
      else { const m = mins(l.time); if (p.out === null || m > p.out) p.out = m; }
    });
    const N = enrolled.size;
    const NDiv = N || 1;
    const wdNames = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
    const days = dates.map(d => {
      const b = byDate[d];
      const present = b.present.size;
      let hrs = 0, cnt = 0, late = 0, incomplete = 0;
      Object.values(b.pairs).forEach(p => {
        if (p.in !== null && p.out !== null && p.out > p.in) { hrs += (p.out - p.in) / 60; cnt++; }
        else if (p.in !== null) incomplete++;
        if (p.in !== null && p.in > 8 * 60 + 15) late++;
      });
      const dm = d.split('/');
      const jsd = new Date(+dm[2], +dm[1] - 1, +dm[0]);
      return {
        date: d, weekday: wdNames[jsd.getDay()], dow: jsd.getDay(),
        present, absent: Math.max(0, N - present),
        rate: Math.round((present / NDiv) * 100),
        avgHours: cnt ? (hrs / cnt).toFixed(1) : '—',
        late, incomplete,
      };
    });
    const maxPresent = Math.max(1, ...days.map(d => d.present));
    const chart = days.map(d => ({ ...d,
      h: Math.round((d.present / maxPresent) * 100),
      barColor: d.rate >= 85 ? 'var(--color-accent)' : d.rate >= 65 ? 'var(--color-accent-700)' : 'var(--color-accent-2-700)',
      dayLabel: d.date.slice(0, 2),
    }));
    const avgRate = days.length ? Math.round(days.reduce((a, d) => a + d.rate, 0) / days.length) : 0;
    const avgPresent = days.length ? Math.round(days.reduce((a, d) => a + d.present, 0) / days.length) : 0;
    const best = days.slice().sort((a, b) => b.present - a.present)[0] || {};
    const worst = days.slice().sort((a, b) => a.present - b.present)[0] || {};
    const wd = {};
    days.forEach(d => { (wd[d.dow] = wd[d.dow] || { dow: d.dow, weekday: d.weekday, sum: 0, n: 0, late: 0 }); wd[d.dow].sum += d.present; wd[d.dow].n++; wd[d.dow].late += d.late; });
    const weekdays = Object.values(wd).sort((a, b) => a.dow - b.dow).map(x => ({
      weekday: x.weekday, avg: Math.round(x.sum / x.n), n: x.n,
      rate: Math.round((x.sum / x.n / NDiv) * 100), late: Math.round(x.late / x.n),
      factor: avgPresent ? ((x.sum / x.n) / avgPresent).toFixed(2) : '1.00',
    }));
    // اتجاه خطي على آخر 7 أيام + معامل يوم الأسبوع
    const tail = days.slice(-7);
    let slope = 0;
    if (tail.length > 1) {
      const n = tail.length, mx = (n - 1) / 2, my = tail.reduce((a, d) => a + d.present, 0) / n;
      let num = 0, den = 0;
      tail.forEach((d, i) => { num += (i - mx) * (d.present - my); den += (i - mx) * (i - mx); });
      slope = den ? num / den : 0;
    }
    const baseLast = tail.length ? tail[tail.length - 1].present : avgPresent;
    const lastDate = dates[dates.length - 1];
    const ld = lastDate ? lastDate.split('/') : ['01', '08', '2026'];
    const forecast = [1, 2, 3, 4, 5].map(k => {
      const dt = new Date(+ld[2], +ld[1] - 1, +ld[0] + k);
      const wf = weekdays.find(w => w.weekday === wdNames[dt.getDay()]);
      const f = wf ? parseFloat(wf.factor) : 1;
      const raw = (baseLast + slope * k) * (0.35 + 0.65 * f);
      const val = Math.max(0, Math.min(N, Math.round(raw)));
      const conf = Math.max(55, 92 - k * 6 - (wf ? 0 : 10));
      return {
        date: ('0' + dt.getDate()).slice(-2) + '/' + ('0' + (dt.getMonth() + 1)).slice(-2) + '/' + dt.getFullYear(),
        weekday: wdNames[dt.getDay()],
        present: val.toLocaleString('en-US'),
        absent: Math.max(0, N - val).toLocaleString('en-US'),
        rate: Math.round((val / NDiv) * 100) + '%',
        conf: conf + '%',
        h: Math.round((val / maxPresent) * 100),
        tagClass: conf >= 80 ? 'tag-accent' : 'tag-outline',
      };
    });
    const trendLabel = slope > 0.5 ? 'اتجاه صاعد' : slope < -0.5 ? 'اتجاه هابط' : 'مستقر';
    const trendColor = slope < -0.5 ? 'var(--color-accent-2-700)' : 'var(--color-accent-700)';
    // تحليل بحسب الدور والمشروع
    const dash = this.dashboardAnalytics();
    const lastBucket = byDate[dates[dates.length - 1]];
    const presentNow = lastBucket ? lastBucket.present : new Set();
    const roleDefs = [
      { key: 'supervisor', label: 'المشرفون' },
      { key: 'technician', label: 'الفنيون' },
      { key: 'helper', label: 'المساعدون' },
      { key: 'worker', label: 'العمالة العامة' },
    ];
    const roleAcc = {}; roleDefs.forEach(d => { roleAcc[d.key] = { count: 0, present: 0 }; });
    scopedWorkers.forEach(w => {
      const a = roleAcc[this.roleOf(w.profession)];
      if (!a) return;
      a.count++; if (presentNow.has(w.code)) a.present++;
    });
    const roleAnalysis = roleDefs.map(d => {
      const a = roleAcc[d.key];
      return { label: d.label, count: a.count, present: a.present,
        countLabel: a.count.toLocaleString('en-US'),
        rate: a.count ? Math.round((a.present / a.count) * 100) : 0,
        absent: Math.max(0, a.count - a.present).toLocaleString('en-US') };
    });
    const projectAnalysis = dash.projectRows
      .filter(p => !scope.projects || scope.projects.has(p.code))
      .slice(0, 8).map(p => ({
      ...p,
      registeredLabel: p.registered.toLocaleString('en-US'),
      absent: Math.max(0, (p.enrolled || 0) - p.present).toLocaleString('en-US'),
    }));
    const totalRisk = days.reduce((a, d) => a + d.incomplete, 0);
    const out = {
      an: {
        totalForce: scopedForce.toLocaleString('en-US'),
        enrolled: N.toLocaleString('en-US'),
        coverage: Math.round((N / Math.max(1, scopedForce)) * 100) + '%',
        scopeLabel: scope.label,
        avgPresent: avgPresent.toLocaleString('en-US'),
        avgAbsent: (days.length ? Math.max(0, N - avgPresent) : 0).toLocaleString('en-US'),
        avgRate: days.length ? avgRate + '%' : '—',
        absenceRate: days.length ? (100 - avgRate) + '%' : '—',
        dayCount: days.length,
        period: days.length ? days[0].date + ' – ' + days[days.length - 1].date : '—',
        bestLabel: (best.date || '—') + ' (' + (best.present || 0).toLocaleString('en-US') + ')',
        worstLabel: (worst.date || '—') + ' (' + (worst.present || 0).toLocaleString('en-US') + ')',
        avgLate: days.length ? Math.round(days.reduce((a, d) => a + d.late, 0) / days.length).toLocaleString('en-US') : '0',
        incomplete: totalRisk.toLocaleString('en-US'),
        trendLabel, trendColor,
        slopeLabel: (slope >= 0 ? '+' : '') + slope.toFixed(1) + ' عامل/يوم',
        nextDayLabel: forecast.length ? forecast[0].date + ' — ' + forecast[0].present + ' حاضر متوقع' : '—',
      },
      chart, weekdays, forecast, roleAnalysis, projectAnalysis,
      dayRows: days.slice().reverse().map(d => ({ ...d,
        presentLabel: d.present.toLocaleString('en-US'),
        absentLabel: d.absent.toLocaleString('en-US'),
        rateLabel: d.rate + '%',
        tagClass: d.rate >= 85 ? 'tag-accent' : d.rate >= 65 ? 'tag-outline' : 'tag-accent-2',
      })),
    };
    this._anKey = key; this._an = out;
    return out;
  }

  setCatRate(key, field, value) {
    this.setState(st => ({ catRates: { ...st.catRates, [key]: { ...st.catRates[key], [field]: value } } }));
  }

  toIso(dmy) {
    if (!dmy) return '';
    const m = String(dmy).match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!m) return /^\d{4}-\d{2}-\d{2}$/.test(dmy) ? dmy : '';
    return m[3] + '-' + m[2].padStart(2, '0') + '-' + m[1].padStart(2, '0');
  }

  toDmy(iso) {
    if (!iso) return '';
    const m = String(iso).match(/^(\d{4})-(\d{2})-(\d{2})$/);
    return m ? m[3] + '/' + m[2] + '/' + m[1] : iso;
  }

  sarakRecords = [];

  allAlertsData = [];

  projectsData = [];

  addSarak() {
    const s = this.state;
    if (!s.newSarakWorker || !s.newSarakDate.trim()) return;
    const w = this.workers.find(x => x.code === s.newSarakWorker);
    if (!w) return;
    const logsForDay = this.attendanceLogData.filter(l => l.code === w.code && l.date === s.newSarakDate.trim());
    const ins = logsForDay.filter(l => l.type === 'In').map(l => l.time).sort();
    const outs = logsForDay.filter(l => l.type === 'Out').map(l => l.time).sort();
    const hasIn = ins.length > 0, hasOut = outs.length > 0;
    const mins = t => Number(t.slice(0, 2)) * 60 + Number(t.slice(3));
    const worked = hasIn && hasOut ? Math.max(0, mins(outs[outs.length - 1]) - mins(ins[0])) : 0;
    let status, statusClass;
    if (hasIn && hasOut) {
      if (worked < 6 * 60) { status = 'استثناء: ساعات ناقصة'; statusClass = 'tag-accent-2'; }
      else { status = 'مطابق'; statusClass = 'tag-accent'; }
    } else if (!hasIn && !hasOut) { status = 'بدون بصمة — غياب'; statusClass = 'tag-outline'; }
    else { status = hasIn ? 'استثناء: بصمة خروج مفقودة' : 'استثناء: بصمة دخول مفقودة'; statusClass = 'tag-accent-2'; }
    const rec = {
      code: '1' + (600 + s.addedSaraks.length) + '-1', date: s.newSarakDate.trim(), workerCode: w.code, workerName: w.name,
      profession: w.profession, work: s.newSarakWork.trim() || 'بيان عمل يومي', shift: s.newSarakShift, status, statusClass,
      ot: (s.newSarakOt || '').trim() || '0', ded: (s.newSarakDed || '').trim() || '0', note: (s.newSarakNote || '').trim(),
      region: s.newSarakRegion ? this.regionName(s.newSarakRegion) : '—',
      inTime: hasIn ? ins[0] : '—', outTime: hasOut ? outs[outs.length - 1] : '—',
      hours: worked ? (Math.floor(worked / 60) + ':' + String(worked % 60).padStart(2, '0')) : '—',
    };
    this.setState({ addedSaraks: [...s.addedSaraks, rec], newSarakWorker: '', newSarakDate: '', newSarakWork: '', newSarakOt: '', newSarakDed: '', newSarakNote: '' });
  }

  ALLOWANCE_DEPTS = ['الكهرباء', 'الالكتروميكانيك', 'الكهروميكانيك', 'المخازن', 'المساحة', 'الصيانة', 'الصيانة والمعدات', 'المعدات', 'H.S.E', 'السلامة والصحة المهنية', 'السكن', 'الأمن', 'الشئون الادارية', 'الشئون الإدارية'];
  CAT_DESC = {
    A: 'إشراف وقيادة موقع — مسؤولية إدارة فريق، تُصرف لها بدلات كاملة، وتُحتسب ساعات الإشراف ضمن اليومية.',
    B: 'فني / صنايعي متخصص — يتطلب شهادة مهنية أو خبرة معتمدة، ويستحق بدل المنطقة عند التبعية لإدارة مستحقة.',
    C: 'مساعد فني — يعمل تحت إشراف مباشر، بدل منطقة مخفّض وساعات إضافي بنفس قيمة الساعة العادية.',
    D: 'عمالة عادية — أعمال مساندة عامة دون اشتراط مهارة، أقل شريحة بدلات.',
    E: 'تحت التدريب — فترة اختبار، لا يستحق بدل منطقة ولا بدلات ثابتة حتى انتهاء التدريب.',
  };
  isAllowanceDept(d) { return this.ALLOWANCE_DEPTS.some(x => (d || '').includes(x) || x.includes(d || '§')); }
  // استخراج تاريخ الميلاد من الرقم القومي المصري (14 رقمًا): ق س س ش ش ي ي م م ...
  birthFromCard(card) {
    const c = String(card || '').replace(/\D/g, '');
    if (c.length !== 14) return '';
    const cent = c[0] === '2' ? 1900 : c[0] === '3' ? 2000 : c[0] === '1' ? 1800 : 0;
    if (!cent) return '';
    const y = cent + Number(c.slice(1, 3)), m = Number(c.slice(3, 5)), dd = Number(c.slice(5, 7));
    if (m < 1 || m > 12 || dd < 1 || dd > 31) return '';
    const dt = new Date(Date.UTC(y, m - 1, dd));
    if (dt.getUTCMonth() !== m - 1 || dt.getUTCDate() !== dd || y > new Date().getFullYear()) return '';
    return y + '-' + String(m).padStart(2, '0') + '-' + String(dd).padStart(2, '0');
  }
  GOV_CODES = { '01': 'القاهرة', '02': 'الإسكندرية', '03': 'بورسعيد', '04': 'السويس', '11': 'دمياط', '12': 'الدقهلية', '13': 'الشرقية', '14': 'القليوبية', '15': 'كفر الشيخ', '16': 'الغربية', '17': 'المنوفية', '18': 'البحيرة', '19': 'الإسماعيلية', '21': 'الجيزة', '22': 'بني سويف', '23': 'الفيوم', '24': 'المنيا', '25': 'أسيوط', '26': 'سوهاج', '27': 'قنا', '28': 'أسوان', '29': 'الأقصر', '31': 'البحر الأحمر', '32': 'الوادي الجديد', '33': 'مطروح', '34': 'شمال سيناء', '35': 'جنوب سيناء', '88': 'خارج الجمهورية' };
  placeFromCard(card) {
    const c = String(card || '').replace(/\D/g, '');
    return c.length === 14 ? (this.GOV_CODES[c.slice(7, 9)] || '') : '';
  }
  ageFrom(v) {
    if (!v) return '—';
    const d = new Date(v);
    if (isNaN(d)) return '—';
    const t = new Date();
    let a = t.getFullYear() - d.getFullYear();
    const m = t.getMonth() - d.getMonth();
    if (m < 0 || (m === 0 && t.getDate() < d.getDate())) a--;
    return a >= 0 && a < 120 ? String(a) + ' سنة' : '—';
  }
  today() { return new Date().toLocaleDateString('en-GB'); }
  findByCard(card) {
    const c = (card || '').trim();
    if (c.length < 6) return null;
    return this.workers.find(w => (w.card || '').trim() === c) || null;
  }
  openEditWorker(code) {
    const w = this.workers.find(x => x.code === code);
    if (!w) return;
    this.setState({
      editWorkerCode: code,
      ew: {
        code: w.code, name: w.name || '', card: w.card || '',
        birthDate: w.birthDate || this.birthFromCard(w.card), birthPlace: w.birthPlace || this.placeFromCard(w.card),
        profession: w.profession || '', dept: w.dept || 'غير محدد', category: w.category || 'B',
        rate: String(w.rate != null ? w.rate : (this.catDaily(w.category) || '')), allowance: String(w.allowance || 0),
        housing: String(w.housing || 0), transport: String(w.transport || 0),
        hours: String(w.hours || '8'), status: w.status || 'نشط', regDate: w.regDate || '',
      },
    });
  }
  saveEditWorker() {
    const e = this.state.ew;
    if (!e) return;
    const w = this.workers.find(x => x.code === e.code);
    if (!w) return;
    const before = { profession: w.profession, dept: w.dept, category: w.category, allowance: w.allowance };
    Object.assign(w, {
      name: e.name, card: e.card, birthDate: e.birthDate, birthPlace: e.birthPlace,
      profession: e.profession, dept: e.dept, category: e.category,
      rate: e.rate, allowance: Number(e.allowance) || 0,
      housing: Number(e.housing) || 0, transport: Number(e.transport) || 0,
      hours: e.hours, status: e.status, regDate: e.regDate,
      leaveDate: e.status === 'غير نشط' ? (w.leaveDate || this.today()) : '',
    });
    const changed = before.profession !== w.profession || before.dept !== w.dept || before.category !== w.category || String(before.allowance) !== String(w.allowance);
    const log = changed ? [{
      code: w.code, name: w.name, kind: 'تعديل بيانات', from: before.dept || '—', to: w.dept || '—',
      profession: w.profession, dept: w.dept, category: w.category, allowance: String(w.allowance),
      eff: this.today(), created: this.today(), note: 'تعديل من شاشة بيانات الموظفين',
    }] : [];
    this._codeToWorker = null;
    this.setState(st => ({ editWorkerCode: null, ew: null, workerRev: st.workerRev + 1, transfers: [...log, ...st.transfers] }));
  }
  doTransfer() {
    const s = this.state;
    const w = this.resolveTrWorker();
    if (!w || !s.trToProject || !s.trEff) return;
    const fromProject = this.projectLabelOf(w.project);
    const toProject = this.projectLabelOf(s.trToProject);
    const entry = {
      code: w.code, name: w.name, kind: 'نقل', from: fromProject, to: toProject,
      profession: s.trProfession || w.profession, dept: s.trDept || w.dept,
      category: s.trCategory || w.category,
      allowance: s.trAllowance !== '' ? s.trAllowance : String(w.allowance || 0),
      eff: s.trEff.split('-').reverse().join('/'), created: this.today(), note: s.trNote || '—',
    };
    w.project = s.trToProject;
    if (s.trProfession) w.profession = s.trProfession;
    if (s.trDept) w.dept = s.trDept;
    if (s.trCategory) w.category = s.trCategory;
    if (s.trAllowance !== '') w.allowance = Number(s.trAllowance) || 0;
    this._codeToWorker = null;
    this.setState(st => ({
      transfers: [entry, ...st.transfers], workerRev: st.workerRev + 1,
      trToProject: '', trProfession: '', trDept: '', trCategory: '', trAllowance: '', trNote: '',
    }));
  }
  resolveTrWorker() {
    const q = (this.state.trSearch || '').trim();
    if (!q) return null;
    const code = q.split('—')[0].trim();
    return this.workers.find(w => w.code === code) || this.workers.find(w => w.name === q) || this.workers.find(w => (w.name || '').includes(q)) || null;
  }
  projectLabelOf(code) {
    if (!code) return '—';
    const g = this.sectorOfProject(code);
    return g.siteName && g.siteName !== '—' ? (code + ' — ' + g.siteName) : String(code);
  }
  allProjectOptions() {
    const m = this.projectSectorMap();
    return Object.keys(m).sort((a, b) => Number(a) - Number(b)).map(k => ({ code: k, name: k + ' — ' + m[k].siteName }));
  }
  hrVals() {
    const s = this.state;
    const nw = s.nw || {};
    const dup = this.findByCard(nw.card);
    const ew = s.ew;
    const catKeys = ['A', 'B', 'C', 'D', 'E'];
    const extra = s.catExtra || {};
    const setExtra = (k, f, v) => this.setState(st => ({ catExtra: { ...st.catExtra, [k]: { ...(st.catExtra[k] || {}), [f]: v } } }));

    const deptCounts = {};
    this.workers.forEach(w => { const d = w.dept || 'غير محدد'; deptCounts[d] = (deptCounts[d] || 0) + 1; });
    const allowanceCheck = Object.keys(deptCounts).map(d => {
      const el = this.isAllowanceDept(d);
      const qualified = el ? Math.round(deptCounts[d] * 0.86) : 0;
      return {
        dept: d, count: deptCounts[d], eligibleLabel: el ? 'مستحقة' : 'غير مستحقة',
        tagClass: el ? 'tag-accent' : 'tag-outline', qualified: el ? qualified : 0,
        amount: el ? (qualified * 20).toLocaleString('en-US') : '0',
      };
    }).sort((a, b) => b.count - a.count);

    const trW = this.resolveTrWorker();
    const hq = (s.hlSearch || '').trim();
    const history = (s.transfers || []).filter(h => !hq || h.code.includes(hq) || (h.name || '').includes(hq))
      .map(h => ({ ...h, tagClass: h.kind === 'نقل' ? 'tag-accent' : 'tag-accent-2' }));

    return {
      onNwBirthDate: (e) => this.setNw('birthDate', e.target.value),
      onNwBirthPlace: (e) => this.setNw('birthPlace', e.target.value),
      nwBirthDateAuto: nw.birthDate || this.birthFromCard(nw.card),
      nwBirthPlaceAuto: nw.birthPlace || this.placeFromCard(nw.card),
      nwAge: this.ageFrom(nw.birthDate || this.birthFromCard(nw.card)),
      nwCardNote: (nw.card || '').replace(/\D/g, '').length === 14
        ? (this.birthFromCard(nw.card) ? '✔ تم استخراج تاريخ الميلاد ومحل الميلاد آلياً من الرقم القومي' : '⚠ الرقم القومي غير صحيح — تحقق من الأرقام')
        : 'أدخل 14 رقماً — يُستخرج تاريخ الميلاد والسن ومحل الميلاد تلقائياً',
      nwDupFound: !!dup,
      nwDup: dup ? {
        code: dup.code, name: dup.name, profession: dup.profession || '—', category: dup.category || '—',
        dept: dup.dept || '—', project: this.projectLabelOf(dup.project), contractor: dup.contractor || '—', status: dup.status || 'نشط',
      } : { code: '', name: '', profession: '', category: '', dept: '', project: '', contractor: '', status: '' },
      nwDupOpen: () => dup && this.setState({ selectedWorkerCode: dup.code, showWorkerForm: false }),
      nwDupClear: () => this.setNw('card', ''),

      isEditingWorker: !!ew,
      ew: ew || { code: '', name: '', card: '', birthDate: '', birthPlace: '', profession: '', dept: '', category: 'B', rate: '', allowance: '', housing: '', transport: '', hours: '8', status: 'نشط', regDate: '' },
      ewBirthDateAuto: (ew && (ew.birthDate || this.birthFromCard(ew.card))) || '',
      ewBirthPlaceAuto: (ew && (ew.birthPlace || this.placeFromCard(ew.card))) || '',
      ewAge: this.ageFrom(ew && (ew.birthDate || this.birthFromCard(ew.card))),
      ewNote: 'كل الحقول قابلة للتعديل عدا كود الموظف · أي تغيير في المهنة أو الإدارة أو الفئة يُسجَّل في السجل الوظيفي',
      onEw: ['name', 'card', 'birthDate', 'birthPlace', 'profession', 'dept', 'category', 'rate', 'allowance', 'housing', 'transport', 'hours', 'status', 'regDate']
        .reduce((o, k) => { o[k] = (e) => { const v = e.target.value; this.setState(st => ({ ew: { ...st.ew, [k]: v } })); }; return o; }, {}),
      closeEditWorker: () => this.setState({ editWorkerCode: null, ew: null }),
      saveEditWorker: () => this.saveEditWorker(),

      newProfDept: s.newProfDept, onNewProfDept: (e) => this.setState({ newProfDept: e.target.value }),
      newProfPay: s.newProfPay, onNewProfPay: (e) => this.setState({ newProfPay: e.target.value }),
      newProfPayHint: String(this.catDaily(s.newProfCategory) || 176),
      newProfEff: s.newProfEff, onNewProfEff: (e) => this.setState({ newProfEff: e.target.value }),
      newProfCatDesc: this.CAT_DESC[s.newProfCategory] || '',
      allProfTitles: [...new Set([...this.professionsData.map(p => p.name), ...s.addedProfessions.map(p => p.name)])],
      chProf: s.chProf, onChProf: (e) => this.setState({ chProf: e.target.value }),
      chCat: s.chCat, onChCat: (e) => this.setState({ chCat: e.target.value }),
      chEff: s.chEff, onChEff: (e) => this.setState({ chEff: e.target.value }),
      chDisabled: !s.chProf || !s.chEff,
      addCatChange: () => {
        const p = [...this.professionsData, ...s.addedProfessions].find(x => x.name === s.chProf);
        const eff = s.chEff.split('-').reverse().join('/');
        const active = new Date(s.chEff) <= new Date();
        this.setState(st => ({
          catHistory: [{ prof: s.chProf, from: (p && p.category) || '—', to: s.chCat, eff, created: this.today(), active }, ...st.catHistory],
          chProf: '', chEff: '',
        }));
      },
      hasCatHistory: (s.catHistory || []).length > 0,
      catHistory: (s.catHistory || []).map(h => ({
        ...h, statusLabel: h.active ? 'سارية' : 'مؤجلة للتاريخ',
        tagClass: h.active ? 'tag-accent' : 'tag-outline',
      })),

      allProjectOptions: this.allProjectOptions(),
      qProject: s.qProject, onQProject: (e) => this.setState({ qProject: e.target.value }),
      qRef: s.qRef, onQRef: (e) => this.setState({ qRef: e.target.value }),
      qAmount: s.qAmount, onQAmount: (e) => this.setState({ qAmount: e.target.value }),
      qDate: s.qDate, onQDate: (e) => this.setState({ qDate: e.target.value }),
      onQFile: (e) => { const f = e.target.files && e.target.files[0]; if (f) this.setState({ qFile: f.name }); },
      qFileLabel: s.qFile ? '📄 ' + s.qFile : 'لم يتم اختيار ملف بعد (PDF / Excel / صورة)',
      qDisabled: !s.qProject || !s.qFile,
      addQuote: () => this.setState(st => ({
        quotes: [{
          project: st.qProject, projectName: this.projectLabelOf(st.qProject), ref: st.qRef || '—',
          amount: st.qAmount ? Number(st.qAmount).toLocaleString('en-US') + ' ج.م' : '—',
          date: st.qDate ? st.qDate.split('-').reverse().join('/') : '—',
          fileName: st.qFile, uploaded: this.today(),
        }, ...st.quotes],
        qRef: '', qAmount: '', qDate: '', qFile: '',
      })),
      hasQuotes: (s.quotes || []).length > 0,
      quotes: s.quotes || [],

      fixedAllowRows: catKeys.map(k => {
        const cr = (s.catRates || {})[k] || {};
        const ex = extra[k] || {};
        const h = ex.housing != null ? ex.housing : '0';
        const t = ex.transport != null ? ex.transport : '0';
        return {
          key: k, label: cr.label || k, daily: cr.daily || '—',
          housing: h, transport: t,
          total: String((Number(cr.daily) || 0) + (Number(h) || 0) + (Number(t) || 0)) + ' ج.م',
          onHousing: (e) => setExtra(k, 'housing', e.target.value),
          onTransport: (e) => setExtra(k, 'transport', e.target.value),
        };
      }),

      paSector: s.paSector, onPaSector: (e) => this.setState({ paSector: e.target.value, paRegion: '' }),
      paRegion: s.paRegion, onPaRegion: (e) => this.setState({ paRegion: e.target.value }),
      paRegionOptions: this.regionOptions(s.paSector),
      paValue: s.paValue, onPaValue: (e) => this.setState({ paValue: e.target.value }),
      paDisabled: !s.paRegion || !s.paValue,
      addProjAllowance: () => {
        const sec = this.sectorDefs.find(x => x.code === s.paSector);
        const rg = this.regionOptions(s.paSector).find(x => x.code === s.paRegion);
        this.setState(st => ({
          projAllowances: [{
            sectorName: sec ? sec.name : 'كل القطاعات', regionName: rg ? rg.name : st.paRegion,
            value: st.paValue, deptsLabel: 'الإدارات المعتمدة فقط (10 إدارات)',
          }, ...st.projAllowances],
          paValue: '', paRegion: '',
        }));
      },
      hasProjAllowances: (s.projAllowances || []).length > 0,
      projAllowances: s.projAllowances || [],
      eligibleDepts: ['الكهرباء', 'الكهروميكانيك', 'المخازن', 'المساحة', 'الصيانة', 'المعدات', 'السلامة والصحة المهنية HSE', 'السكن', 'الأمن', 'الشئون الإدارية'],
      allowanceCheck,

      trSearch: s.trSearch, onTrSearch: (e) => this.setState({ trSearch: e.target.value }),
      trWorkerOptions: this.workers.slice(0, 400).map(w => ({ value: w.code + ' — ' + w.name })),
      trFromProject: trW ? this.projectLabelOf(trW.project) : '— اختر عاملاً أولاً',
      trCurrent: trW ? ((trW.profession || '—') + ' · فئة ' + (trW.category || '—')) : '—',
      trToProject: s.trToProject, onTrToProject: (e) => this.setState({ trToProject: e.target.value }),
      trProfession: s.trProfession, onTrProfession: (e) => this.setState({ trProfession: e.target.value }),
      trDept: s.trDept, onTrDept: (e) => this.setState({ trDept: e.target.value }),
      trCategory: s.trCategory, onTrCategory: (e) => this.setState({ trCategory: e.target.value }),
      trAllowance: s.trAllowance, onTrAllowance: (e) => this.setState({ trAllowance: e.target.value }),
      trEff: s.trEff, onTrEff: (e) => this.setState({ trEff: e.target.value }),
      trNote: s.trNote, onTrNote: (e) => this.setState({ trNote: e.target.value }),
      trDisabled: !trW || !s.trToProject || !s.trEff,
      trHint: !trW ? 'ابحث عن العامل بالكود أو الاسم' : (!s.trEff ? 'حدّد تاريخ التطبيق — النقل لا يسري قبله' : 'سيُنقل ' + trW.name + ' اعتباراً من ' + s.trEff),
      doTransfer: () => this.doTransfer(),
      hlSearch: s.hlSearch, onHlSearch: (e) => this.setState({ hlSearch: e.target.value }),
      historyRows: history,
      historyCountLabel: (s.transfers || []).length + ' حركة موثقة — تشمل النقل وتعديل المهنة والفئة والبدل',
    };
  }

  WEEKDAYS = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
  dayKey(dmy) { const p = String(dmy || '').split('/'); return p.length === 3 ? p[2] + p[1].padStart(2, '0') + p[0].padStart(2, '0') : ''; }
  weekdayOf(dmy) {
    const p = String(dmy || '').split('/');
    if (p.length !== 3) return '—';
    const d = new Date(+p[2], +p[1] - 1, +p[0]);
    return isNaN(d) ? '—' : this.WEEKDAYS[d.getDay()];
  }
  // الوردية الليلية: بصمة الخروج <= بصمة الدخول ⇒ العبور لمنتصف الليل؛
  // تُحسب الساعات فعليًا من الدخول للخروج (+24س)، ويُنسب يوم العمل كاملاً لتاريخ بصمة الدخول.
  shiftHours(inT, outT, fallback) {
    const p = t => { const m = /^(\d{1,2}):(\d{2})$/.exec(String(t || '').trim()); return m ? (+m[1] + (+m[2]) / 60) : null; };
    const a = p(inT), b = p(outT);
    if (a == null || b == null) return { hours: parseFloat(fallback) || 0, night: false, afterMid: 0 };
    const night = b <= a;
    const end = night ? b + 24 : b;
    return { hours: Math.round((end - a) * 100) / 100, night, afterMid: night ? Math.round(b * 100) / 100 : 0 };
  }

  dayTotalsVals() {
    const s = this.state;
    if (s.screen !== 'dayTotals') return {};
    const key = [s.dtFrom, s.dtTo, s.dtProject, s.dtContractor, s.dtRegion, s.workerRev, (s.addedSaraks || []).length].join('|');
    if (this._dtKey === key && this._dtVals) return this._dtVals;
    const all = [...this.sarakRecords, ...(s.addedSaraks || [])];
    const dates = [...new Set(all.map(r => r.date))].sort((a, b) => this.dayKey(a) < this.dayKey(b) ? 1 : -1);
    const latest = dates[0] || '';
    const fromIso = s.dtFrom || this.toIso(latest);
    const toIsoV = s.dtTo || this.toIso(latest);
    const kFrom = fromIso.split('-').join(''), kTo = toIsoV.split('-').join('');
    const region = s.dtRegion || 'all';
    const projSel = s.dtProject || 'all';
    const conSel = s.dtContractor || 'all';
    if (!this._codeToWorker) { this._codeToWorker = {}; this.workers.forEach(w => { this._codeToWorker[w.code] = w; }); }
    const known = this._codeToWorker;
    const jobMap = {}; this.professionsData.forEach(p => { jobMap[p.code] = p; });

    const filtered = all.filter(r => {
      const k = this.dayKey(r.date);
      if (!k || k < kFrom || k > kTo) return false;
      if (region !== 'all' && r.region !== region) return false;
      if (projSel !== 'all' && String(r.project || '') !== projSel) return false;
      if (conSel !== 'all') {
        const w = known[r.workerCode || r.code];
        if (!w || String(w.contractor || '') !== conSel) return false;
      }
      return true;
    });

    const groups = new Map();
    filtered.forEach(r => { const c = r.workerCode || r.code; if (!groups.has(c)) groups.set(c, []); groups.get(c).push(r); });
    const mny = v => (Math.round(v * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    let grand = 0, grandDays = 0;
    const rows = [...groups.entries()].map(([code, recs]) => {
      const w = known[code] || {};
      const r0 = recs[0];
      const job = jobMap[r0.jobCode] || {};
      const profName = w.profession || r0.profession || job.name || '—';
      const cat = w.category || r0.category || job.category || 'B';
      const sheetVal = parseFloat(w.catValue || r0.catValue || 0) || 0;
      const rate = sheetVal ? Math.round((sheetVal / this.DAY_HOURS) * 100) / 100 : (this.catHour(cat) || 0);
      let tH = 0, tOt = 0, tDed = 0;
      recs.forEach(r => {
        const adj = (s.sarakAdj || {})[r.code] || {};
        const hc = this.shiftHours(r.inTime, r.outTime, r.hours);
        tH += hc.hours;
        tOt += parseFloat(adj.ot != null ? adj.ot : (r.ot || 0)) || 0;
        tDed += parseFloat(adj.ded != null ? adj.ded : (r.ded || 0)) || 0;
      });
      const days = new Set(recs.map(r => this.dayKey(r.date))).size;
      const amount = (tH + tOt - tDed) * rate;
      grand += amount; grandDays += days;
      return { code, name: w.name || r0.workerName || '—', profession: profName, cat, days: String(days), amount: mny(amount) + ' ج.م' };
    }).sort((a, b) => a.code < b.code ? -1 : 1);

    const PER = 18;
    const MAX_ROWS = 360;
    const capped = rows.length > MAX_ROWS;
    const shownRows = capped ? rows.slice(0, MAX_ROWS) : rows;
    const chunks = [];
    for (let i = 0; i < shownRows.length; i += PER) chunks.push(shownRows.slice(i, i + PER));
    if (!chunks.length) chunks.push([]);
    const pages = chunks.map((list, i) => ({
      key: 'dtp' + i,
      rows: list.map((r, j) => ({ ...r, no: i * PER + j + 1 })),
      isLast: i === chunks.length - 1,
      pageLabel: 'Page ' + (i + 1) + ' of ' + chunks.length,
    }));

    const firstRec = filtered[0] || {};
    const firstW = known[firstRec.workerCode || firstRec.code] || {};
    const projLabel = projSel !== 'all'
      ? this.projectLabelOf(projSel)
      : (firstRec.projectName || this.projectLabelOf(firstW.project) || 'كل المشاريع');
    const conName = conSel === 'all' ? 'كل المقاولين'
      : (conSel === 'SELF' ? 'ذاتي الإدارة' : (((s.contractors || []).find(c => c.code === conSel) || {}).name || conSel));
    const now = new Date();
    const inSarak = [...new Set(all.map(r => String(r.project || '')).filter(Boolean))];
    const conCodes = [...new Set(Object.keys(known).map(k => String(known[k].contractor || '')).filter(Boolean))];

    const vals = {
      dtFrom: fromIso, onDtFrom: (e) => this.setState({ dtFrom: e.target.value }),
      dtTo: toIsoV, onDtTo: (e) => this.setState({ dtTo: e.target.value }),
      dtFromLabel: this.toDmy(fromIso), dtToLabel: this.toDmy(toIsoV),
      dtRegion: region, onDtRegion: (e) => this.setState({ dtRegion: e.target.value }),
      dtRegionOptions: [...new Set(all.map(r => r.region).filter(x => x && x !== '—'))].map(n => ({ name: n })),
      dtRegionLabel: region === 'all' ? 'كل المناطق' : region,
      dtProject: projSel, onDtProject: (e) => this.setState({ dtProject: e.target.value }),
      dtProjectOptions: [{ code: 'all', name: 'كل المشاريع' }]
        .concat(this.projectsData.filter(p => inSarak.includes(String(p.code))).map(p => ({ code: p.code, name: p.code + ' — ' + p.name }))),
      dtProjectLabel: projLabel,
      dtContractor: conSel, onDtContractor: (e) => this.setState({ dtContractor: e.target.value }),
      dtContractorOptions: [{ code: 'all', name: 'كل المقاولين' }, { code: 'SELF', name: 'ذاتي الإدارة' }]
        .concat((s.contractors || []).filter(c => conCodes.includes(String(c.code))).map(c => ({ code: c.code, name: c.name }))),
      dtContractorLabel: conName,
      dtPages: pages,
      dtGrandTotal: mny(grand) + ' ج.م',
      dtWorkerCount: String(rows.length),
      dtTotalDays: String(grandDays),
      dtCountLabel: capped
        ? rows.length + ' عامل — تُطبع أول ' + MAX_ROWS + ' سجل، ضيّق الفترة أو المشروع لطباعة الباقي'
        : rows.length + ' عامل · ' + grandDays + ' يومية · ' + chunks.length + ' صفحة A4',
      dtPrintedAt: now.toLocaleDateString('ar-EG', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' }) + ' — ' + now.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }),
      dtSigners: [{ role: 'HR Site' }, { role: 'محاسب الموقع' }, { role: 'مدير المشروع' }],
    };
    this._dtKey = key; this._dtVals = vals;
    return vals;
  }

  sarakPrintVals() {
    const s = this.state;
    const all = [...this.sarakRecords, ...(s.addedSaraks || [])];
    const dates = [...new Set(all.map(r => r.date))].sort((a, b) => this.dayKey(a) < this.dayKey(b) ? 1 : -1);
    const latest = dates[0] || '';
    const fromIso = s.spFrom || this.toIso(latest);
    const toIsoV = s.spTo || this.toIso(latest);
    const kFrom = fromIso.split('-').join(''), kTo = toIsoV.split('-').join('');
    const region = s.spRegion || 'all';
    const form = s.spForm === 'tec' ? 'tec' : 'fin';
    const q = (s.spSearch || '').trim();
    const projSel = s.spProject || 'all';

    const jobMap = {};
    this.professionsData.forEach(p => { jobMap[p.code] = p; });
    if (!this._codeToWorker) { this._codeToWorker = {}; this.workers.forEach(w => { this._codeToWorker[w.code] = w; }); }
    const known = this._codeToWorker;

    const filtered = all.filter(r => {
      const k = this.dayKey(r.date);
      if (!k || k < kFrom || k > kTo) return false;
      if (region !== 'all' && r.region !== region) return false;
      if (projSel !== 'all' && String(r.project || '') !== projSel) return false;
      if (q) {
        const c = String(r.workerCode || r.code || ''), n = String(r.workerName || '');
        const w = known[c];
        if (!(c.includes(q) || n.includes(q) || (w && (w.name || '').includes(q)))) return false;
      }
      return true;
    });

    const groups = new Map();
    filtered.forEach(r => {
      const c = r.workerCode || r.code;
      if (!groups.has(c)) groups.set(c, []);
      groups.get(c).push(r);
    });

    const n2 = v => (Math.round(v * 100) / 100).toFixed(2);
    const mny = v => (Math.round(v * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const stats = new Map();
    const entries = [...groups.entries()];
    const MAX_PAGES = 200;
    const shown = entries.slice(0, MAX_PAGES);

    const pages = shown.map(([code, recs], gi) => {
      const w = known[code] || {};
      const r0 = recs[0];
      const job = jobMap[r0.jobCode] || {};
      const profName = w.profession || r0.profession || job.name || '—';
      const cat = w.category || r0.category || job.category || 'B';
      const sheetVal = parseFloat(w.catValue || r0.catValue || 0) || 0;
      const rate = sheetVal ? Math.round((sheetVal / this.DAY_HOURS) * 100) / 100 : (this.catHour(cat) || 0);
      recs = recs.slice().sort((a, b) => this.dayKey(a.date) < this.dayKey(b.date) ? -1 : 1);
      let tH = 0, tOt = 0, tDed = 0, tNight = 0;
      const rows = recs.map((r, i) => {
        const adj = (s.sarakAdj || {})[r.code] || {};
        const hc = this.shiftHours(r.inTime, r.outTime, r.hours);
        const ot = parseFloat(adj.ot != null ? adj.ot : (r.ot || 0)) || 0;
        const ded = parseFloat(adj.ded != null ? adj.ded : (r.ded || 0)) || 0;
        tH += hc.hours; tOt += ot; tDed += ded; tNight += hc.afterMid;
        const sk = profName + '|' + cat;
        const st = stats.get(sk) || { profession: profName, cat, rate, hours: 0, ot: 0, night: 0, ded: 0 };
        st.hours += hc.hours; st.ot += ot; st.night += hc.afterMid; st.ded += ded;
        stats.set(sk, st);
        return {
          no: i + 1, workerCode: code, workerName: w.name || r.workerName || '—', dept: w.dept || r.dept || '—',
          profession: profName, cat, catVal: rate ? n2(rate) : '—',
          day: this.weekdayOf(r.date), date: r.date, work: r.work || '—',
          inTime: r.inTime || '—', outTime: r.outTime || '—', hours: n2(hc.hours),
          ot: n2(ot), ded: n2(ded), nightTag: hc.night ? 'ليلية' : '',
          mark: form === 'tec' ? (r.note || '') : '',
        };
      });
      return {
        key: code, workerCode: code, workerName: w.name || r0.workerName || '—',
        profession: profName, cat, catVal: rate ? n2(rate) : '—', dept: w.dept || r0.dept || '—',
        projLabel: r0.projectName || this.projectLabelOf(w.project) || '—',
        rows, days: String(rows.length), totalHours: n2(tH), totalOt: n2(tOt),
        totalDed: n2(tDed), totalNight: n2(tNight),
        totalAmount: mny((tH + tOt - tDed) * rate),
        pageLabel: (gi + 1) + ' / ' + shown.length,
      };
    });

    const statRows = [...stats.values()].sort((a, b) => b.hours - a.hours).map(c => ({
      profession: c.profession, cat: c.cat,
      hours: n2(c.hours), hoursAmount: mny(c.hours * c.rate),
      ot: n2(c.ot), night: n2(c.night),
      ded: n2(c.ded), dedAmount: mny(c.ded * c.rate),
      total: mny((c.hours + c.ot - c.ded) * c.rate),
    }));
    const g = [...stats.values()].reduce((t, c) => ({
      hours: t.hours + c.hours, hoursAmount: t.hoursAmount + c.hours * c.rate,
      ot: t.ot + c.ot, night: t.night + c.night,
      ded: t.ded + c.ded, dedAmount: t.dedAmount + c.ded * c.rate,
      total: t.total + (c.hours + c.ot - c.ded) * c.rate,
    }), { hours: 0, hoursAmount: 0, ot: 0, night: 0, ded: 0, dedAmount: 0, total: 0 });

    const inSarak = [...new Set(all.map(r => String(r.project || '')).filter(Boolean))];
    const projOptions = [{ code: 'all', name: 'كل المشاريع' }]
      .concat(this.projectsData.filter(p => inSarak.includes(String(p.code))).map(p => ({ code: p.code, name: p.code + ' — ' + p.name })));
    const projPick = projOptions.find(p => p.code === projSel) || projOptions[0];

    return {
      spFrom: fromIso, onSpFrom: (e) => this.setState({ spFrom: e.target.value }),
      spTo: toIsoV, onSpTo: (e) => this.setState({ spTo: e.target.value }),
      spPeriod: this.toDmy(fromIso) + ' — ' + this.toDmy(toIsoV),
      spRegion: region,
      onSpRegion: (e) => this.setState({ spRegion: e.target.value }),
      spRegionOptions: [...new Set(all.map(r => r.region).filter(x => x && x !== '—'))].map(n => ({ name: n })),
      spRegionLabel: region === 'all' ? 'كل المناطق' : region,
      spProject: projSel, onSpProject: (e) => this.setState({ spProject: e.target.value }),
      spProjectOptions: projOptions, spProjectLabel: projPick.name,
      spSearch: s.spSearch || '', onSpSearch: (e) => this.setState({ spSearch: e.target.value }),
      spForm: form,
      spFinClass: form === 'fin' ? 'on' : '', spTecClass: form === 'tec' ? 'on' : '',
      onSpFormFin: () => this.setState({ spForm: 'fin' }), onSpFormTec: () => this.setState({ spForm: 'tec' }),
      spFormLabel: form === 'fin' ? 'نموذج الإدارة المالية' : 'نموذج المكتب الفني',
      spColLabel: form === 'fin' ? 'التوقيع' : 'ملاحظات',
      spPages: pages, spStats: statRows, spGrand: {
        hours: n2(g.hours), hoursAmount: mny(g.hoursAmount), ot: n2(g.ot),
        night: n2(g.night), ded: n2(g.ded), dedAmount: mny(g.dedAmount), total: mny(g.total),
      },
      spCount: String(entries.length),
      spCountLabel: entries.length > MAX_PAGES
        ? entries.length + ' عامل — تُطبع أول ' + MAX_PAGES + ' كشف، ضيّق الفترة أو المنطقة لطباعة الباقي'
        : entries.length + ' عامل · ' + filtered.length + ' يوم عمل · ' + (entries.length + 1) + ' صفحة A4',
      spSigners: [{ role: 'مشرف الموقع' }, { role: 'مهندس المشروع' }, { role: 'مدير المشروع' }, { role: form === 'fin' ? 'الإدارة المالية' : 'المكتب الفني' }],
      doPrint: () => window.print(),
    };
  }

  onUploadFile(e) {
    const f = e.target.files && e.target.files[0];
    if (f) this.setState({ newUploadName: f.name });
  }
  addUpload() {
    const s = this.state;
    if (!s.newUploadName.trim()) return;
    const labels = { workers: 'العمال', sarak: 'السراكي', attendance: 'الحضور والانصراف', professions: 'المهن وفئات الأجر', contractors: 'المقاولون' };
    const file = { name: s.newUploadName.trim(), target: s.newUploadTarget, targetLabel: labels[s.newUploadTarget], date: new Date().toLocaleDateString('en-GB') };
    this.setState({ uploadedFiles: [file, ...s.uploadedFiles], newUploadName: '' });
  }

  sectorHeadDefs = { '10101': ['م. أحمد سعيد'], '10102': ['م. محمود عبد الله'] };
  deptDefs = ['عمالة مقاولين', 'التنفيذ', 'الالكتروميكانيك', 'H.S.E', 'المخازن', 'المساحة', 'الأمن', 'الصيانة والمعدات', 'الشئون الإدارية'];
  permDefs = [
    { key: 'addWorker', label: 'إضافة عامل جديد' },
    { key: 'fp', label: 'تعريف البصمة للعامل' },
    { key: 'editWorker', label: 'تعديل بيانات العامل' },
    { key: 'sarakWork', label: 'اضافة بيانات عمل سركي' },
    { key: 'approve', label: 'اعتماد المطابقة' },
    { key: 'reports', label: 'عرض التقارير والتكلفة' },
  ];
  permOn(role, key) { const p = (this.state.perms || {})[role] || {}; return !!p[key]; }
  togglePerm(role, key) {
    const perms = this.state.perms || {};
    const cur = perms[role] || {};
    this.setState({ perms: { ...perms, [role]: { ...cur, [key]: !cur[key] } } });
  }
  headsOf(code) {
    const h = this.state.sectorHeads || {};
    return h[code] !== undefined ? h[code] : (this.sectorHeadDefs[code] || []);
  }
  setHeads(code, list) { this.setState({ sectorHeads: { ...(this.state.sectorHeads || {}), [code]: list } }); }
  shValue() {
    const s = this.state;
    return s.shHeadDraft != null ? s.shHeadDraft : (this.headsOf(s.shSector || '10101')[0] || '');
  }
  saveSectorHead() {
    const code = this.state.shSector || '10101';
    const v = this.shValue().trim();
    if (!v) return;
    const list = this.headsOf(code).slice();
    if (list.length) list[0] = v; else list.push(v);
    this.setHeads(code, list); this.setState({ shHeadDraft: null });
  }
  addSectorHeadName() {
    const code = this.state.shSector || '10101';
    const v = this.shValue().trim();
    if (!v) return;
    const list = this.headsOf(code).slice();
    if (!list.includes(v)) list.push(v);
    this.setHeads(code, list); this.setState({ shHeadDraft: '' });
  }
  removeSectorHead(code, name) { this.setHeads(code, this.headsOf(code).filter(x => x !== name)); }
  clearSectorHeads() {
    const code = this.state.shSector || '10101';
    this.setHeads(code, []); this.setState({ shHeadDraft: '' });
  }
  addSarakWork() {
    const s = this.state;
    if (!s.swDetails.trim() || !s.swProject) return;
    const proj = this.projectsData.find(p => p.code === s.swProject) || {};
    const sec = this.sectorDefs.find(x => x.code === s.swSector) || {};
    const hc = this.swHoursCalc();
    const row = {
      date: s.swDate || new Date().toISOString().slice(0, 10),
      dept: s.swDept, details: s.swDetails.trim(),
      shift: s.swShift, shiftName: this.shiftName(s.swShift),
      inTime: s.swIn || '—', outTime: s.swOut || '—', hours: hc.label,
      project: s.swProject, projectName: (proj.code ? proj.code + ' — ' + proj.name : '—'),
      sector: s.swSector, sectorName: sec.name || '—',
      region: s.swRegion ? this.regionName(s.swRegion) : '—',
      count: (s.swCount || '0').trim() || '0',
    };
    this.setState({ sarakWorks: [row, ...s.sarakWorks], swDetails: '', swCount: '' });
  }
  deleteSarakWork(i) {
    const list = this.state.sarakWorks.slice(); list.splice(i, 1);
    this.setState({ sarakWorks: list });
  }
  onLogSearch(e) { this.setState({ logSearch: e.target.value, logPage: 0 }); }
  onLogDept(e) { this.setState({ logDept: e.target.value, logPage: 0 }); }
  onLogType(e) { this.setState({ logType: e.target.value, logPage: 0 }); }

  deleteKpi(code) {
    if (this.state.hiddenKpis.includes(code)) return;
    this.setState({ hiddenKpis: [...this.state.hiddenKpis, code] });
  }
  restoreKpis() { this.setState({ hiddenKpis: [] }); }

  toggleWorkerForm() { this.setState({ showWorkerForm: !this.state.showWorkerForm }); }
  setNw(key, value) { this.setState({ nw: { ...this.state.nw, [key]: value } }); }
  nextWorkerCode(contractorCode) {
    const cc = contractorCode || this.state.nw.contractor;
    if (!cc) return '';
    // العمالة الذاتية: الكود مشتق من كود المشروع (مشروع + 10 + تسلسل)
    const isSelf = cc === 'SELF';
    const proj = this.state.nw.project;
    if (isSelf && !proj) return '';
    const prefix = isSelf ? (proj + '10') : cc.slice(0, 5);
    const base = parseInt(isSelf ? (proj + '10000') : cc, 10);
    if (isNaN(base)) return '';
    const key = prefix + '|' + (isSelf ? 'S' + proj : 'C') + '|' + this.state.workerRev + '|' + this.workers.length;
    if (this._nwcKey === key) return this._nwcVal;
    let last = base;
    for (let i = 0; i < this.workers.length; i++) {
      const w = this.workers[i];
      const code = String(w.code);
      if (isSelf) {
        // العمالة الذاتية: التسلسل داخل بادئة المشروع فقط (مشروع + 10)
        if (code.slice(0, prefix.length) !== prefix) continue;
      } else if (code.slice(0, prefix.length) !== prefix) continue;
      const n = parseInt(code, 10);
      if (!isNaN(n) && n > last) last = n;
    }
    this._nwcKey = key; this._nwcVal = String(last + 1);
    return this._nwcVal;
  }
  addWorker() {
    const nw = this.state.nw;
    if (!nw.name.trim() || !nw.project || !nw.contractor) return;
    const autoB = nw.birthDate || this.birthFromCard(nw.card);
    const autoP = (nw.birthPlace || '').trim() || this.placeFromCard(nw.card);
    if (!autoB || !autoP || !(nw.card || '').trim()) return;
    if (this.findByCard(nw.card)) return;
    const autoCode = this.nextWorkerCode(nw.contractor);
    if (!autoCode) return;
    const c = this.state.contractors.find(x => x.code === nw.contractor) || this.state.contractors[0];
    const today = new Date().toLocaleDateString('en-GB');
    this.workers.push({
      code: autoCode,
      name: nw.name.trim(),
      card: nw.card.trim() || '—',
      birthDate: autoB,
      birthPlace: autoP,
      profession: nw.profession || 'عامل',
      contractor: c.code,
      dept: 'غير محدد',
      category: nw.category,
      rate: nw.rate,
      hours: nw.hours || '8',
      status: nw.status || 'نشط',
      leaveDate: nw.status === 'غير نشط' ? new Date().toLocaleDateString('en-GB') : '',
      allowance: Number(nw.allowance) || 0,
      dailyTotal: 0,
      project: nw.project,
      regDate: nw.regDate.trim() || today,
      startDate: nw.startDate.trim() || today,
      fp: !!nw.fp,
    });
    this._codeToWorker = null;
    this.setState({
      workerRev: this.state.workerRev + 1,
      showWorkerForm: false,
      nw: { name: '', code: '', profession: '', card: '', birthDate: '', birthPlace: '', allowance: '0', category: 'B', rate: this.categoryRate('B'), hours: '8', status: 'نشط', sector: nw.sector, project: nw.project, regDate: '', startDate: '', contractor: nw.contractor, fp: false },
    });
  }
  deleteWorker(code) {
    const i = this.workers.findIndex(w => w.code === code);
    if (i > -1) this.workers.splice(i, 1);
    this._codeToWorker = null;
    this.setState({ workerRev: this.state.workerRev + 1, selectedWorkerCode: null });
  }
  setWorkerCategory(code, category) {
    const w = this.workers.find(x => x.code === code);
    if (w) w.category = category;
    this.setState({ workerRev: this.state.workerRev + 1 });
  }

