{
  "cleanUrls": false,
  "redirects": [
    { "source": "/login", "destination": "/", "permanent": false },
    { "source": "/change-password", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/site/index.html" },
    { "source": "/((?!api/|site/|assets/)[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(company-data.json|index.html)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
